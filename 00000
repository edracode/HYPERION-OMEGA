//| 3B. Multi-Engine Background Shadow Paper-Trading Engine          |
//+------------------------------------------------------------------+
struct SVirtualTrade
{
   bool             active;
   ENUM_STRATEGY_ID strategy;
   int              direction;
   double           entry_price;
   double           sl_price;
   double           tp_price;
   double           initial_sl_dist;
   double           cost_price;
   bool             partial_closed;
   datetime         open_time;

   void Reset()
   {
      active          = false;
      strategy        = STRAT_A0_MOMENTUM;
      direction       = 0;
      entry_price     = 0.0;
      sl_price        = 0.0;
      tp_price        = 0.0;
      initial_sl_dist = 0.0;
      cost_price      = 0.0;
      partial_closed  = false;
      open_time       = 0;
   }
};

class CShadowDualTracker
{
private:
   string        m_symbol;
   SVirtualTrade m_slots_a[SHADOW_SLOTS];
   SVirtualTrade m_slots_b[SHADOW_SLOTS];
   SVirtualTrade m_slots_c[SHADOW_SLOTS];

   double        m_r_buf_a[100];
   int           m_closed_a;
   double        m_exp_r_a;
   datetime      m_last_bar_a;

   double        m_r_buf_b[100];
   int           m_closed_b;
   double        m_exp_r_b;
   datetime      m_last_bar_b;

   double        m_r_buf_c[100];
   int           m_closed_c;
   double        m_exp_r_c;
   datetime      m_last_bar_c;

   void RecordVirtualResult(int group_idx, double realized_r)
   {
      double clamped = MathMax(-2.0, MathMin(3.5, realized_r));
      int win_len    = MathMax(6, MathMin(InpShadowVerifyTrades, 100));

      if(group_idx == 0)
      {
         int idx = m_closed_a % win_len;
         m_r_buf_a[idx] = clamped;
         m_closed_a++;
         int samples = MathMin(m_closed_a, win_len);
         double sum  = 0.0;
         for(int i = 0; i < samples; i++) sum += m_r_buf_a[i];
         m_exp_r_a = sum / (double)samples;
      }
      else if(group_idx == 1)
      {
         int idx = m_closed_b % win_len;
         m_r_buf_b[idx] = clamped;
         m_closed_b++;
         int samples = MathMin(m_closed_b, win_len);
         double sum  = 0.0;
         for(int i = 0; i < samples; i++) sum += m_r_buf_b[i];
         m_exp_r_b = sum / (double)samples;
      }
      else
      {
         int idx = m_closed_c % win_len;
         m_r_buf_c[idx] = clamped;
         m_closed_c++;
         int samples = MathMin(m_closed_c, win_len);
         double sum  = 0.0;
         for(int i = 0; i < samples; i++) sum += m_r_buf_c[i];
         m_exp_r_c = sum / (double)samples;
      }
   }

   void OpenInSlotArray(SVirtualTrade &slots[], datetime &last_bar,
                        const SSignalCandidate &cand, const CMicrostructureEngine &micro, datetime bar_time)
   {
      if(bar_time == last_bar) return;

      double point   = SymbolInfoDouble(m_symbol, SYMBOL_POINT);
      double sl_dist = MathAbs(cand.entry_price - cand.sl_price);
      if(sl_dist <= 0.0 || point <= 0.0) return;

      for(int i = 0; i < SHADOW_SLOTS; i++)
      {
         if(!slots[i].active)
         {
            slots[i].active          = true;
            slots[i].strategy        = cand.strategy;
            slots[i].direction       = cand.direction;
            slots[i].entry_price     = cand.entry_price;
            slots[i].sl_price        = cand.sl_price;
            slots[i].tp_price        = cand.tp_price;
            slots[i].initial_sl_dist = sl_dist;
            slots[i].cost_price      = micro.estimated_slippage_pts * point;
            slots[i].partial_closed  = false;
            slots[i].open_time       = TimeCurrent();
            last_bar                 = bar_time;
            break;
         }
      }
   }

   void UpdateSlotArray(SVirtualTrade &slots[], int group_idx, const MqlTick &tick, const CMTFContextEngine &mtf)
   {
      datetime now = TimeCurrent();
      double atr   = (group_idx >= 1) ? mtf.m5_atr[0] : mtf.m1_atr[0];
      int max_hold = (group_idx == 2) ? 3600 : ((group_idx == 1) ? 7200 : InpMaxHoldSeconds);

      for(int i = 0; i < SHADOW_SLOTS; i++)
      {
         if(!slots[i].active) continue;

         double cur_px = (slots[i].direction > 0) ? tick.bid : tick.ask;
         double sl_d   = slots[i].initial_sl_dist;

         if((slots[i].direction > 0 && cur_px <= slots[i].sl_price) ||
            (slots[i].direction < 0 && cur_px >= slots[i].sl_price))
         {
            double exit_px = slots[i].sl_price;
            double raw_pnl = (slots[i].direction > 0) ? (exit_px - slots[i].entry_price)
                                                      : (slots[i].entry_price - exit_px);
            double r_mult  = (raw_pnl - slots[i].cost_price) / sl_d;
            if(slots[i].partial_closed)
               r_mult = 0.5 * InpPartialCloseRR + 0.5 * r_mult;
            RecordVirtualResult(group_idx, r_mult);
            slots[i].Reset();
            continue;
         }

         if((slots[i].direction > 0 && cur_px >= slots[i].tp_price) ||
            (slots[i].direction < 0 && cur_px <= slots[i].tp_price))
         {
            double exit_px = slots[i].tp_price;
            double raw_pnl = (slots[i].direction > 0) ? (exit_px - slots[i].entry_price)
                                                      : (slots[i].entry_price - exit_px);
            double r_mult  = (raw_pnl - slots[i].cost_price) / sl_d;
            if(slots[i].partial_closed)
               r_mult = 0.5 * InpPartialCloseRR + 0.5 * r_mult;
            RecordVirtualResult(group_idx, r_mult);
            slots[i].Reset();
            continue;
         }

         if(max_hold > 0 && (now - slots[i].open_time) >= max_hold)
         {
            double raw_pnl = (slots[i].direction > 0) ? (cur_px - slots[i].entry_price)
                                                      : (slots[i].entry_price - cur_px);
            double r_mult  = (raw_pnl - slots[i].cost_price) / sl_d;
            if(slots[i].partial_closed)
               r_mult = 0.5 * InpPartialCloseRR + 0.5 * r_mult;
            RecordVirtualResult(group_idx, r_mult);
            slots[i].Reset();
            continue;
         }

         double unreal = (slots[i].direction > 0) ? (cur_px - slots[i].entry_price)
                                                  : (slots[i].entry_price - cur_px);
         double cur_r  = unreal / sl_d;

         if(InpUsePartialClose && cur_r >= InpPartialCloseRR && !slots[i].partial_closed)
         {
            slots[i].partial_closed = true;
            slots[i].sl_price       = slots[i].entry_price;
         }

         if(InpUseTrailingStop && cur_r >= InpTrailActivationRR && atr > 0.0)
         {
            double trail = atr * ((group_idx >= 1) ? 0.55 : InpTrailStepATR);
            if(slots[i].direction > 0 && (cur_px - trail) > slots[i].sl_price)
               slots[i].sl_price = cur_px - trail;
            else if(slots[i].direction < 0 && (cur_px + trail) < slots[i].sl_price)
               slots[i].sl_price = cur_px + trail;
         }
      }
   }

public:
   void Init(const string symbol)
   {
      m_symbol = symbol;
      ResetAll();
   }

   void ResetAll()
   {
      for(int i = 0; i < SHADOW_SLOTS; i++)
      {
         m_slots_a[i].Reset();
         m_slots_b[i].Reset();
         m_slots_c[i].Reset();
      }
      ArrayInitialize(m_r_buf_a, 0.0);
      ArrayInitialize(m_r_buf_b, 0.0);
      ArrayInitialize(m_r_buf_c, 0.0);
      m_closed_a = 0; m_exp_r_a = 0.0; m_last_bar_a = 0;
      m_closed_b = 0; m_exp_r_b = 0.0; m_last_bar_b = 0;
      m_closed_c = 0; m_exp_r_c = 0.0; m_last_bar_c = 0;
   }

   void ResetEngineAShadow()
   {
      for(int i = 0; i < SHADOW_SLOTS; i++) m_slots_a[i].Reset();
      ArrayInitialize(m_r_buf_a, 0.0);
      m_closed_a = 0; m_exp_r_a = 0.0; m_last_bar_a = 0;
   }

   int    GetSamplesA() const { return MathMin(m_closed_a, MathMax(6, MathMin(InpShadowVerifyTrades, 100))); }
   double GetExpRA() const    { return m_exp_r_a; }
   int    GetSamplesB() const { return MathMin(m_closed_b, MathMax(6, MathMin(InpShadowVerifyTrades, 100))); }
   double GetExpRB() const    { return m_exp_r_b; }
   int    GetSamplesC() const { return MathMin(m_closed_c, MathMax(6, MathMin(InpShadowVerifyTrades, 100))); }
   double GetExpRC() const    { return m_exp_r_c; }

   bool IsEngineAShadowRecovered() const
   {
      int req = MathMax(6, MathMin(InpShadowVerifyTrades, 100));
      return (m_closed_a >= req && m_exp_r_a >= InpShadowUnlockExpR);
   }

   void OpenShadowCandidate(const SSignalCandidate &cand, const CMicrostructureEngine &micro, datetime bar_time)
   {
      if(!cand.valid) return;
      if(IsStrategyEngineC(cand.strategy))
         OpenInSlotArray(m_slots_c, m_last_bar_c, cand, micro, bar_time);
      else if(IsStrategyEngineB(cand.strategy))
         OpenInSlotArray(m_slots_b, m_last_bar_b, cand, micro, bar_time);
      else
         OpenInSlotArray(m_slots_a, m_last_bar_a, cand, micro, bar_time);
   }

   void UpdateAll(const MqlTick &tick, const CMTFContextEngine &mtf)
   {
      UpdateSlotArray(m_slots_a, 0, tick, mtf);
      UpdateSlotArray(m_slots_b, 1, tick, mtf);
      UpdateSlotArray(m_slots_c, 2, tick, mtf);
   }
};

//+------------------------------------------------------------------+
//| 4. Capital Governance & Anti-Freeze Crash Recovery Manager (V7.0)|
//+------------------------------------------------------------------+
class CRiskAndCapitalManager
{
private:
   string             m_symbol;
   ulong              m_magic;
   double             m_initial_deposit;
   double             m_daily_start_equity;
   double             m_ath_equity;
   double             m_dd_anchor_equity;
   ENUM_ACTIVE_ENGINE m_active_engine;
   double             m_vault_floor_locked;
   double             m_vault_anchor_ath;
   datetime           m_engine_switched_time;
   datetime           m_cooldown_until;
   string             m_cooldown_label;
   int                m_current_day_of_year;
   string             m_gv_ath_key;
   string             m_gv_anchor_key;
   string             m_gv_daily_key;
   string             m_gv_day_key;
   string             m_gv_eng_key;
   string             m_gv_vfloor_key;

public:
   void Init(const string symbol, ulong magic)
   {
      m_symbol               = symbol;
      m_magic                = magic;
      m_cooldown_until       = 0;
      m_cooldown_label       = "";
      m_active_engine        = ENGINE_A_HYPER_SCALP;
      m_vault_floor_locked   = 0.0;
      m_vault_anchor_ath     = 0.0;
      m_engine_switched_time = 0;

      long login      = AccountInfoInteger(ACCOUNT_LOGIN);
      m_gv_ath_key    = StringFormat("MVX70_ATH_%I64d", login);
      m_gv_anchor_key = StringFormat("MVX70_ANC_%I64d", login);
      m_gv_daily_key  = StringFormat("MVX70_DAYEQ_%I64d", login);
      m_gv_day_key    = StringFormat("MVX70_DOY_%I64d", login);
      m_gv_eng_key    = StringFormat("MVX70_ENG_%I64d", login);
      m_gv_vfloor_key = StringFormat("MVX70_VFLR_%I64d", login);

      double eq         = AccountInfoDouble(ACCOUNT_EQUITY);
      m_initial_deposit = eq;

      MqlDateTime dt;
      TimeCurrent(dt);
      m_current_day_of_year = dt.day_of_year;

      if(!MQLInfoInteger(MQL_TESTER) && GlobalVariableCheck(m_gv_ath_key))
         m_ath_equity = MathMax(eq, GlobalVariableGet(m_gv_ath_key));
      else
      {
         m_ath_equity = eq;
         if(!MQLInfoInteger(MQL_TESTER)) GlobalVariableSet(m_gv_ath_key, m_ath_equity);
      }

      if(!MQLInfoInteger(MQL_TESTER) && GlobalVariableCheck(m_gv_anchor_key))
         m_dd_anchor_equity = MathMax(eq, GlobalVariableGet(m_gv_anchor_key));
      else
      {
         m_dd_anchor_equity = eq;
         if(!MQLInfoInteger(MQL_TESTER)) GlobalVariableSet(m_gv_anchor_key, m_dd_anchor_equity);
      }

      if(!MQLInfoInteger(MQL_TESTER) && GlobalVariableCheck(m_gv_eng_key))
      {
         int saved_eng = (int)GlobalVariableGet(m_gv_eng_key);
         if(saved_eng == 2) m_active_engine = ENGINE_C_CRASH_RECOV;
         else if(saved_eng == 1) m_active_engine = ENGINE_B_MACRO_SWING;
         else m_active_engine = ENGINE_A_HYPER_SCALP;
      }

      if(!MQLInfoInteger(MQL_TESTER) && GlobalVariableCheck(m_gv_vfloor_key))
         m_vault_floor_locked = GlobalVariableGet(m_gv_vfloor_key);

      if(!MQLInfoInteger(MQL_TESTER) &&
         GlobalVariableCheck(m_gv_day_key) && (int)GlobalVariableGet(m_gv_day_key) == m_current_day_of_year &&
         GlobalVariableCheck(m_gv_daily_key))
      {
         m_daily_start_equity = GlobalVariableGet(m_gv_daily_key);
      }
      else
      {
         m_daily_start_equity = eq;
         if(!MQLInfoInteger(MQL_TESTER))
         {
            GlobalVariableSet(m_gv_daily_key, m_daily_start_equity);
            GlobalVariableSet(m_gv_day_key, (double)m_current_day_of_year);
         }
      }
   }

   void UpdateEquityState()
   {
      double eq = AccountInfoDouble(ACCOUNT_EQUITY);
      if(eq <= 0.0) return;

      MqlDateTime dt;
      TimeCurrent(dt);
      if(dt.day_of_year != m_current_day_of_year)
      {
         m_current_day_of_year = dt.day_of_year;
         m_daily_start_equity  = eq;
         if(!MQLInfoInteger(MQL_TESTER))
         {
            GlobalVariableSet(m_gv_daily_key, m_daily_start_equity);
            GlobalVariableSet(m_gv_day_key, (double)m_current_day_of_year);
         }
      }

      if(eq > m_ath_equity)
      {
         m_ath_equity = eq;
         if(!MQLInfoInteger(MQL_TESTER)) GlobalVariableSet(m_gv_ath_key, m_ath_equity);

         if(m_active_engine != ENGINE_A_HYPER_SCALP && m_vault_anchor_ath > 0.0)
         {
            double step_mult = 1.0 + (MathMax(1.0, InpVaultRatchetStepPct) / 100.0);
            if(m_ath_equity >= m_vault_anchor_ath * step_mult)
            {
               m_vault_anchor_ath = m_ath_equity;
               double pct         = MathMax(70.0, MathMin(95.0, InpVaultProtectPctOfATH));
               double new_floor   = m_ath_equity * (pct / 100.0);
               if(new_floor > m_vault_floor_locked)
               {
                  m_vault_floor_locked = new_floor;
                  if(!MQLInfoInteger(MQL_TESTER)) GlobalVariableSet(m_gv_vfloor_key, m_vault_floor_locked);
               }
            }
         }
      }

      if(eq > m_dd_anchor_equity)
      {
         m_dd_anchor_equity = eq;
         if(!MQLInfoInteger(MQL_TESTER)) GlobalVariableSet(m_gv_anchor_key, m_dd_anchor_equity);
      }
   }

   double             GetATHEquity() const      { return m_ath_equity; }
   ENUM_ACTIVE_ENGINE GetActiveEngine() const   { return m_active_engine; }
   bool               IsEngineBActive() const   { return (m_active_engine == ENGINE_B_MACRO_SWING); }
   bool               IsEngineCActive() const   { return (m_active_engine == ENGINE_C_CRASH_RECOV); }

   double GetVaultFloor() const
   {
      if(!InpUseATHVaultSwitch || m_ath_equity < m_initial_deposit * MathMax(10.0, InpVaultActivationMult))
         return 0.0;
      double pct = MathMax(65.0, MathMin(95.0, InpVaultProtectPctOfATH));
      double dyn_floor = m_ath_equity * (pct / 100.0);
      return MathMax(m_vault_floor_locked, dyn_floor);
   }

   double GetTodayPnLMoney() const  { return AccountInfoDouble(ACCOUNT_EQUITY) - m_daily_start_equity; }

   double GetTodayPnLPct() const
   {
      if(m_daily_start_equity <= 0.0) return 0.0;
      return (GetTodayPnLMoney() / m_daily_start_equity) * 100.0;
   }

   double GetCurrentDailyLossPct() const
   {
      double eq = AccountInfoDouble(ACCOUNT_EQUITY);
      if(m_daily_start_equity <= 0.0) return 0.0;
      double loss = (m_daily_start_equity - eq) / m_daily_start_equity * 100.0;
      return MathMax(0.0, loss);
   }

   double GetCurrentCycleDDPct() const
   {
      double eq = AccountInfoDouble(ACCOUNT_EQUITY);
      if(m_ath_equity <= 0.0) return 0.0;
      double dd = (m_ath_equity - eq) / m_ath_equity * 100.0;
      return MathMax(0.0, dd);
   }

   void SwitchToEngine(ENUM_ACTIVE_ENGINE target_engine, CShadowDualTracker &shadow, CAdaptiveStatsTracker &stats)
   {
      double eq = AccountInfoDouble(ACCOUNT_EQUITY);
      m_active_engine        = target_engine;
      m_dd_anchor_equity     = eq;
      m_daily_start_equity   = eq;
      m_engine_switched_time = TimeCurrent();
      stats.ResetAllSuspensions();

      if(target_engine == ENGINE_B_MACRO_SWING || target_engine == ENGINE_C_CRASH_RECOV)
      {
         m_vault_floor_locked = eq;
         m_vault_anchor_ath   = m_ath_equity;
         shadow.ResetEngineAShadow();
      }
      else
      {
         // Re-arm vault floor below current equity so Engine A doesn't bounce immediately
         m_vault_floor_locked = eq * 0.72;
      }

      if(!MQLInfoInteger(MQL_TESTER))
      {
         GlobalVariableSet(m_gv_eng_key, (double)target_engine);
         GlobalVariableSet(m_gv_anchor_key, m_dd_anchor_equity);
         GlobalVariableSet(m_gv_daily_key, m_daily_start_equity);
         GlobalVariableSet(m_gv_vfloor_key, m_vault_floor_locked);
      }
   }

   bool EvaluateDualEngineSwitch(CShadowDualTracker &shadow, CAdaptiveStatsTracker &stats,
                                 datetime last_trade_time, string &switch_reason, bool &should_close_all)
   {
      should_close_all   = false;
      datetime now       = TimeCurrent();
      double eq          = AccountInfoDouble(ACCOUNT_EQUITY);
      double dd_from_ath = GetCurrentCycleDDPct();
      bool   vault_armed = (InpUseATHVaultSwitch && m_ath_equity >= m_initial_deposit * MathMax(10.0, InpVaultActivationMult));

      // 1. Trigger Engine C Crash Recovery if ATH drawdown reaches severe threshold (30%)
      if(vault_armed && m_active_engine != ENGINE_C_CRASH_RECOV && dd_from_ath >= MathMax(15.0, InpEngineCDDTriggerPct))
      {
         should_close_all = true;
         switch_reason    = StringFormat("ATH CRASH (DD:%.1f%%) -> ENGINE C RECOVERY", dd_from_ath);
         SwitchToEngine(ENGINE_C_CRASH_RECOV, shadow, stats);
         return true;
      }

      // 2. Non-Blocking Recovery Exit (Engine C or Engine B -> Engine A)
      if(m_active_engine == ENGINE_C_CRASH_RECOV || m_active_engine == ENGINE_B_MACRO_SWING)
      {
         double base_ref      = (m_vault_floor_locked > 0.0) ? m_vault_floor_locked : MathMax(1.0, eq);
         double recovery_gain = ((eq - base_ref) / base_ref) * 100.0;
         int    elapsed_hours = (m_engine_switched_time > 0) ? (int)((now - m_engine_switched_time) / 3600) : 0;
         int    idle_mins     = (last_trade_time > 0 && last_trade_time >= m_engine_switched_time)
                                ? (int)((now - last_trade_time) / 60)
                                : (int)((now - m_engine_switched_time) / 60);

         bool target_met      = (recovery_gain >= InpEngineCReturnTargetPct);
         bool shadow_ready    = shadow.IsEngineAShadowRecovered();
         bool time_unlocked   = (elapsed_hours >= MathMax(6, InpMaxRecoveryHours));
         bool anti_freeze     = (idle_mins >= MathMax(60, InpAntiFreezeMinutes));

         if(target_met || shadow_ready || time_unlocked || anti_freeze)
         {
            should_close_all = false; // Let active winners trail out naturally
            if(target_met)
               switch_reason = StringFormat("RECOVERY TARGET MET (%+.1f%%) -> RESUMING ENG-A", recovery_gain);
            else if(shadow_ready)
               switch_reason = StringFormat("ENG-A SHADOW VERIFIED (%+.2fR) -> RESUMING ENG-A", shadow.GetExpRA());
            else if(anti_freeze)
               switch_reason = StringFormat("ANTI-FREEZE UNLOCK (%dm IDLE) -> RESUMING ENG-A", idle_mins);
            else
               switch_reason = StringFormat("CYCLE TIMER UNLOCK (%dh) -> RESUMING ENG-A", elapsed_hours);

            SwitchToEngine(ENGINE_A_HYPER_SCALP, shadow, stats);
            return true;
         }
      }

      // 3. Transition Engine A -> Engine B at 76% of ATH (once ATH > $25M)
      if(m_active_engine == ENGINE_A_HYPER_SCALP)
      {
         double vault_floor = GetVaultFloor();
         if(vault_floor > 0.0 && eq <= vault_floor)
         {
            should_close_all = true;
            switch_reason    = StringFormat("VAULT LOCKED AT $%.0f -> ENGINE B", eq);
            SwitchToEngine(ENGINE_B_MACRO_SWING, shadow, stats);
            return true;
         }
      }

      return false;
   }

   bool CheckRiskCircuitBreaker(string &reason, bool &should_close_positions)
   {
      should_close_positions = false;
      datetime now = TimeCurrent();
      double   eq  = AccountInfoDouble(ACCOUNT_EQUITY);

      if(m_cooldown_until > 0)
      {
         if(now < m_cooldown_until)
         {
            int mins_left = (int)((m_cooldown_until - now) / 60) + 1;
            reason = StringFormat("%s (%dm LEFT)", m_cooldown_label, mins_left);
            return true;
         }
         else
         {
            m_cooldown_until     = 0;
            m_cooldown_label     = "";
            m_dd_anchor_equity   = eq;
            m_daily_start_equity = eq;
            if(!MQLInfoInteger(MQL_TESTER))
            {
               GlobalVariableSet(m_gv_anchor_key, m_dd_anchor_equity);
               GlobalVariableSet(m_gv_daily_key, m_daily_start_equity);
            }
         }
      }

      double daily_lim  = (m_active_engine == ENGINE_C_CRASH_RECOV) ? 5.0 : ((m_active_engine == ENGINE_B_MACRO_SWING) ? 6.0 : g_cfg.max_daily_loss_pct);
      double daily_loss = GetCurrentDailyLossPct();
      if(daily_loss >= daily_lim)
      {
         should_close_positions = true;
         m_cooldown_until       = now + MathMax(10, InpDDCooldownMinutes) * 60;
         m_cooldown_label       = "DAILY LOSS PAUSE";
         reason = StringFormat("DAILY LOSS GUARD (%.2f%% >= %.1f%%)", daily_loss, daily_lim);
         return true;
      }

      return false;
   }

   double GetEffectiveRiskPct() const
   {
      if(m_active_engine == ENGINE_C_CRASH_RECOV)
         return MathMax(0.15, MathMin(1.50, InpEngineCRiskPct));
      if(m_active_engine == ENGINE_B_MACRO_SWING)
         return MathMax(0.20, MathMin(1.80, InpEngineBRiskPct));
      return g_cfg.risk_pct;
   }

   double CalculateCumulativeOpenRiskCurrency() const
   {
      double total_risk = 0.0;
      int total = PositionsTotal();
      for(int i = 0; i < total; i++)
      {
         ulong ticket = PositionGetTicket(i);
         if(ticket == 0) continue;
         if(PositionGetInteger(POSITION_MAGIC) != (long)m_magic) continue;

         ulong pos_id = (ulong)PositionGetInteger(POSITION_IDENTIFIER);
         SPositionMeta meta;
         if(g_pos_reg.GetMeta(pos_id, meta) && meta.initial_risk_money > 0.0)
         {
            total_risk += meta.initial_risk_money;
            continue;
         }

         string pos_sym   = PositionGetString(POSITION_SYMBOL);
         double vol       = PositionGetDouble(POSITION_VOLUME);
         double open_px   = PositionGetDouble(POSITION_PRICE_OPEN);
         double sl_px     = PositionGetDouble(POSITION_SL);
         double tick_size = SymbolInfoDouble(pos_sym, SYMBOL_TRADE_TICK_SIZE);
         double tick_val  = SymbolInfoDouble(pos_sym, SYMBOL_TRADE_TICK_VALUE);

         if(tick_size <= 0.0 || tick_val <= 0.0) continue;
         double sl_dist = (sl_px > 0.0) ? MathAbs(open_px - sl_px) : (open_px * 0.003);
         total_risk += (sl_dist / tick_size) * tick_val * vol;
      }
      return total_risk;
   }

   double GetCumulativeOpenRiskPct() const
   {
      double eq = AccountInfoDouble(ACCOUNT_EQUITY);
      if(eq <= 0.0) return 0.0;
      return (CalculateCumulativeOpenRiskCurrency() / eq) * 100.0;
   }

   double ComputeValidatedTotalLots(double sl_distance_price, double strategy_mult,
                                    ENUM_ORDER_TYPE order_type, double entry_price,
                                    double &out_total_risk_money, string &reject_reason) const
   {
      out_total_risk_money = 0.0;
      if(sl_distance_price <= 0.0)
      {
         reject_reason = "INVALID SL DIST";
         return 0.0;
      }

      double equity  = AccountInfoDouble(ACCOUNT_EQUITY);
      double balance = AccountInfoDouble(ACCOUNT_BALANCE);
      double capital_base = InpUseEquityCompounding ? equity : MathMin(equity, balance);
      if(capital_base <= 0.0)
      {
         reject_reason = "ZERO EQUITY";
         return 0.0;
      }

      double risk_pct = GetEffectiveRiskPct() * strategy_mult;
      double ceiling  = (m_active_engine == ENGINE_C_CRASH_RECOV) ? 1.50 : ((m_active_engine == ENGINE_B_MACRO_SWING) ? 1.80 : 4.00);
      risk_pct = MathMin(risk_pct, ceiling);

      double target_risk_money = capital_base * (risk_pct / 100.0);

      double cum_cap_pc       = (m_active_engine == ENGINE_C_CRASH_RECOV) ? 4.0 : ((m_active_engine == ENGINE_B_MACRO_SWING) ? 4.5 : g_cfg.max_cum_risk_pct);
      double max_cum_money    = equity * (cum_cap_pc / 100.0);
      double open_cum_money   = CalculateCumulativeOpenRiskCurrency();
      double remaining_budget = max_cum_money - open_cum_money;
      if(remaining_budget <= 0.0)
      {
         reject_reason = "CUMULATIVE RISK CAP";
         return 0.0;
      }

      if(target_risk_money > remaining_budget)
         target_risk_money = remaining_budget;

      double tick_size = SymbolInfoDouble(m_symbol, SYMBOL_TRADE_TICK_SIZE);
      double tick_val  = SymbolInfoDouble(m_symbol, SYMBOL_TRADE_TICK_VALUE);
      if(tick_size <= 0.0 || tick_val <= 0.0)
      {
         reject_reason = "INVALID TICK VALUE";
         return 0.0;
      }

      double loss_per_lot = (sl_distance_price / tick_size) * tick_val;
      if(loss_per_lot <= 0.0)
      {
         reject_reason = "ZERO LOSS/LOT";
         return 0.0;
      }

      double raw_lots = target_risk_money / loss_per_lot;

      double min_lot  = SymbolInfoDouble(m_symbol, SYMBOL_VOLUME_MIN);
      double max_lot  = SymbolInfoDouble(m_symbol, SYMBOL_VOLUME_MAX);
      double lot_step = SymbolInfoDouble(m_symbol, SYMBOL_VOLUME_STEP);
      if(lot_step <= 0.0) lot_step = 0.01;

      int max_tranches     = MathMax(1, MathMin(InpMaxTranchesPerSignal, 8));
      double total_cap_lot = max_lot * (double)max_tranches;

      double norm_lots = MathFloor(raw_lots / lot_step) * lot_step;
      norm_lots = NormalizeDouble(norm_lots, 2);

      if(norm_lots < min_lot)
      {
         double min_lot_risk = min_lot * loss_per_lot;
         if(InpAllowMinLotFloor && equity >= 50.0 && min_lot_risk <= equity * 0.06)
            norm_lots = min_lot;
         else
         {
            reject_reason = StringFormat("MIN_LOT RISK ($%.2f > $%.2f)", min_lot_risk, target_risk_money);
            return 0.0;
         }
      }

      if(norm_lots > total_cap_lot)
         norm_lots = total_cap_lot;

      double margin_req = 0.0;
      if(OrderCalcMargin(order_type, m_symbol, norm_lots, entry_price, margin_req))
      {
         double free_margin = AccountInfoDouble(ACCOUNT_MARGIN_FREE);
         while(norm_lots >= min_lot && margin_req > free_margin * 0.85)
         {
            norm_lots = NormalizeDouble(norm_lots - lot_step, 2);
            if(norm_lots < min_lot)
            {
               reject_reason = "INSUFFICIENT FREE MARGIN";
               return 0.0;
            }
            if(!OrderCalcMargin(order_type, m_symbol, norm_lots, entry_price, margin_req))
               return 0.0;
         }
      }

      out_total_risk_money = norm_lots * loss_per_lot;
      return norm_lots;
   }
};

//+------------------------------------------------------------------+
//| 5. Triple-Engine Signal & Expectancy Evaluator (A0-A4, B0-B2, C) |
//+------------------------------------------------------------------+
class CSignalScoringEngine
{
private:
   string m_symbol;

   double CalculateCostInPoints(double point, const CMicrostructureEngine &micro) const
   {
      double spread_pts = (SymbolInfoDouble(m_symbol, SYMBOL_ASK) - SymbolInfoDouble(m_symbol, SYMBOL_BID)) / point;
      double tick_size  = SymbolInfoDouble(m_symbol, SYMBOL_TRADE_TICK_SIZE);
      double tick_val   = SymbolInfoDouble(m_symbol, SYMBOL_TRADE_TICK_VALUE);

      double eff_comm_money = micro.GetEffectiveCommissionPerLot();
      double comm_pts = 0.0;
      if(eff_comm_money > 0.0 && tick_size > 0.0 && tick_val > 0.0 && point > 0.0)
      {
         double point_val_per_lot = tick_val * (point / tick_size);
         if(point_val_per_lot > 0.0)
            comm_pts = eff_comm_money / point_val_per_lot;
      }
      return spread_pts + comm_pts;
   }

   void FinalizeCandidate(SSignalCandidate &cand, ENUM_STRATEGY_ID sid, int dir,
                          double sl_dist_price, double tp_dist_price, double base_win_prob,
                          const CMicrostructureEngine &micro, const CMTFContextEngine &mtf,
                          const CAdaptiveStatsTracker &stats, double min_exp_override = -1.0)
   {
      double point = SymbolInfoDouble(m_symbol, SYMBOL_POINT);
      double ask   = SymbolInfoDouble(m_symbol, SYMBOL_ASK);
      double bid   = SymbolInfoDouble(m_symbol, SYMBOL_BID);

      if(point <= 0.0 || sl_dist_price <= 0.0 || tp_dist_price <= 0.0)
         return;

      double spread_price  = ask - bid;
      long   stops_level   = SymbolInfoInteger(m_symbol, SYMBOL_TRADE_STOPS_LEVEL);
      double min_stop_dist = MathMax((double)(stops_level + 5) * point, spread_price * 2.0);

      if(sl_dist_price < min_stop_dist) sl_dist_price = min_stop_dist;
      if(tp_dist_price < sl_dist_price * 1.20) tp_dist_price = sl_dist_price * 1.20;

      double entry = (dir > 0) ? ask : bid;
      double sl    = (dir > 0) ? (entry - sl_dist_price) : (entry + sl_dist_price);
      double tp    = (dir > 0) ? (entry + tp_dist_price) : (entry - tp_dist_price);

      entry = NormalizePriceToTick(m_symbol, entry);
      sl    = NormalizePriceToTick(m_symbol, sl);
      tp    = NormalizePriceToTick(m_symbol, tp);

      double reward_pts  = tp_dist_price / point;
      double risk_pts    = sl_dist_price / point;
      double cost_pts    = CalculateCostInPoints(point, micro) + micro.estimated_slippage_pts;
      double cal_prob    = stats.GetCalibratedWinProb(sid, base_win_prob);

      double net_exp_pts = (cal_prob * reward_pts) - ((1.0 - cal_prob) * risk_pts) - cost_pts;
      double net_exp_r   = net_exp_pts / risk_pts;

      double req_exp_r = (min_exp_override > 0.0) ? min_exp_override : g_cfg.min_expectancy_r;
      if(net_exp_pts <= 0.0 || net_exp_r < req_exp_r)
         return;

      double adapt_mult = stats.GetAdaptiveMultiplier(sid);
      double score      = net_exp_r * mtf.seasonality_score * adapt_mult * (1.0 + 0.25 * MathAbs(micro.tick_imbalance));

      cand.valid               = true;
      cand.strategy            = sid;
      cand.direction           = dir;
      cand.entry_price         = entry;
      cand.sl_price            = sl;
      cand.tp_price            = tp;
      cand.win_prob            = cal_prob;
      cand.expected_reward_pts = reward_pts;
      cand.expected_risk_pts   = risk_pts;
      cand.total_cost_pts      = cost_pts;
      cand.net_expectancy_pts  = net_exp_pts;
      cand.net_expectancy_r    = net_exp_r;
      cand.score               = score;
      cand.tag                 = StringFormat("%s|%s", COMMENT_PREFIX, StrategyShortCode(sid));
   }

public:
   void Init(const string symbol) { m_symbol = symbol; }

   // ENGINE A: Full 5-Module M1 Hyper-Scalper (A0 - A4)
   SSignalCandidate EvaluateEngineA(const CMicrostructureEngine &micro,
                                    const CMTFContextEngine &mtf,
                                    CAdaptiveStatsTracker &stats)
   {
      SSignalCandidate best;
      best.Reset();

      datetime now = TimeCurrent();
      double atr = mtf.m1_atr[0];
      if(atr <= 0.0) return best;

      double ask = SymbolInfoDouble(m_symbol, SYMBOL_ASK);
      double bid = SymbolInfoDouble(m_symbol, SYMBOL_BID);

      SSignalCandidate cand;

      // A0: M1 ULTRA-FAST GOLD MOMENTUM
      if(g_cfg.strat_enabled[STRAT_A0_MOMENTUM] && stats.IsStrategyAvailable(STRAT_A0_MOMENTUM, now))
      {
         cand.Reset();
         if(micro.tick_velocity >= g_cfg.min_tick_velocity)
         {
            if(mtf.m1_ema_fast[0] > mtf.m1_ema_slow[0] &&
               ask > mtf.m1_ema_fast[0] &&
               micro.tick_imbalance >= 0.24 &&
               micro.price_velocity_pts > 0.0 &&
               mtf.m1_rsi[0] > 52.0 && mtf.m1_rsi[0] < 80.0 &&
               mtf.h1_trend_dir >= 0)
            {
               double prob = 0.56 + MathMin(0.10, micro.tick_imbalance * 0.12);
               FinalizeCandidate(cand, STRAT_A0_MOMENTUM, 1,
                                 atr * g_cfg.sl_atr_mult,
                                 atr * g_cfg.tp_atr_mult,
                                 prob, micro, mtf, stats);
            }
            else if(mtf.m1_ema_fast[0] < mtf.m1_ema_slow[0] &&
                    bid < mtf.m1_ema_fast[0] &&
                    micro.tick_imbalance <= -0.24 &&
                    micro.price_velocity_pts < 0.0 &&
                    mtf.m1_rsi[0] < 48.0 && mtf.m1_rsi[0] > 20.0 &&
                    mtf.h1_trend_dir <= 0)
            {
               double prob = 0.56 + MathMin(0.10, MathAbs(micro.tick_imbalance) * 0.12);
               FinalizeCandidate(cand, STRAT_A0_MOMENTUM, -1,
                                 atr * g_cfg.sl_atr_mult,
                                 atr * g_cfg.tp_atr_mult,
                                 prob, micro, mtf, stats);
            }
         }
         if(cand.valid && cand.score > best.score) best.CopyFrom(cand);
      }

      // A1: M1/M15 LIQUIDITY SWEEP REVERSAL
      if(g_cfg.strat_enabled[STRAT_A1_LIQ_SWEEP] && stats.IsStrategyAvailable(STRAT_A1_LIQ_SWEEP, now))
      {
         cand.Reset();
         bool bull_sweep = (mtf.m1_low[0] < mtf.m15_swing_low &&
                            mtf.m1_close[0] > mtf.m1_open[0] &&
                            (mtf.m1_close[0] - mtf.m1_low[0]) > atr * 0.65 &&
                            micro.tick_imbalance >= 0.20);

         bool bear_sweep = (mtf.m1_high[0] > mtf.m15_swing_high &&
                            mtf.m1_close[0] < mtf.m1_open[0] &&
                            (mtf.m1_high[0] - mtf.m1_close[0]) > atr * 0.65 &&
                            micro.tick_imbalance <= -0.20);

         if(bull_sweep)
         {
            double wick_sl = MathMax(atr * 1.25, (ask - mtf.m1_low[0]) + atr * 0.30);
            FinalizeCandidate(cand, STRAT_A1_LIQ_SWEEP, 1, wick_sl, wick_sl * 1.75, 0.58, micro, mtf, stats);
         }
         else if(bear_sweep)
         {
            double wick_sl = MathMax(atr * 1.25, (mtf.m1_high[0] - bid) + atr * 0.30);
            FinalizeCandidate(cand, STRAT_A1_LIQ_SWEEP, -1, wick_sl, wick_sl * 1.75, 0.58, micro, mtf, stats);
         }
         if(cand.valid && cand.score > best.score) best.CopyFrom(cand);
      }

      // A2: M1 QUANTITATIVE MEAN REVERSION
      if(g_cfg.strat_enabled[STRAT_A2_MEAN_REV] && stats.IsStrategyAvailable(STRAT_A2_MEAN_REV, now))
      {
         cand.Reset();
         if(mtf.m1_low[0] <= mtf.m1_bb_lower[0] &&
            mtf.m1_close[0] > mtf.m1_bb_lower[0] &&
            mtf.m1_rsi[0] < 32.0 &&
            micro.tick_imbalance >= 0.14)
         {
            double sl_d      = atr * 1.30;
            double target_tp = MathMax(sl_d * 1.50, mtf.m1_bb_mid[0] - ask);
            FinalizeCandidate(cand, STRAT_A2_MEAN_REV, 1, sl_d, target_tp, 0.60, micro, mtf, stats);
         }
         else if(mtf.m1_high[0] >= mtf.m1_bb_upper[0] &&
                 mtf.m1_close[0] < mtf.m1_bb_upper[0] &&
                 mtf.m1_rsi[0] > 68.0 &&
                 micro.tick_imbalance <= -0.14)
         {
            double sl_d      = atr * 1.30;
            double target_tp = MathMax(sl_d * 1.50, bid - mtf.m1_bb_mid[0]);
            FinalizeCandidate(cand, STRAT_A2_MEAN_REV, -1, sl_d, target_tp, 0.60, micro, mtf, stats);
         }
         if(cand.valid && cand.score > best.score) best.CopyFrom(cand);
      }

      // A3: M1 VOLATILITY EXPLOSION BREAKOUT
      if(g_cfg.strat_enabled[STRAT_A3_VOL_EXPL] && stats.IsStrategyAvailable(STRAT_A3_VOL_EXPL, now))
      {
         cand.Reset();
         double bar_range     = mtf.m1_high[0] - mtf.m1_low[0];
         bool   atr_expanding = (mtf.m1_atr[0] > mtf.m1_atr[1] * 1.03 && bar_range > atr * 1.25);

         if(atr_expanding && micro.tick_velocity >= g_cfg.min_tick_velocity)
         {
            if(mtf.m1_close[0] > mtf.m1_bb_upper[0] &&
               mtf.m1_close[1] <= mtf.m1_bb_upper[1] &&
               micro.tick_imbalance >= 0.22)
            {
               FinalizeCandidate(cand, STRAT_A3_VOL_EXPL, 1, atr * 1.40, atr * 2.35, 0.55, micro, mtf, stats);
            }
            else if(mtf.m1_close[0] < mtf.m1_bb_lower[0] &&
                    mtf.m1_close[1] >= mtf.m1_bb_lower[1] &&
                    micro.tick_imbalance <= -0.22)
            {
               FinalizeCandidate(cand, STRAT_A3_VOL_EXPL, -1, atr * 1.40, atr * 2.35, 0.55, micro, mtf, stats);
            }
         }
         if(cand.valid && cand.score > best.score) best.CopyFrom(cand);
      }

      // A4: M1 TREND IMPULSE CONTINUATION
      if(g_cfg.strat_enabled[STRAT_A4_TREND_IMP] && stats.IsStrategyAvailable(STRAT_A4_TREND_IMP, now))
      {
         cand.Reset();
         if(mtf.m1_ema_fast[0] > mtf.m1_ema_slow[0] &&
            mtf.m1_low[1] <= mtf.m1_ema_fast[1] &&
            mtf.m1_close[0] > mtf.m1_ema_fast[0] &&
            mtf.m1_close[0] > mtf.m1_open[0] &&
            micro.tick_imbalance >= 0.16)
         {
            FinalizeCandidate(cand, STRAT_A4_TREND_IMP, 1,
                              atr * g_cfg.sl_atr_mult,
                              atr * g_cfg.tp_atr_mult,
                              0.58, micro, mtf, stats);
         }
         else if(mtf.m1_ema_fast[0] < mtf.m1_ema_slow[0] &&
                 mtf.m1_high[1] >= mtf.m1_ema_fast[1] &&
                 mtf.m1_close[0] < mtf.m1_ema_fast[0] &&
                 mtf.m1_close[0] < mtf.m1_open[0] &&
                 micro.tick_imbalance <= -0.16)
         {
            FinalizeCandidate(cand, STRAT_A4_TREND_IMP, -1,
                              atr * g_cfg.sl_atr_mult,
                              atr * g_cfg.tp_atr_mult,
                              0.58, micro, mtf, stats);
         }
         if(cand.valid && cand.score > best.score) best.CopyFrom(cand);
      }

      return best;
   }

   // ENGINE B: Calibrated 3-Module M5/M15/H1 Macro-Swing Engine (B0 - B2)
   SSignalCandidate EvaluateEngineB(const CMicrostructureEngine &micro,
                                    const CMTFContextEngine &mtf,
                                    CAdaptiveStatsTracker &stats)
   {
      SSignalCandidate best;
      best.Reset();

      datetime now = TimeCurrent();
      double atr15 = mtf.m15_atr[0];
      if(atr15 <= 0.0) return best;

      double ask = SymbolInfoDouble(m_symbol, SYMBOL_ASK);
      double bid = SymbolInfoDouble(m_symbol, SYMBOL_BID);

      SSignalCandidate cand;

      // B0: M15/H1 DONCHIAN VOLATILITY BREAKOUT
      if(g_cfg.strat_enabled[STRAT_B0_M15_BREAKOUT] && stats.IsStrategyAvailable(STRAT_B0_M15_BREAKOUT, now))
      {
         cand.Reset();
         if(mtf.h1_adx[0] >= 20.0 && micro.tick_velocity >= g_cfg.min_tick_velocity)
         {
            if(mtf.h1_trend_dir >= 0 &&
               ask > mtf.m15_swing_high &&
               mtf.m15_close[0] > mtf.m15_open[0] &&
               micro.tick_imbalance >= 0.14)
            {
               double sl_d = atr15 * 1.40;
               FinalizeCandidate(cand, STRAT_B0_M15_BREAKOUT, 1, sl_d, sl_d * 2.50, 0.57, micro, mtf, stats, 0.10);
            }
            else if(mtf.h1_trend_dir <= 0 &&
                    bid < mtf.m15_swing_low &&
                    mtf.m15_close[0] < mtf.m15_open[0] &&
                    micro.tick_imbalance <= -0.14)
            {
               double sl_d = atr15 * 1.40;
               FinalizeCandidate(cand, STRAT_B0_M15_BREAKOUT, -1, sl_d, sl_d * 2.50, 0.57, micro, mtf, stats, 0.10);
            }
         }
         if(cand.valid && cand.score > best.score) best.CopyFrom(cand);
      }

      // B1: M15 BOLLINGER EXHAUSTION REVERSAL
      if(g_cfg.strat_enabled[STRAT_B1_M15_EXHAUST] && stats.IsStrategyAvailable(STRAT_B1_M15_EXHAUST, now))
      {
         cand.Reset();
         if(mtf.m15_low[0] < mtf.m15_bb_lower[0] &&
            mtf.m15_close[0] > mtf.m15_bb_lower[0] &&
            mtf.m15_rsi[0] < 32.0 &&
            micro.tick_imbalance >= 0.12)
         {
            double sl_d = MathMax(atr15 * 1.25, (ask - mtf.m15_low[0]) + atr15 * 0.20);
            double tp_d = MathMax(sl_d * 2.20, mtf.m15_bb_mid[0] - ask);
            FinalizeCandidate(cand, STRAT_B1_M15_EXHAUST, 1, sl_d, tp_d, 0.60, micro, mtf, stats, 0.10);
         }
         else if(mtf.m15_high[0] > mtf.m15_bb_upper[0] &&
                 mtf.m15_close[0] < mtf.m15_bb_upper[0] &&
                 mtf.m15_rsi[0] > 68.0 &&
                 micro.tick_imbalance <= -0.12)
         {
            double sl_d = MathMax(atr15 * 1.25, (mtf.m15_high[0] - bid) + atr15 * 0.20);
            double tp_d = MathMax(sl_d * 2.20, bid - mtf.m15_bb_mid[0]);
            FinalizeCandidate(cand, STRAT_B1_M15_EXHAUST, -1, sl_d, tp_d, 0.60, micro, mtf, stats, 0.10);
         }
         if(cand.valid && cand.score > best.score) best.CopyFrom(cand);
      }

      // B2: H1 INSTITUTIONAL TREND PULLBACK
      if(g_cfg.strat_enabled[STRAT_B2_H1_PULLBACK] && stats.IsStrategyAvailable(STRAT_B2_H1_PULLBACK, now))
      {
         cand.Reset();
         if(mtf.h1_adx[0] >= 20.0)
         {
            if(mtf.h1_trend_dir > 0 &&
               mtf.m15_rsi[1] < 42.0 && mtf.m15_rsi[0] > mtf.m15_rsi[1] &&
               mtf.m15_close[0] > mtf.m15_open[0] &&
               micro.tick_imbalance >= 0.12)
            {
               double sl_d = atr15 * 1.35;
               FinalizeCandidate(cand, STRAT_B2_H1_PULLBACK, 1, sl_d, sl_d * 2.40, 0.58, micro, mtf, stats, 0.10);
            }
            else if(mtf.h1_trend_dir < 0 &&
                    mtf.m15_rsi[1] > 58.0 && mtf.m15_rsi[0] < mtf.m15_rsi[1] &&
                    mtf.m15_close[0] < mtf.m15_open[0] &&
                    micro.tick_imbalance <= -0.12)
            {
               double sl_d = atr15 * 1.35;
               FinalizeCandidate(cand, STRAT_B2_H1_PULLBACK, -1, sl_d, sl_d * 2.40, 0.58, micro, mtf, stats, 0.10);
            }
         }
         if(cand.valid && cand.score > best.score) best.CopyFrom(cand);
      }

      return best;
   }

   // ENGINE C: Post-ATH Crash Recovery & Wave Surf (C0, C1, and NEW C2)
   SSignalCandidate EvaluateEngineC(const CMicrostructureEngine &micro,
                                    const CMTFContextEngine &mtf,
                                    CAdaptiveStatsTracker &stats)
   {
      SSignalCandidate best;
      best.Reset();

      datetime now = TimeCurrent();
      double atr1  = mtf.m1_atr[0];
      double atr5  = mtf.m5_atr[0];
      if(atr1 <= 0.0 || atr5 <= 0.0) return best;

      double ask = SymbolInfoDouble(m_symbol, SYMBOL_ASK);
      double bid = SymbolInfoDouble(m_symbol, SYMBOL_BID);

      SSignalCandidate cand;

      // C0: VOLATILITY EXHAUSTION REVERSAL (Calibrated for realistic post-ATH panic bounces)
      if(g_cfg.strat_enabled[STRAT_C0_VOL_SPIKE_REV] && stats.IsStrategyAvailable(STRAT_C0_VOL_SPIKE_REV, now))
      {
         cand.Reset();
         bool panic_dip   = (mtf.m1_rsi[0] < 24.0 && mtf.m1_low[0] <= mtf.m1_bb_lower[0] &&
                             mtf.m1_close[0] > mtf.m1_low[0] && micro.tick_imbalance >= 0.20);
         bool panic_spike = (mtf.m1_rsi[0] > 76.0 && mtf.m1_high[0] >= mtf.m1_bb_upper[0] &&
                             mtf.m1_close[0] < mtf.m1_high[0] && micro.tick_imbalance <= -0.20);

         if(panic_dip)
         {
            double sl_d = atr5 * 1.35;
            FinalizeCandidate(cand, STRAT_C0_VOL_SPIKE_REV, 1, sl_d, sl_d * 2.60, 0.60, micro, mtf, stats, 0.08);
         }
         else if(panic_spike)
         {
            double sl_d = atr5 * 1.35;
            FinalizeCandidate(cand, STRAT_C0_VOL_SPIKE_REV, -1, sl_d, sl_d * 2.60, 0.60, micro, mtf, stats, 0.08);
         }
         if(cand.valid && cand.score > best.score) best.CopyFrom(cand);
      }

      // C1: INSTITUTIONAL LIQUIDITY & M5 EMA RECLAIM
      if(g_cfg.strat_enabled[STRAT_C1_GRID_RECOV] && stats.IsStrategyAvailable(STRAT_C1_GRID_RECOV, now))
      {
         cand.Reset();
         if(micro.tick_velocity >= g_cfg.min_tick_velocity)
         {
            if(ask > mtf.m5_ema_fast[0] && mtf.m1_ema_fast[0] > mtf.m1_ema_slow[0] &&
               mtf.m15_rsi[0] > 45.0 && mtf.m15_rsi[0] < 72.0 && micro.tick_imbalance >= 0.18)
            {
               double sl_d = atr5 * 1.40;
               FinalizeCandidate(cand, STRAT_C1_GRID_RECOV, 1, sl_d, sl_d * 2.40, 0.58, micro, mtf, stats, 0.08);
            }
            else if(bid < mtf.m5_ema_fast[0] && mtf.m1_ema_fast[0] < mtf.m1_ema_slow[0] &&
                    mtf.m15_rsi[0] < 55.0 && mtf.m15_rsi[0] > 28.0 && micro.tick_imbalance <= -0.18)
            {
               double sl_d = atr5 * 1.40;
               FinalizeCandidate(cand, STRAT_C1_GRID_RECOV, -1, sl_d, sl_d * 2.40, 0.58, micro, mtf, stats, 0.08);
            }
         }
         if(cand.valid && cand.score > best.score) best.CopyFrom(cand);
      }

      // C2: POST-ATH VOLATILITY WAVE & ORDER-FLOW SURF (NEW V7.0 HIGH-PROFIT RECOVERY)
      // Surfs large directional waves (both liquidation dumps and recovery rallies) using M5 Donchian + Tick Acceleration
      if(g_cfg.strat_enabled[STRAT_C2_POST_ATH_SURF] && stats.IsStrategyAvailable(STRAT_C2_POST_ATH_SURF, now))
      {
         cand.Reset();
         bool vol_wave_active = (mtf.m5_atr[0] >= mtf.m5_atr_avg * 0.90 && micro.tick_velocity >= g_cfg.min_tick_velocity);

         if(vol_wave_active)
         {
            // Bullish recovery wave breakout
            if(ask > mtf.m5_donchian_high &&
               micro.tick_imbalance >= 0.22 &&
               micro.price_velocity_pts > 0.0 &&
               micro.price_accel_pts >= 0.0 &&
               mtf.m1_rsi[0] > 54.0 && mtf.m1_rsi[0] < 82.0)
            {
               double sl_d = atr5 * 1.30;
               FinalizeCandidate(cand, STRAT_C2_POST_ATH_SURF, 1, sl_d, sl_d * 2.80, 0.59, micro, mtf, stats, 0.08);
            }
            // Bearish liquidation wave surf (profits directly from post-ATH market dumps!)
            else if(bid < mtf.m5_donchian_low &&
                    micro.tick_imbalance <= -0.22 &&
                    micro.price_velocity_pts < 0.0 &&
                    micro.price_accel_pts <= 0.0 &&
                    mtf.m1_rsi[0] < 46.0 && mtf.m1_rsi[0] > 18.0)
            {
               double sl_d = atr5 * 1.30;
               FinalizeCandidate(cand, STRAT_C2_POST_ATH_SURF, -1, sl_d, sl_d * 2.80, 0.59, micro, mtf, stats, 0.08);
            }
         }
         if(cand.valid && cand.score > best.score) best.CopyFrom(cand);
      }

      return best;
   }
};

//+------------------------------------------------------------------+
//| 6. Multi-Tranche Execution & Position Manager                    |
//+------------------------------------------------------------------+
class CExecutionEngine
{
private:
   CTrade   m_trade;
   string   m_symbol;
   ulong    m_magic;
   datetime m_last_order_bar_a;
   datetime m_last_order_bar_b;
   datetime m_last_order_bar_c;
   datetime m_last_order_time;

   ENUM_ORDER_TYPE_FILLING ResolveFillingMode() const
   {
      uint filling = (uint)SymbolInfoInteger(m_symbol, SYMBOL_FILLING_MODE);
      if((filling & SYMBOL_FILLING_IOC) == SYMBOL_FILLING_IOC) return ORDER_FILLING_IOC;
      if((filling & SYMBOL_FILLING_FOK) == SYMBOL_FILLING_FOK) return ORDER_FILLING_FOK;
      return ORDER_FILLING_RETURN;
   }

public:
   double last_requested_price;

   void Init(const string symbol, ulong magic)
   {
      m_symbol             = symbol;
      m_magic              = magic;
      m_last_order_bar_a   = 0;
      m_last_order_bar_b   = 0;
      m_last_order_bar_c   = 0;
      m_last_order_time    = TimeCurrent();
      last_requested_price = 0.0;

      m_trade.SetExpertMagicNumber(m_magic);
      m_trade.SetDeviationInPoints(g_cfg.slippage_dev);
      m_trade.SetTypeFilling(ResolveFillingMode());
      m_trade.SetAsyncMode(false);
   }

   void RefreshConfig() { m_trade.SetDeviationInPoints(g_cfg.slippage_dev); }

   datetime GetLastOrderTime() const { return m_last_order_time; }

   int CountSymbolPositions() const
   {
      int count = 0;
      for(int i = PositionsTotal() - 1; i >= 0; i--)
      {
         ulong ticket = PositionGetTicket(i);
         if(ticket == 0) continue;
         if(PositionGetInteger(POSITION_MAGIC) == (long)m_magic && PositionGetString(POSITION_SYMBOL) == m_symbol)
            count++;
      }
      return count;
   }

   bool CanOpenNewPosition(ENUM_ACTIVE_ENGINE eng, datetime bar_time, datetime now, string &wait_msg) const
   {
      if(g_cfg.trading_paused)
      {
         wait_msg = "ENGINE PAUSED BY USER";
         return false;
      }
      int max_signals     = (eng == ENGINE_C_CRASH_RECOV) ? 2 : ((eng == ENGINE_B_MACRO_SWING) ? 2 : g_cfg.max_signals_symbol);
      int max_pos_allowed = max_signals * MathMax(1, InpMaxTranchesPerSignal);
      if(CountSymbolPositions() >= max_pos_allowed)
      {
         wait_msg = StringFormat("MAX ACTIVE POS (%d/%d)", CountSymbolPositions(), max_pos_allowed);
         return false;
      }
      if(eng == ENGINE_A_HYPER_SCALP && bar_time == m_last_order_bar_a)
      {
         wait_msg = "WAIT NEXT M1 BAR";
         return false;
      }
      if(eng == ENGINE_B_MACRO_SWING && bar_time == m_last_order_bar_b)
      {
         wait_msg = "WAIT NEXT M5 BAR (ENG B)";
         return false;
      }
      if(eng == ENGINE_C_CRASH_RECOV && bar_time == m_last_order_bar_c)
      {
         wait_msg = "WAIT NEXT M5 BAR (ENG C)";
         return false;
      }
      int cooldown = (eng == ENGINE_C_CRASH_RECOV) ? 10 : ((eng == ENGINE_B_MACRO_SWING) ? 30 : g_cfg.reentry_cooldown_sec);
      if((now - m_last_order_time) < cooldown)
      {
         wait_msg = "COOLDOWN TIMER ACTIVE";
         return false;
      }
      return true;
   }

   bool ExecuteCandidate(const SSignalCandidate &cand, double total_lots, double total_risk_money, datetime bar_time)
   {
      if(!cand.valid || total_lots <= 0.0) return false;

      m_trade.SetTypeFilling(ResolveFillingMode());
      m_trade.SetDeviationInPoints(g_cfg.slippage_dev);

      double min_lot  = SymbolInfoDouble(m_symbol, SYMBOL_VOLUME_MIN);
      double max_lot  = SymbolInfoDouble(m_symbol, SYMBOL_VOLUME_MAX);
      double lot_step = SymbolInfoDouble(m_symbol, SYMBOL_VOLUME_STEP);
      if(lot_step <= 0.0) lot_step = 0.01;
      if(max_lot <= 0.0)  max_lot  = 100.0;

      double remaining_lots = total_lots;
      int    tranches_sent  = 0;
      int    max_tranches   = MathMax(1, MathMin(InpMaxTranchesPerSignal, 8));

      while(remaining_lots >= min_lot && tranches_sent < max_tranches)
      {
         double slice_lot = MathMin(remaining_lots, max_lot);
         slice_lot = NormalizeDouble(MathFloor(slice_lot / lot_step) * lot_step, 2);
         if(slice_lot < min_lot) break;

         bool sent = false;
         for(int attempt = 0; attempt < 2; attempt++)
         {
            double price = (cand.direction > 0) ? SymbolInfoDouble(m_symbol, SYMBOL_ASK) : SymbolInfoDouble(m_symbol, SYMBOL_BID);
            price = NormalizePriceToTick(m_symbol, price);
            last_requested_price = price;

            if(cand.direction > 0)
               sent = m_trade.Buy(slice_lot, m_symbol, price, cand.sl_price, cand.tp_price, cand.tag);
            else
               sent = m_trade.Sell(slice_lot, m_symbol, price, cand.sl_price, cand.tp_price, cand.tag);

            uint retcode = m_trade.ResultRetcode();
            if(sent && (retcode == TRADE_RETCODE_DONE || retcode == TRADE_RETCODE_PLACED))
            {
               tranches_sent++;
               remaining_lots = NormalizeDouble(remaining_lots - slice_lot, 2);

               ulong deal_id = m_trade.ResultDeal();
               ulong pos_id  = 0;
               if(deal_id > 0 && HistoryDealSelect(deal_id))
                  pos_id = (ulong)HistoryDealGetInteger(deal_id, DEAL_POSITION_ID);
               if(pos_id == 0)
               {
                  for(int p = PositionsTotal() - 1; p >= 0; p--)
                  {
                     ulong pt = PositionGetTicket(p);
                     if(pt > 0 && PositionGetInteger(POSITION_MAGIC) == (long)m_magic && PositionGetString(POSITION_SYMBOL) == m_symbol)
                     {
                        ulong cand_id = (ulong)PositionGetInteger(POSITION_IDENTIFIER);
                        if(g_pos_reg.FindIndex(cand_id) < 0) { pos_id = cand_id; break; }
                     }
                  }
               }
               double init_sl_dist = MathAbs(price - cand.sl_price);
               double slice_risk   = total_risk_money * (slice_lot / total_lots);
               if(pos_id > 0)
                  g_pos_reg.Register(pos_id, cand.strategy, cand.direction, init_sl_dist, slice_risk);
               break;
            }

            if(retcode != TRADE_RETCODE_REQUOTE && retcode != TRADE_RETCODE_PRICE_OFF && retcode != TRADE_RETCODE_PRICE_CHANGED)
            {
               g_cfg.SetStatus(StringFormat("ORDER REJECTED: %u", retcode), true);
               remaining_lots = 0.0;
               break;
            }
         }
      }

      if(tranches_sent > 0)
      {
         if(IsStrategyEngineC(cand.strategy)) m_last_order_bar_c = bar_time;
         else if(IsStrategyEngineB(cand.strategy)) m_last_order_bar_b = bar_time;
         else m_last_order_bar_a = bar_time;

         m_last_order_time = TimeCurrent();
         g_cfg.SetStatus(StringFormat("EXEC: %s %s %.2fL (%dx) ExpR:%+.2f",
                         StrategyShortCode(cand.strategy), (cand.direction > 0 ? "BUY" : "SELL"),
                         total_lots, tranches_sent, cand.net_expectancy_r), false);
         return true;
      }
      return false;
   }

   void CloseAllMagicPositions(const string reason)
   {
      PrintFormat("[MIDAS VX ACTION] Closing EA positions (Magic=%I64u). Reason: %s", m_magic, reason);
      for(int i = PositionsTotal() - 1; i >= 0; i--)
      {
         ulong ticket = PositionGetTicket(i);
         if(ticket == 0) continue;
         if(PositionGetInteger(POSITION_MAGIC) != (long)m_magic) continue;
         m_trade.PositionClose(ticket, g_cfg.slippage_dev);
      }
   }

   void ManageOpenPositions(const CMicrostructureEngine &micro, const CMTFContextEngine &mtf)
   {
      double atr1  = mtf.m1_atr[0];
      double atr5  = mtf.m5_atr[0];
      double point = SymbolInfoDouble(m_symbol, SYMBOL_POINT);
      if(atr1 <= 0.0 || point <= 0.0) return;

      long freeze_level = SymbolInfoInteger(m_symbol, SYMBOL_TRADE_FREEZE_LEVEL);
      long stops_level  = SymbolInfoInteger(m_symbol, SYMBOL_TRADE_STOPS_LEVEL);
      double min_dist   = (double)(MathMax(freeze_level, stops_level) + 5) * point;

      double min_lot  = SymbolInfoDouble(m_symbol, SYMBOL_VOLUME_MIN);
      double lot_step = SymbolInfoDouble(m_symbol, SYMBOL_VOLUME_STEP);
      if(lot_step <= 0.0) lot_step = 0.01;

      datetime now = TimeCurrent();

      for(int i = PositionsTotal() - 1; i >= 0; i--)
      {
         ulong ticket = PositionGetTicket(i);
         if(ticket == 0) continue;
         if(PositionGetInteger(POSITION_MAGIC) != (long)m_magic) continue;
         if(PositionGetString(POSITION_SYMBOL) != m_symbol) continue;

         ulong    pos_id    = (ulong)PositionGetInteger(POSITION_IDENTIFIER);
         long     pos_type  = PositionGetInteger(POSITION_TYPE);
         double   open_px   = PositionGetDouble(POSITION_PRICE_OPEN);
         double   cur_sl    = PositionGetDouble(POSITION_SL);
         double   cur_tp    = PositionGetDouble(POSITION_TP);
         double   vol       = PositionGetDouble(POSITION_VOLUME);
         datetime open_time = (datetime)PositionGetInteger(POSITION_TIME);

         SPositionMeta meta;
         ENUM_STRATEGY_ID sid = ParseStrategyFromComment(PositionGetString(POSITION_COMMENT));
         double initial_risk  = 0.0;
         bool   is_part_done  = false;
         if(g_pos_reg.GetMeta(pos_id, meta) && meta.initial_sl_dist > 0.0)
         {
            sid          = meta.strategy;
            initial_risk = meta.initial_sl_dist;
            is_part_done = meta.partial_closed;
         }
         else
         {
            initial_risk = (cur_sl > 0.0) ? MathAbs(open_px - cur_sl) : (atr1 * g_cfg.sl_atr_mult);
            if(initial_risk <= 0.0) initial_risk = atr1;
            g_pos_reg.Register(pos_id, sid, (pos_type == POSITION_TYPE_BUY ? 1 : -1), initial_risk, 0.0);
         }

         bool is_eng_b = IsStrategyEngineB(sid);
         bool is_eng_c = IsStrategyEngineC(sid);
         int  max_hold = is_eng_c ? 3600 : (is_eng_b ? 7200 : g_cfg.max_hold_sec);

         double cur_px = (pos_type == POSITION_TYPE_BUY) ? SymbolInfoDouble(m_symbol, SYMBOL_BID) : SymbolInfoDouble(m_symbol, SYMBOL_ASK);

         if(max_hold > 0 && (now - open_time) >= max_hold)
         {
            m_trade.PositionClose(ticket, g_cfg.slippage_dev);
            continue;
         }

         double unrealized_dist = (pos_type == POSITION_TYPE_BUY) ? (cur_px - open_px) : (open_px - cur_px);
         double true_rr         = unrealized_dist / initial_risk;

         if(!is_eng_b && !is_eng_c && InpUseMomentumExit && true_rr >= 0.55)
         {
            bool rev_flip = (pos_type == POSITION_TYPE_BUY  && micro.tick_imbalance <= -0.58 && micro.price_velocity_pts < 0.0) ||
                            (pos_type == POSITION_TYPE_SELL && micro.tick_imbalance >=  0.58 && micro.price_velocity_pts > 0.0);
            if(rev_flip)
            {
               m_trade.PositionClose(ticket, g_cfg.slippage_dev);
               continue;
            }
         }

         double req_part_rr  = is_eng_c ? 0.85 : (is_eng_b ? 0.95 : g_cfg.partial_close_rr);
         double req_part_pct = is_eng_c ? 60.0 : (is_eng_b ? 55.0 : g_cfg.partial_close_pct);
         if(InpUsePartialClose && true_rr >= req_part_rr && !is_part_done)
         {
            double close_vol = MathFloor((vol * (req_part_pct / 100.0)) / lot_step) * lot_step;
            close_vol = NormalizeDouble(close_vol, 2);
            if(close_vol >= min_lot && (vol - close_vol) >= min_lot)
            {
               if(m_trade.PositionClosePartial(ticket, close_vol, g_cfg.slippage_dev))
               {
                  g_pos_reg.MarkPartialClosed(pos_id);
                  double be_buffer = MathMax(2.0 * point, (SymbolInfoDouble(m_symbol, SYMBOL_ASK) - SymbolInfoDouble(m_symbol, SYMBOL_BID)) * 0.25);
                  double be_sl = (pos_type == POSITION_TYPE_BUY) ? (open_px + be_buffer) : (open_px - be_buffer);
                  be_sl = NormalizePriceToTick(m_symbol, be_sl);
                  if(MathAbs(cur_px - be_sl) >= min_dist)
                     m_trade.PositionModify(ticket, be_sl, cur_tp);
                  continue;
               }
            }
         }

         double req_trail_rr = is_eng_c ? 0.60 : (is_eng_b ? 0.75 : g_cfg.trail_act_rr);
         if(InpUseTrailingStop && true_rr >= req_trail_rr)
         {
            double base_atr   = (is_eng_c || is_eng_b) ? ((atr5 > 0.0) ? atr5 : atr1) : atr1;
            double trail_mult = is_eng_c ? 0.50 : (is_eng_b ? 0.60 : g_cfg.trail_step_atr);
            double trail_dist = MathMax(min_dist, base_atr * trail_mult);
            if(pos_type == POSITION_TYPE_BUY)
            {
               double desired_sl = NormalizePriceToTick(m_symbol, cur_px - trail_dist);
               if(desired_sl > cur_sl + point && (cur_px - desired_sl) >= min_dist)
                  m_trade.PositionModify(ticket, desired_sl, cur_tp);
            }
            else if(pos_type == POSITION_TYPE_SELL)
            {
               double desired_sl = NormalizePriceToTick(m_symbol, cur_px + trail_dist);
               if((cur_sl == 0.0 || desired_sl < cur_sl - point) && (desired_sl - cur_px) >= min_dist)
                  m_trade.PositionModify(ticket, desired_sl, cur_tp);
            }
         }
      }
   }
};

