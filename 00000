struct SRuntimeConfig
{
   ENUM_RISK_MODE risk_mode;
   double         risk_pct;
   double         max_daily_loss_pct;
   double         max_cycle_dd_pct;
   double         max_cum_risk_pct;
   int            max_signals_symbol;

   int            tick_window;
   double         min_tick_velocity;
   double         min_expectancy_r;
   double         base_slippage_pips;
   double         max_spread_pips;
   double         max_spread_atr_ratio;

   double         sl_atr_mult;
   double         tp_atr_mult;
   double         be_rr;
   double         partial_close_rr;
   double         partial_close_pct;
   double         trail_act_rr;
   double         trail_step_atr;
   int            max_hold_sec;
   int            reentry_cooldown_sec;

   int            rolling_window_trades;
   int            min_trades_adapt;
   double         suspend_exp_floor;
   int            suspend_cooldown_min;
   ulong          slippage_dev;

   bool           strat_enabled[STRAT_COUNT];
   bool           trading_paused;
   string         status_text;
   bool           status_is_alert;

   void SetStatus(const string msg, bool is_alert = false)
   {
      status_text     = msg;
      status_is_alert = is_alert;
   }

   void LoadBaseFromInputs()
   {
      tick_window           = InpTickWindow;
      min_tick_velocity     = InpMinTickVelocity;
      min_expectancy_r      = InpMinExpectancyR;
      base_slippage_pips    = InpBaseSlippagePips;
      max_spread_pips       = InpMaxSpreadPips;
      max_spread_atr_ratio  = InpMaxSpreadATR_Ratio;

      sl_atr_mult           = InpSL_ATR_Multiplier;
      tp_atr_mult           = InpTP_ATR_Multiplier;
      be_rr                 = InpBreakevenRR;
      partial_close_rr      = InpPartialCloseRR;
      partial_close_pct     = InpPartialClosePct;
      trail_act_rr          = InpTrailActivationRR;
      trail_step_atr        = InpTrailStepATR;
      max_hold_sec          = InpMaxHoldSeconds;
      reentry_cooldown_sec  = InpReEntryCooldownSec;

      rolling_window_trades = InpRollingWindowTrades;
      min_trades_adapt      = InpMinTradesForAdapt;
      suspend_exp_floor     = InpSuspendExpectancyFloor;
      suspend_cooldown_min  = InpSuspendCooldownMinutes;
      slippage_dev          = InpSlippageDeviation;
      max_cum_risk_pct      = InpMaxCumulativeRiskPct;
      max_signals_symbol    = InpMaxOpenSignalsSymbol;
   }

   void ApplyRiskMode(ENUM_RISK_MODE mode, bool from_ui_click)
   {
      risk_mode = mode;

      if(mode == RISK_MODE_AGGRESSIVE)
      {
         risk_pct           = 1.00;
         max_daily_loss_pct = 8.0;
         max_cycle_dd_pct   = 24.0;
         if(from_ui_click)
         {
            max_cum_risk_pct   = 5.0;
            max_signals_symbol = 2;
            min_expectancy_r   = 0.08;
         }
      }
      else if(mode == RISK_MODE_SUPER_AGGRESSIVE)
      {
         risk_pct           = 1.85;
         max_daily_loss_pct = 12.0;
         max_cycle_dd_pct   = 28.0;
         if(from_ui_click)
         {
            max_cum_risk_pct   = 6.0;
            max_signals_symbol = 2;
            min_expectancy_r   = 0.06;
         }
      }
      else
      {
         risk_pct           = 2.85;
         max_daily_loss_pct = 15.0;
         max_cycle_dd_pct   = 32.0;
         if(from_ui_click)
         {
            max_cum_risk_pct   = 8.0;
            max_signals_symbol = 3;
            min_expectancy_r   = 0.04;
         }
      }

      if(!from_ui_click)
      {
         if(InpCustomRiskPct > 0.0)   risk_pct           = MathMin(InpCustomRiskPct, 6.0);
         if(InpMaxDailyLossPct > 0.0) max_daily_loss_pct = InpMaxDailyLossPct;
         if(InpMaxCycleDDPct > 0.0)   max_cycle_dd_pct   = InpMaxCycleDDPct;
      }
   }

   void InitFromInputs(ulong magic, const string symbol)
   {
      LoadBaseFromInputs();

      strat_enabled[STRAT_A0_MOMENTUM]      = InpEnableStratA0_Momentum;
      strat_enabled[STRAT_A1_LIQ_SWEEP]     = InpEnableStratA1_LiqSweep;
      strat_enabled[STRAT_A2_MEAN_REV]      = InpEnableStratA2_MeanRev;
      strat_enabled[STRAT_A3_VOL_EXPL]      = InpEnableStratA3_VolExpl;
      strat_enabled[STRAT_A4_TREND_IMP]     = InpEnableStratA4_TrendImp;
      strat_enabled[STRAT_A5_INST_PULLBACK] = InpEnableStratA5_Pullback;

      trading_paused                        = false;
      SetStatus("INITIALIZING V8.1 ANTI-HANG ENGINE...", false);

      string gv_mode = StringFormat("MVX81_MODE_%I64u_%s", magic, symbol);
      if(!MQLInfoInteger(MQL_TESTER) && GlobalVariableCheck(gv_mode))
      {
         int saved = (int)GlobalVariableGet(gv_mode);
         if(saved >= 0 && saved <= 2)
         {
            ApplyRiskMode((ENUM_RISK_MODE)saved, true);
            return;
         }
      }
      ApplyRiskMode(InpRiskMode, false);
   }

   void SaveModeState(ulong magic, const string symbol) const
   {
      if(MQLInfoInteger(MQL_TESTER)) return;
      string gv_mode = StringFormat("MVX81_MODE_%I64u_%s", magic, symbol);
      GlobalVariableSet(gv_mode, (double)risk_mode);
   }
};

