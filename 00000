   void Update(const CMicrostructureEngine &micro,
               const CMTFContextEngine &mtf,
               const CRiskAndCapitalManager &risk,
               const CAdaptiveStatsTracker &stats,
               const CExecutionEngine &exec)
   {
      if(!m_enabled) return;

      if(m_minimized)
      {
         color m_clr = (g_cfg.risk_mode == RISK_MODE_AGGRESSIVE) ? C_CYAN :
                       ((g_cfg.risk_mode == RISK_MODE_SUPER_AGGRESSIVE) ? C_AMBER : C_CRIMSON);
         SetText("HDR_BADGE", RiskModeName(g_cfg.risk_mode), m_clr);
         return;
      }

      color active_clr = (g_cfg.risk_mode == RISK_MODE_AGGRESSIVE) ? C_CYAN :
                         ((g_cfg.risk_mode == RISK_MODE_SUPER_AGGRESSIVE) ? C_AMBER : C_CRIMSON);

      StyleButton("BTN_MODE_0", "1. AGGRESSIVE",
                  (g_cfg.risk_mode == RISK_MODE_AGGRESSIVE) ? C_BG_MAIN : C_TEXT_SEC,
                  (g_cfg.risk_mode == RISK_MODE_AGGRESSIVE) ? C_CYAN : C_BTN_IDLE,
                  (g_cfg.risk_mode == RISK_MODE_AGGRESSIVE) ? C_CYAN : C_BORDER);

      StyleButton("BTN_MODE_1", "2. SUPER AGGR",
                  (g_cfg.risk_mode == RISK_MODE_SUPER_AGGRESSIVE) ? C_BG_MAIN : C_TEXT_SEC,
                  (g_cfg.risk_mode == RISK_MODE_SUPER_AGGRESSIVE) ? C_AMBER : C_BTN_IDLE,
                  (g_cfg.risk_mode == RISK_MODE_SUPER_AGGRESSIVE) ? C_AMBER : C_BORDER);

      StyleButton("BTN_MODE_2", "3. EXTREME RES",
                  (g_cfg.risk_mode == RISK_MODE_EXTREME_RESEARCH) ? C_BG_MAIN : C_TEXT_SEC,
                  (g_cfg.risk_mode == RISK_MODE_EXTREME_RESEARCH) ? C_CRIMSON : C_BTN_IDLE,
                  (g_cfg.risk_mode == RISK_MODE_EXTREME_RESEARCH) ? C_CRIMSON : C_BORDER);

      string spec = StringFormat("Risk:%.2f%% | Daily:%.1f%% | CycleDD:%.1f%% | ExpR>=%.2f",
                                 g_cfg.risk_pct, g_cfg.max_daily_loss_pct, g_cfg.max_cycle_dd_pct, g_cfg.min_expectancy_r);
      SetText("LBL_MODE_SPEC", spec, active_clr);

      double eq    = AccountInfoDouble(ACCOUNT_EQUITY);
      double bal   = AccountInfoDouble(ACCOUNT_BALANCE);
      double ath   = risk.GetATHEquity();
      double delev = risk.GetDrawdownRiskMultiplier();
      SetText("VAL_EQ_BAL", StringFormat("Equity: $%.2f | Bal: $%.2f", eq, bal), C_TEXT_PRI);
      SetText("VAL_ATH_EQ", StringFormat("ATH Peak: $%.2f | RiskMult: %.2fx", ath, delev), C_AMBER);

      double pnl_m = risk.GetTodayPnLMoney();
      double pnl_p = risk.GetTodayPnLPct();
      color pnl_c  = (pnl_m >= 0.0) ? C_EMERALD : C_CRIMSON;
      SetText("VAL_TODAY_PNL", StringFormat("Today P&L: %+.2f (%+.2f%%)", pnl_m, pnl_p), pnl_c);

      double d_loss = risk.GetCurrentDailyLossPct();
      double d_lim  = MathMax(0.1, g_cfg.max_daily_loss_pct);
      double d_fill = MathMin(1.0, d_loss / d_lim);
      color d_clr   = (d_fill > 0.75) ? C_CRIMSON : ((d_fill > 0.45) ? C_AMBER : C_EMERALD);
      SetText("LBL_DAILY_BAR", StringFormat("Daily Loss: %.2f%% / %.1f%%", d_loss, d_lim), C_TEXT_SEC);
      ObjectSetInteger(0, UI_PREFIX + "BAR_DAILY_FG", OBJPROP_XSIZE, MathMax(2, (int)(158.0 * d_fill)));
      ObjectSetInteger(0, UI_PREFIX + "BAR_DAILY_FG", OBJPROP_BGCOLOR, d_clr);
      ObjectSetInteger(0, UI_PREFIX + "BAR_DAILY_FG", OBJPROP_COLOR, d_clr);

      double cyc_dd  = risk.GetCurrentCycleDDPct();
      double dd_lim  = MathMax(0.1, g_cfg.max_cycle_dd_pct);
      double dd_fill = MathMin(1.0, cyc_dd / dd_lim);
      color dd_clr   = (dd_fill > 0.75) ? C_CRIMSON : ((dd_fill > 0.45) ? C_AMBER : C_CYAN);
      SetText("LBL_DD_BAR", StringFormat("Cycle DD:   %.2f%% / %.1f%%", cyc_dd, dd_lim), C_TEXT_SEC);
      ObjectSetInteger(0, UI_PREFIX + "BAR_DD_FG", OBJPROP_XSIZE, MathMax(2, (int)(158.0 * dd_fill)));
      ObjectSetInteger(0, UI_PREFIX + "BAR_DD_FG", OBJPROP_BGCOLOR, dd_clr);
      ObjectSetInteger(0, UI_PREFIX + "BAR_DD_FG", OBJPROP_COLOR, dd_clr);

      double cum_r = risk.GetCumulativeOpenRiskPct();
      int open_pos = exec.CountSymbolPositions();
      SetText("VAL_CUM_RISK", StringFormat("CumRisk: %.2f%% / %.1f%% | Pos: %d / %d",
              cum_r, g_cfg.max_cum_risk_pct, open_pos, g_cfg.max_pos_symbol), C_TEXT_PRI);

      string h1_txt = (mtf.h1_trend_dir > 0) ? "BULL ▲" : ((mtf.h1_trend_dir < 0) ? "BEAR ▼" : "FLAT ◆");
      SetText("VAL_REGIME", StringFormat("%s | H1:%s", RegimeName(mtf.current_regime), h1_txt), C_CYAN);

      double point     = SymbolInfoDouble(_Symbol, SYMBOL_POINT);
      double pip_scale = GetGoldPipScale(_Symbol);
      double spr_pips  = (pip_scale > 0.0) ? (micro.current_spread_pts / pip_scale) : 0.0;
      double atr_pts   = (point > 0.0 && mtf.m1_atr[0] > 0.0) ? (mtf.m1_atr[0] / point) : 0.0;
      double spr_rat   = (atr_pts > 0.0) ? (micro.current_spread_pts / atr_pts) : 0.0;
      color spr_clr    = (spr_rat > g_cfg.max_spread_atr_ratio) ? C_CRIMSON : C_TEXT_PRI;
      SetText("VAL_VEL_SPR", StringFormat("TickVel:%.1f/s | Spr:%.1fp (%.2f ATR)",
              micro.tick_velocity, spr_pips, spr_rat), spr_clr);

      double slip_pips = (pip_scale > 0.0) ? (micro.estimated_slippage_pts / pip_scale) : 0.0;
      SetText("VAL_AC_SLIP", StringFormat("AC:%+.2f | Comm:$%.1f/L | Slip:%.2fp",
              mtf.m1_autocorr_lag1, micro.GetEffectiveCommissionPerLot(), slip_pips), C_TEXT_SEC);

      double imb = MathMax(-1.0, MathMin(1.0, micro.tick_imbalance));
      SetText("LBL_IMB", StringFormat("Tick Imbalance: %+4.0f%%", imb * 100.0), (imb >= 0.0 ? C_EMERALD : C_CRIMSON));
      int half_w  = 78;
      int bar_w   = MathMax(2, (int)(MathAbs(imb) * half_w));
      int bar_x   = (imb >= 0.0) ? (m_x + 268) : (m_x + 268 - bar_w);
      color imb_c = (imb >= 0.0) ? C_EMERALD : C_CRIMSON;
      ObjectSetInteger(0, UI_PREFIX + "BAR_IMB_FG", OBJPROP_XDISTANCE, bar_x);
      ObjectSetInteger(0, UI_PREFIX + "BAR_IMB_FG", OBJPROP_XSIZE, bar_w);
      ObjectSetInteger(0, UI_PREFIX + "BAR_IMB_FG", OBJPROP_BGCOLOR, imb_c);
      ObjectSetInteger(0, UI_PREFIX + "BAR_IMB_FG", OBJPROP_COLOR, imb_c);

      for(int i = 0; i < STRAT_COUNT; i++)
      {
         ENUM_STRATEGY_ID sid = (ENUM_STRATEGY_ID)i;
         string idx_s = IntegerToString(i);
         bool en   = g_cfg.strat_enabled[i];
         bool susp = stats.IsSuspended(sid);

         if(!en)
            StyleButton("BTN_STRAT_" + idx_s, "OFF", C_TEXT_SEC, C_BTN_IDLE, C_BORDER);
         else if(susp)
            StyleButton("BTN_STRAT_" + idx_s, "SUSP", C_BG_MAIN, C_AMBER, C_AMBER);
         else
            StyleButton("BTN_STRAT_" + idx_s, "ON", C_BG_MAIN, C_EMERALD, C_EMERALD);

         int trd    = stats.GetTotalTrades(sid);
         double pnl = stats.GetNetProfit(sid);
         double er  = stats.GetRollingExpR(sid);
         color st_c = (pnl > 0.0) ? C_EMERALD : ((pnl < 0.0) ? C_CRIMSON : C_TEXT_SEC);
         SetText("S_STATS_" + idx_s, StringFormat("%3d %+8.2f %+5.2fR", trd, pnl, er), st_c);
      }

      SetText("VAL_STATUS", "STATUS: " + g_cfg.status_text, (g_cfg.status_is_alert ? C_AMBER : C_EMERALD));

      if(g_cfg.trading_paused)
         StyleButton("BTN_PAUSE", "ENGINE: PAUSED (CLICK)", C_BG_MAIN, C_AMBER, C_AMBER);
      else
         StyleButton("BTN_PAUSE", "ENGINE: ACTIVE", C_BG_MAIN, C_EMERALD, C_EMERALD);

      if(m_close_confirm_until > 0 && TimeLocal() <= m_close_confirm_until)
         StyleButton("BTN_CLOSE_ALL", "CONFIRM CLOSE ALL?", C_TEXT_PRI, C_CRIMSON, C_AMBER);
      else
      {
         m_close_confirm_until = 0;
         StyleButton("BTN_CLOSE_ALL", "CLOSE ALL POSITIONS", C_TEXT_PRI, C'65,24,32', C_CRIMSON);
      }
   }

   bool OnClick(const string sparam,
                CMicrostructureEngine &micro,
                CAdaptiveStatsTracker &stats,
                CExecutionEngine &exec)
   {
      if(!m_enabled || StringFind(sparam, UI_PREFIX) != 0)
         return false;

      ObjectSetInteger(0, sparam, OBJPROP_STATE, false);

      if(sparam == UI_PREFIX + "BTN_MIN")
      {
         m_minimized = !m_minimized;
         BuildLayout();
         return true;
      }

      double pip_scale = GetGoldPipScale(_Symbol);

      if(sparam == UI_PREFIX + "BTN_MODE_0")
      {
         g_cfg.ApplyRiskMode(RISK_MODE_AGGRESSIVE, true);
         g_cfg.SaveModeState(InpMagicNumber, _Symbol);
         micro.SetBaselineSlippage(g_cfg.base_slippage_pips * pip_scale);
         exec.RefreshConfig();
         g_cfg.SetStatus("MODE 1: AGGRESSIVE ACTIVATED", false);
         return true;
      }

      if(sparam == UI_PREFIX + "BTN_MODE_1")
      {
         g_cfg.ApplyRiskMode(RISK_MODE_SUPER_AGGRESSIVE, true);
         g_cfg.SaveModeState(InpMagicNumber, _Symbol);
         micro.SetBaselineSlippage(g_cfg.base_slippage_pips * pip_scale);
         exec.RefreshConfig();
         g_cfg.SetStatus("MODE 2: SUPER AGGRESSIVE ACTIVATED", false);
         return true;
      }

      if(sparam == UI_PREFIX + "BTN_MODE_2")
      {
         g_cfg.ApplyRiskMode(RISK_MODE_EXTREME_RESEARCH, true);
         g_cfg.SaveModeState(InpMagicNumber, _Symbol);
         micro.SetBaselineSlippage(g_cfg.base_slippage_pips * pip_scale);
         exec.RefreshConfig();
         g_cfg.SetStatus("MODE 3: EXTREME RESEARCH ACTIVATED", false);
         return true;
      }

      for(int i = 0; i < STRAT_COUNT; i++)
      {
         if(sparam == UI_PREFIX + "BTN_STRAT_" + IntegerToString(i))
         {
            ENUM_STRATEGY_ID sid = (ENUM_STRATEGY_ID)i;
            if(stats.IsSuspended(sid))
            {
               stats.ClearSuspension(sid);
               g_cfg.strat_enabled[i] = true;
               g_cfg.SetStatus(StrategyShortCode(sid) + " SUSPENSION CLEARED", false);
            }
            else
            {
               g_cfg.strat_enabled[i] = !g_cfg.strat_enabled[i];
               g_cfg.SetStatus(StrategyShortCode(sid) + (g_cfg.strat_enabled[i] ? " ENABLED" : " DISABLED"), false);
            }
            return true;
         }
      }

      if(sparam == UI_PREFIX + "BTN_PAUSE")
      {
         g_cfg.trading_paused = !g_cfg.trading_paused;
         g_cfg.SetStatus(g_cfg.trading_paused ? "ENGINE PAUSED BY USER" : "ENGINE RESUMED", g_cfg.trading_paused);
         return true;
      }

      if(sparam == UI_PREFIX + "BTN_CLOSE_ALL")
      {
         datetime now_loc = TimeLocal();
         if(m_close_confirm_until == 0 || now_loc > m_close_confirm_until)
            m_close_confirm_until = now_loc + 4;
         else
         {
            m_close_confirm_until = 0;
            exec.CloseAllMagicPositions("Manual Close-All Triggered via HUD Panel");
            g_cfg.SetStatus("ALL EA POSITIONS CLOSED", true);
         }
         return true;
      }

      return false;
   }
};

