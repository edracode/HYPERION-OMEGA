//+------------------------------------------------------------------+
//| Gold Pip Normalization Helper (2-Digit vs 3-Digit Brokers)       |
//+------------------------------------------------------------------+
double GetGoldPipScale(const string symbol)
{
   int digits = (int)SymbolInfoInteger(symbol, SYMBOL_DIGITS);
   // 3-digit XAUUSD (0.001) -> 1 Gold pip ($0.10) = 100 pts; 2-digit XAUUSD (0.01) -> 1 Gold pip = 10 pts
   if(digits == 3 || digits == 5) return 10.0;
   return 1.0;
}

