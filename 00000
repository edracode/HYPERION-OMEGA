   PrintFormat("[MIDAS VX V3.0 APEX] Initialized on %s (Digits=%d) | Mode=%s | Risk=%.2f%% | CycleDD=%.1f%%",
               _Symbol, (int)SymbolInfoInteger(_Symbol, SYMBOL_DIGITS),
               RiskModeName(g_cfg.risk_mode), g_cfg.risk_pct, g_cfg.max_cycle_dd_pct);

   return INIT_SUCCEEDED;
