void OnTick()
{
   g_panel.PollTesterButtonClicks(g_micro, g_stats, g_exec);

   MqlTick tick;
   if(!SymbolInfoTick(_Symbol, tick)) return;

   double point = SymbolInfoDouble(_Symbol, SYMBOL_POINT);
   g_micro.OnNewTick(tick, point);
   g_risk.UpdateEquityState();

   bool is_recov  = g_risk.IsEngineCActive();
   bool mtf_ready = g_mtf.Update(is_recov);
   if(!mtf_ready)
   {
      g_cfg.SetStatus("LOADING MTF BARS...", true);
      g_panel.Update(g_micro, g_mtf, g_risk, g_stats, g_shadow, g_exec);
      return;
   }

   g_shadow.UpdateAll(tick, g_mtf);

   string switch_reason = "";
   bool   switch_close  = false;
   if(g_risk.EvaluateDualEngineSwitch(g_shadow, g_stats, g_exec.GetLastOrderTime(), switch_reason, switch_close))
   {
      g_cfg.SetStatus(switch_reason, true);
      if(switch_close && g_exec.CountSymbolPositions() > 0)
         g_exec.CloseAllMagicPositions(switch_reason);
      g_panel.Update(g_micro, g_mtf, g_risk, g_stats, g_shadow, g_exec);
      return;
   }

   string breach_reason = "";
   bool   close_all     = false;
   if(g_risk.CheckRiskCircuitBreaker(breach_reason, close_all))
   {
      g_cfg.SetStatus(breach_reason, true);
      if(close_all && g_exec.CountSymbolPositions() > 0)
         g_exec.CloseAllMagicPositions(breach_reason);
      g_panel.Update(g_micro, g_mtf, g_risk, g_stats, g_shadow, g_exec);
      return;
   }

   g_exec.ManageOpenPositions(g_micro, g_mtf);

   if(!g_micro.IsReady())
   {
      g_cfg.SetStatus("WARMING UP TICK BUFFER...", false);
      g_panel.Update(g_micro, g_mtf, g_risk, g_stats, g_shadow, g_exec);
      return;
   }

   ENUM_ACTIVE_ENGINE eng = g_risk.GetActiveEngine();
   string filter_reason   = "";
   if(!PassesEnvironmentFilters(eng, filter_reason))
   {
      g_cfg.SetStatus(filter_reason, true);
      g_panel.Update(g_micro, g_mtf, g_risk, g_stats, g_shadow, g_exec);
      return;
   }

   datetime bar_m1  = iTime(_Symbol, PERIOD_M1, 0);
   datetime bar_m5  = iTime(_Symbol, PERIOD_M5, 0);
   datetime now     = TimeCurrent();

   SSignalCandidate cand_a = g_scorer.EvaluateEngineA(g_micro, g_mtf, g_stats);
   SSignalCandidate cand_b = g_scorer.EvaluateEngineB(g_micro, g_mtf, g_stats);
   SSignalCandidate cand_c = g_scorer.EvaluateEngineC(g_micro, g_mtf, g_stats);

   if(eng == ENGINE_A_HYPER_SCALP)
   {
      if(cand_b.valid) g_shadow.OpenShadowCandidate(cand_b, g_micro, bar_m5);
      if(cand_c.valid) g_shadow.OpenShadowCandidate(cand_c, g_micro, bar_m5);
   }
   else if(eng == ENGINE_B_MACRO_SWING)
   {
      if(cand_a.valid) g_shadow.OpenShadowCandidate(cand_a, g_micro, bar_m1);
      if(cand_c.valid) g_shadow.OpenShadowCandidate(cand_c, g_micro, bar_m5);
   }
   else
   {
      if(cand_a.valid) g_shadow.OpenShadowCandidate(cand_a, g_micro, bar_m1);
      if(cand_b.valid) g_shadow.OpenShadowCandidate(cand_b, g_micro, bar_m5);
   }

   SSignalCandidate active_cand;
   active_cand.Reset();
   if(eng == ENGINE_C_CRASH_RECOV)
   {
      if(cand_c.valid) active_cand.CopyFrom(cand_c);
      else if(cand_b.valid) active_cand.CopyFrom(cand_b); // Fallback to Engine B so recovery never starves
   }
   else if(eng == ENGINE_B_MACRO_SWING)
   {
      if(cand_b.valid) active_cand.CopyFrom(cand_b);
      else if(cand_c.valid) active_cand.CopyFrom(cand_c); // Fallback to Engine C wave surf
   }
   else
   {
      active_cand.CopyFrom(cand_a);
   }

   datetime active_bar = (eng == ENGINE_A_HYPER_SCALP) ? bar_m1 : bar_m5;

   string wait_msg = "";
   if(!g_exec.CanOpenNewPosition(eng, active_bar, now, wait_msg))
   {
      g_cfg.SetStatus(wait_msg, false);
      g_panel.Update(g_micro, g_mtf, g_risk, g_stats, g_shadow, g_exec);
      return;
   }

   if(!active_cand.valid)
   {
      g_cfg.SetStatus(eng == ENGINE_C_CRASH_RECOV ? "ENG-C2 WAVE RECOVERY SCANNING..." : (eng == ENGINE_B_MACRO_SWING ? "ENG-B MACRO SCANNING..." : "ENG-A SCALP SCANNING..."), false);
      g_panel.Update(g_micro, g_mtf, g_risk, g_stats, g_shadow, g_exec);
      return;
   }

   double sl_dist_price  = MathAbs(active_cand.entry_price - active_cand.sl_price);
   double strat_mult     = g_stats.GetAdaptiveMultiplier(active_cand.strategy);
   ENUM_ORDER_TYPE otype = (active_cand.direction > 0) ? ORDER_TYPE_BUY : ORDER_TYPE_SELL;
   double total_risk     = 0.0;
   string lot_reject     = "";

   double total_lots = g_risk.ComputeValidatedTotalLots(sl_dist_price, strat_mult, otype, active_cand.entry_price, total_risk, lot_reject);
   if(total_lots <= 0.0)
   {
      g_cfg.SetStatus("LOT REJECTED: " + lot_reject, true);
      g_panel.Update(g_micro, g_mtf, g_risk, g_stats, g_shadow, g_exec);
      return;
   }

   g_exec.ExecuteCandidate(active_cand, total_lots, total_risk, active_bar);
   g_panel.Update(g_micro, g_mtf, g_risk, g_stats, g_shadow, g_exec);
}

void OnTradeTransaction(const MqlTradeTransaction &trans, const MqlTradeRequest &request, const MqlTradeResult &result)
{
   if(trans.type != TRADE_TRANSACTION_DEAL_ADD) return;
   ulong deal_ticket = trans.deal;
   if(deal_ticket == 0 || !HistoryDealSelect(deal_ticket)) return;

   if(HistoryDealGetInteger(deal_ticket, DEAL_MAGIC) != (long)InpMagicNumber) return;
   if(HistoryDealGetString(deal_ticket, DEAL_SYMBOL) != _Symbol) return;

   long   entry_type = HistoryDealGetInteger(deal_ticket, DEAL_ENTRY);
   double deal_price = HistoryDealGetDouble(deal_ticket, DEAL_PRICE);
   double deal_vol   = HistoryDealGetDouble(deal_ticket, DEAL_VOLUME);
   double deal_comm  = MathAbs(HistoryDealGetDouble(deal_ticket, DEAL_COMMISSION));
   ulong  pos_id     = (ulong)HistoryDealGetInteger(deal_ticket, DEAL_POSITION_ID);
   double point      = SymbolInfoDouble(_Symbol, SYMBOL_POINT);

   if(deal_vol > 0.0 && deal_comm > 0.0)
   {
      double rt_comm_est = (deal_comm / deal_vol) * 2.0;
      g_micro.RecordRealizedRoundTurnCommission(rt_comm_est);
   }

   if(entry_type == DEAL_ENTRY_IN)
   {
      if(g_exec.last_requested_price > 0.0 && point > 0.0)
      {
         double slip_pts = MathAbs(deal_price - g_exec.last_requested_price) / point;
         g_micro.RecordRealizedSlippage(slip_pts);
      }
   }
   else if(entry_type == DEAL_ENTRY_OUT || entry_type == DEAL_ENTRY_OUT_BY)
   {
      string comment = HistoryDealGetString(deal_ticket, DEAL_COMMENT);
      ENUM_STRATEGY_ID sid = g_stats.ResolveStrategyForPosition(pos_id, comment);

      SPositionMeta meta;
      bool has_meta = g_pos_reg.GetMeta(pos_id, meta);

      if(sid < STRAT_COUNT)
      {
         double net_pnl = HistoryDealGetDouble(deal_ticket, DEAL_PROFIT)
                        + HistoryDealGetDouble(deal_ticket, DEAL_SWAP)
                        + HistoryDealGetDouble(deal_ticket, DEAL_COMMISSION);

         double ref_risk   = (has_meta && meta.initial_risk_money > 0.0) ? meta.initial_risk_money : MathMax(1.0, AccountInfoDouble(ACCOUNT_EQUITY) * (g_risk.GetEffectiveRiskPct() / 100.0));
         double realized_r = net_pnl / ref_risk;

         g_stats.RecordTradeResult(sid, net_pnl, realized_r, TimeCurrent(), true);
         g_panel.Update(g_micro, g_mtf, g_risk, g_stats, g_shadow, g_exec);
      }

      bool still_open = false;
      for(int i = PositionsTotal() - 1; i >= 0; i--)
      {
         ulong pt = PositionGetTicket(i);
         if(pt > 0 && (ulong)PositionGetInteger(POSITION_IDENTIFIER) == pos_id) { still_open = true; break; }
      }
      if(!still_open) g_pos_reg.Remove(pos_id);
   }
}

double OnTester()
{
   double net_profit = TesterStatistics(STAT_PROFIT);
   double max_dd_pct = TesterStatistics(STAT_EQUITY_DDREL_PERCENT);
   double pf         = TesterStatistics(STAT_PROFIT_FACTOR);
   double trades     = TesterStatistics(STAT_TRADES);

   if(net_profit <= 0.0 || trades < 250.0 || max_dd_pct >= 40.0) return 0.0;
   double initial_dep = TesterStatistics(STAT_INITIAL_DEPOSIT);
   if(initial_dep <= 0.0) return 0.0;

   double return_pct   = (net_profit / initial_dep) * 100.0;
   double calmar_proxy = return_pct / MathMax(1.0, max_dd_pct);
   double trade_factor = MathSqrt(MathMin(trades, 10000.0));
   return calmar_proxy * MathMin(pf, 3.5) * trade_factor;
}
