   if(StringFind(comment, "|A2") >= 0) return STRAT_A2_MEAN_REV;
   if(StringFind(comment, "|A3") >= 0) return STRAT_A3_VOL_EXPL;
   if(StringFind(comment, "|A4") >= 0) return STRAT_A4_TREND_IMP;
   if(StringFind(comment, "|B0") >= 0) return STRAT_B0_M15_BREAKOUT;
   if(StringFind(comment, "|B1") >= 0) return STRAT_B1_M15_EXHAUST;
   if(StringFind(comment, "|B2") >= 0) return STRAT_B2_H1_PULLBACK;
   if(StringFind(comment, "|C0") >= 0) return STRAT_C0_VOL_SPIKE_REV;
   if(StringFind(comment, "|C1") >= 0) return STRAT_C1_GRID_RECOV;
   if(StringFind(comment, "|C2") >= 0) return STRAT_C2_POST_ATH_SURF;
