struct SRuntimeConfig
{
   ENUM_RISK_MODE risk_mode;
   double         risk_pct;
   double         max_daily_loss_pct;
   double         max_equity_dd_pct;
   double         max_cum_risk_pct;
   int            max_pos_symbol;
   int            max_pos_account;

   int            tick_window;
   double         min_tick_velocity;
   double         min_expectancy_r;
   double         base_slippage_pts;
   double         max_spread_pts;
   double         max_spread_atr_ratio;

   double         sl_atr_mult;
   double         tp_atr_mult;
   double         partial_close_rr;
   double         partial_close_pct;
   double         trail_act_rr;
   double         trail_step_atr;
   int            max_hold_sec;
   int            reentry_cooldown_sec;

   int            rolling_window_trades;
   int            min_trades_adapt;
   double         suspend_exp_floor;
   int            suspend_cooldown_min;
   ulong          slippage_dev;

   bool           strat_enabled[STRAT_COUNT];
   bool           trading_paused;
   string         status_text;
   bool           status_is_alert;

   void SetStatus(const string msg, bool is_alert = false)
   {
      status_text     = msg;
      status_is_alert = is_alert;
   }

   void ApplyPreset(ENUM_RISK_MODE mode, bool apply_input_overrides = false)
   {
      risk_mode = mode;

      if(mode == RISK_MODE_AGGRESSIVE)
      {
         risk_pct              = 0.85;
         max_daily_loss_pct    = 4.0;
         max_equity_dd_pct     = 20.0;
         max_cum_risk_pct      = 3.5;
         max_pos_symbol        = 2;
         max_pos_account       = 4;
         tick_window           = 28;
         min_tick_velocity     = 0.45;
         min_expectancy_r      = 0.08;
         base_slippage_pts     = 2.0;
         max_spread_pts        = InpMaxSpreadPoints; // 0 = Auto ATR-scaled
         max_spread_atr_ratio  = 0.38;
         sl_atr_mult           = 1.60;
         tp_atr_mult           = 2.45;
         partial_close_rr      = 1.00;
         partial_close_pct     = 50.0;
         trail_act_rr          = 0.85;
         trail_step_atr        = 0.45;
         max_hold_sec          = 1200;
         reentry_cooldown_sec  = 25;
         rolling_window_trades = 25;
         min_trades_adapt      = 8;
         suspend_exp_floor     = -0.25;
         suspend_cooldown_min  = 45;
         slippage_dev          = 25;
      }
      else if(mode == RISK_MODE_SUPER_AGGRESSIVE)
      {
         risk_pct              = 1.65;
         max_daily_loss_pct    = 6.0;
         max_equity_dd_pct     = 25.0;
         max_cum_risk_pct      = 5.5;
         max_pos_symbol        = 2;
         max_pos_account       = 5;
         tick_window           = 24;
         min_tick_velocity     = 0.35;
         min_expectancy_r      = 0.06;
         base_slippage_pts     = 2.0;
         max_spread_pts        = InpMaxSpreadPoints; // 0 = Auto ATR-scaled
         max_spread_atr_ratio  = 0.45;
         sl_atr_mult           = 1.50;
         tp_atr_mult           = 2.30;
         partial_close_rr      = 0.95;
         partial_close_pct     = 50.0;
         trail_act_rr          = 0.80;
         trail_step_atr        = 0.42;
         max_hold_sec          = 1080;
         reentry_cooldown_sec  = 15;
         rolling_window_trades = 25;
         min_trades_adapt      = 8;
         suspend_exp_floor     = -0.30;
         suspend_cooldown_min  = 30;
         slippage_dev          = 30;
      }
      else // RISK_MODE_EXTREME_RESEARCH
      {
         risk_pct              = 2.75;
         max_daily_loss_pct    = 8.0;
         max_equity_dd_pct     = 30.0;
         max_cum_risk_pct      = 8.0;
         max_pos_symbol        = 3;
         max_pos_account       = 6;
         tick_window           = 20;
         min_tick_velocity     = 0.25;
         min_expectancy_r      = 0.04;
         base_slippage_pts     = 2.5;
         max_spread_pts        = InpMaxSpreadPoints; // 0 = Auto ATR-scaled
         max_spread_atr_ratio  = 0.55;
         sl_atr_mult           = 1.40;
         tp_atr_mult           = 2.25;
         partial_close_rr      = 0.90;
         partial_close_pct     = 45.0;
         trail_act_rr          = 0.75;
         trail_step_atr        = 0.40;
         max_hold_sec          = 900;
         reentry_cooldown_sec  = 10;
         rolling_window_trades = 20;
         min_trades_adapt      = 6;
         suspend_exp_floor     = -0.35;
         suspend_cooldown_min  = 20;
         slippage_dev          = 35;
      }

      if(apply_input_overrides)
      {
         if(InpCustomRiskPct > 0.0)           risk_pct           = MathMin(InpCustomRiskPct, 5.0);
         if(InpMaxDailyLossPct > 0.0)         max_daily_loss_pct = InpMaxDailyLossPct;
         if(InpMaxEquityDDPct > 0.0)          max_equity_dd_pct  = InpMaxEquityDDPct;
         if(InpMaxCumulativeRiskPct > 0.0)    max_cum_risk_pct   = InpMaxCumulativeRiskPct;
         if(InpMaxOpenPositionsSymbol > 0)    max_pos_symbol     = InpMaxOpenPositionsSymbol;
         if(InpMaxOpenPositionsAccount > 0)   max_pos_account    = InpMaxOpenPositionsAccount;
      }
   }

   void InitFromInputs(ulong magic, const string symbol)
   {
      strat_enabled[STRAT_ULTRA_MOMENTUM]  = InpEnableStratA_Momentum;
      strat_enabled[STRAT_LIQUIDITY_SWEEP] = InpEnableStratB_LiqSweep;
      strat_enabled[STRAT_MEAN_REVERSION]  = InpEnableStratC_MeanRev;
      strat_enabled[STRAT_VOL_EXPLOSION]   = InpEnableStratD_VolExpl;
      strat_enabled[STRAT_TREND_IMPULSE]   = InpEnableStratE_TrendImp;
      trading_paused                       = false;
      SetStatus("INITIALIZING ENGINE...", false);

      string gv_mode = StringFormat("MVX2_MODE_%I64u_%s", magic, symbol);
      if(!MQLInfoInteger(MQL_TESTER) && GlobalVariableCheck(gv_mode))
      {
         int saved = (int)GlobalVariableGet(gv_mode);
         if(saved >= 0 && saved <= 2)
         {
            ApplyPreset((ENUM_RISK_MODE)saved, false);
            return;
         }
      }
      ApplyPreset(InpRiskMode, true);
   }

   void SaveModeState(ulong magic, const string symbol) const
   {
      if(MQLInfoInteger(MQL_TESTER)) return;
      string gv_mode = StringFormat("MVX2_MODE_%I64u_%s", magic, symbol);
      GlobalVariableSet(gv_mode, (double)risk_mode);
   }
};

