//+------------------------------------------------------------------+
//| Dynamic Lot & Pip Precision Helpers (Supports 0.001 & 0.01 Lots) |
//+------------------------------------------------------------------+
int GetLotDigits(const string symbol)
{
   double step = SymbolInfoDouble(symbol, SYMBOL_VOLUME_STEP);
   if(step <= 0.0) return 2;
   int digits = 0;
   while(step < 1.0 - 1e-9 && digits < 6)
   {
      step *= 10.0;
      digits++;
   }
   return digits;
}

double NormalizeLot(const string symbol, double lots)
{
   double min_lot  = SymbolInfoDouble(symbol, SYMBOL_VOLUME_MIN);
   double max_lot  = SymbolInfoDouble(symbol, SYMBOL_VOLUME_MAX);
   double lot_step = SymbolInfoDouble(symbol, SYMBOL_VOLUME_STEP);
   int    lot_digs = GetLotDigits(symbol);

   if(lot_step <= 0.0) lot_step = 0.01;
   if(lots < min_lot)  return 0.0;
   if(max_lot > 0.0 && lots > max_lot) lots = max_lot;

   double steps = MathFloor((lots + 1e-11) / lot_step);
   return NormalizeDouble(steps * lot_step, lot_digs);
}

double GetPipScale(const string symbol)
{
   int digits = (int)SymbolInfoInteger(symbol, SYMBOL_DIGITS);
   if(digits == 3 || digits == 5) return 10.0;
   return 1.0;
}

