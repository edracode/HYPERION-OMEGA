double NormalizePriceToTick(const string symbol, double price)
{
   double tick_size = SymbolInfoDouble(symbol, SYMBOL_TRADE_TICK_SIZE);
   int    digits    = (int)SymbolInfoInteger(symbol, SYMBOL_DIGITS);
   if(tick_size <= 0.0)
      return NormalizeDouble(price, digits);
   double steps = MathRound(price / tick_size);
   return NormalizeDouble(steps * tick_size, digits);
}

//+------------------------------------------------------------------+
//| 1. Microstructure & Realized Cost Engine                         |
//+------------------------------------------------------------------+
class CMicrostructureEngine
{
private:
   STickSample m_ring[TICK_BUFFER_CAPACITY];
   int         m_count;
   int         m_head;
   double      m_spread_ema;
   double      m_spread_var_ema;
   double      m_realized_slippage_pts;
   double      m_realized_comm_per_lot;
   bool        m_has_real_comm_sample;

public:
   double tick_velocity;
   double price_velocity_pts;
   double price_accel_pts;
   double tick_imbalance;
   double current_spread_pts;
   double spread_zscore;
   double estimated_slippage_pts;

   void Init(double initial_slippage_pts)
   {
      m_count                 = 0;
      m_head                  = 0;
      m_spread_ema            = 0.0;
      m_spread_var_ema        = 1.0;
      m_realized_slippage_pts = MathMax(0.0, initial_slippage_pts);
      m_realized_comm_per_lot = MathMax(0.0, InpCommissionPerLot);
      m_has_real_comm_sample  = (InpCommissionPerLot > 0.0);

      tick_velocity           = 0.0;
      price_velocity_pts      = 0.0;
      price_accel_pts         = 0.0;
      tick_imbalance          = 0.0;
      current_spread_pts      = 0.0;
      spread_zscore           = 0.0;
      estimated_slippage_pts  = m_realized_slippage_pts;
   }

   void SetBaselineSlippage(double base_slip_pts)
   {
      m_realized_slippage_pts = MathMax(0.0, base_slip_pts);
      estimated_slippage_pts  = m_realized_slippage_pts;
   }

   void RecordRealizedSlippage(double slip_pts)
   {
      if(slip_pts < 0.0) slip_pts = 0.0;
      if(slip_pts > 300.0) slip_pts = 300.0;
      m_realized_slippage_pts = 0.85 * m_realized_slippage_pts + 0.15 * slip_pts;
      estimated_slippage_pts  = m_realized_slippage_pts;
   }

   void RecordRealizedRoundTurnCommission(double round_turn_comm_per_lot)
   {
      if(InpCommissionPerLot > 0.0) return;
      if(round_turn_comm_per_lot < 0.0) round_turn_comm_per_lot = 0.0;
      if(!m_has_real_comm_sample)
      {
         m_realized_comm_per_lot = round_turn_comm_per_lot;
         m_has_real_comm_sample  = true;
      }
      else
      {
         m_realized_comm_per_lot = 0.80 * m_realized_comm_per_lot + 0.20 * round_turn_comm_per_lot;
      }
   }

   double GetEffectiveCommissionPerLot() const
   {
      return (InpCommissionPerLot > 0.0) ? InpCommissionPerLot : m_realized_comm_per_lot;
   }

   void OnNewTick(const MqlTick &tick, double point)
   {
      if(point <= 0.0 || tick.bid <= 0.0 || tick.ask <= 0.0)
         return;

      double mid        = 0.5 * (tick.bid + tick.ask);
      double spread_pts = (tick.ask - tick.bid) / point;
      ulong  now_msc    = (tick.time_msc > 0) ? (ulong)tick.time_msc : (ulong)(tick.time * 1000);

      int dir = 0;
      if(m_count > 0)
      {
         int prev_idx = (m_head - 1 + TICK_BUFFER_CAPACITY) % TICK_BUFFER_CAPACITY;
         if(mid > m_ring[prev_idx].mid)      dir = 1;
         else if(mid < m_ring[prev_idx].mid) dir = -1;
      }

      m_ring[m_head].bid        = tick.bid;
      m_ring[m_head].ask        = tick.ask;
      m_ring[m_head].mid        = mid;
      m_ring[m_head].spread_pts = spread_pts;
      m_ring[m_head].time_msc   = now_msc;
      m_ring[m_head].dir        = dir;

      m_head = (m_head + 1) % TICK_BUFFER_CAPACITY;
      if(m_count < TICK_BUFFER_CAPACITY)
         m_count++;

      current_spread_pts = spread_pts;
      if(m_spread_ema <= 0.0)
      {
         m_spread_ema     = spread_pts;
         m_spread_var_ema = MathMax(1.0, spread_pts * 0.1);
      }
      else
      {
         double diff      = spread_pts - m_spread_ema;
         m_spread_ema     = 0.96 * m_spread_ema + 0.04 * spread_pts;
         m_spread_var_ema = 0.96 * m_spread_var_ema + 0.04 * (diff * diff);
      }
      double std_spread = MathSqrt(MathMax(m_spread_var_ema, 1.0));
      spread_zscore     = (spread_pts - m_spread_ema) / std_spread;

      ComputeMetrics(point);
   }

   bool IsReady() const { return (m_count >= 5); }

private:
   void ComputeMetrics(double point)
   {
      int win = MathMin(m_count, MathMax(5, MathMin(g_cfg.tick_window, TICK_BUFFER_CAPACITY)));
      if(win < 4) return;

      int newest_idx = (m_head - 1 + TICK_BUFFER_CAPACITY) % TICK_BUFFER_CAPACITY;
      int oldest_idx = (m_head - win + TICK_BUFFER_CAPACITY) % TICK_BUFFER_CAPACITY;
      int mid_idx    = (m_head - (win / 2) + TICK_BUFFER_CAPACITY) % TICK_BUFFER_CAPACITY;

      double dt_total_sec = 0.0;
      if(m_ring[newest_idx].time_msc >= m_ring[oldest_idx].time_msc)
         dt_total_sec = (double)(m_ring[newest_idx].time_msc - m_ring[oldest_idx].time_msc) / 1000.0;
      if(dt_total_sec < 0.25) dt_total_sec = 0.25;

      double dt_first_sec = 0.0;
      if(m_ring[mid_idx].time_msc >= m_ring[oldest_idx].time_msc)
         dt_first_sec = (double)(m_ring[mid_idx].time_msc - m_ring[oldest_idx].time_msc) / 1000.0;
      if(dt_first_sec < 0.125) dt_first_sec = 0.125;

      double dt_second_sec = 0.0;
      if(m_ring[newest_idx].time_msc >= m_ring[mid_idx].time_msc)
         dt_second_sec = (double)(m_ring[newest_idx].time_msc - m_ring[mid_idx].time_msc) / 1000.0;
      if(dt_second_sec < 0.125) dt_second_sec = 0.125;

      tick_velocity      = (double)(win - 1) / dt_total_sec;
      double dp_total    = (m_ring[newest_idx].mid - m_ring[oldest_idx].mid) / point;
      price_velocity_pts = dp_total / dt_total_sec;

      double vel_1 = ((m_ring[mid_idx].mid - m_ring[oldest_idx].mid) / point) / dt_first_sec;
      double vel_2 = ((m_ring[newest_idx].mid - m_ring[mid_idx].mid) / point) / dt_second_sec;
      price_accel_pts = (vel_2 - vel_1) / (0.5 * dt_total_sec);

      int up_ticks = 0, down_ticks = 0;
      for(int i = 0; i < win; i++)
      {
         int idx = (m_head - 1 - i + TICK_BUFFER_CAPACITY) % TICK_BUFFER_CAPACITY;
         if(m_ring[idx].dir > 0)      up_ticks++;
         else if(m_ring[idx].dir < 0) down_ticks++;
      }
      int directional_ticks = up_ticks + down_ticks;
      tick_imbalance = (directional_ticks > 0) ? ((double)(up_ticks - down_ticks) / (double)directional_ticks) : 0.0;
   }
};

//+------------------------------------------------------------------+
//| 2. Multi-Timeframe Context Engine                                |
//+------------------------------------------------------------------+
class CMTFContextEngine
{
private:
   string   m_symbol;
   int      m_h_ema_fast_m1;
   int      m_h_ema_slow_m1;
   int      m_h_atr_m1;
   int      m_h_rsi_m1;
   int      m_h_bb_m1;

   int      m_h_ema_fast_m5;
   int      m_h_atr_m5;
   int      m_h_adx_m5;

   int      m_h_atr_m15;
   int      m_h_rsi_m15;
   int      m_h_bb_m15;

   int      m_h_ema_fast_h1;
   int      m_h_ema_slow_h1;
   int      m_h_adx_h1;

   datetime m_last_bar_m1;
   datetime m_last_bar_m5;
   datetime m_last_bar_m15;
   datetime m_last_bar_h1;

public:
   double m1_ema_fast[3];
   double m1_ema_slow[3];
   double m1_atr[3];
   double m1_rsi[3];
   double m1_bb_upper[3];
   double m1_bb_mid[3];
   double m1_bb_lower[3];
   double m1_open[4];
   double m1_high[4];
   double m1_low[4];
   double m1_close[4];
   double m1_autocorr_lag1;

   double m5_ema_fast[2];
   double m5_atr[2];
   double m5_adx[2];
   double m5_atr_avg;
   double m5_donchian_high;
   double m5_donchian_low;

   double m15_swing_high;
   double m15_swing_low;
   double m15_atr[4];
   double m15_rsi[2];
   double m15_bb_upper[2];
   double m15_bb_mid[2];
   double m15_bb_lower[2];
   double m15_open[2];
   double m15_high[2];
   double m15_low[2];
   double m15_close[2];

   double h1_ema_fast[2];
   double h1_ema_slow[2];
   double h1_adx[2];
   int    h1_trend_dir;

   ENUM_MARKET_REGIME current_regime;
   double             seasonality_score;

   bool Init(const string symbol)
   {
      m_symbol       = symbol;
      m_last_bar_m1  = 0;
      m_last_bar_m5  = 0;
      m_last_bar_m15 = 0;
      m_last_bar_h1  = 0;

      m_h_ema_fast_m1 = iMA(m_symbol, PERIOD_M1, InpM1_FastEMA, 0, MODE_EMA, PRICE_CLOSE);
      m_h_ema_slow_m1 = iMA(m_symbol, PERIOD_M1, InpM1_SlowEMA, 0, MODE_EMA, PRICE_CLOSE);
      m_h_atr_m1      = iATR(m_symbol, PERIOD_M1, InpM1_ATR_Period);
      m_h_rsi_m1      = iRSI(m_symbol, PERIOD_M1, InpM1_RSI_Period, PRICE_CLOSE);
      m_h_bb_m1       = iBands(m_symbol, PERIOD_M1, InpM1_BB_Period, 0, InpM1_BB_Deviation, PRICE_CLOSE);

      m_h_ema_fast_m5 = iMA(m_symbol, PERIOD_M5, 13, 0, MODE_EMA, PRICE_CLOSE);
      m_h_atr_m5      = iATR(m_symbol, PERIOD_M5, InpM5_ATR_Period);
      m_h_adx_m5      = iADX(m_symbol, PERIOD_M5, InpM5_ADX_Period);

      m_h_atr_m15     = iATR(m_symbol, PERIOD_M15, 14);
      m_h_rsi_m15     = iRSI(m_symbol, PERIOD_M15, 14, PRICE_CLOSE);
      m_h_bb_m15      = iBands(m_symbol, PERIOD_M15, 20, 0, 2.20, PRICE_CLOSE);

      m_h_ema_fast_h1 = iMA(m_symbol, PERIOD_H1, InpH1_FastEMA, 0, MODE_EMA, PRICE_CLOSE);
      m_h_ema_slow_h1 = iMA(m_symbol, PERIOD_H1, InpH1_SlowEMA, 0, MODE_EMA, PRICE_CLOSE);
      m_h_adx_h1      = iADX(m_symbol, PERIOD_H1, InpH1_ADX_Period);

      if(m_h_ema_fast_m1 == INVALID_HANDLE || m_h_ema_slow_m1 == INVALID_HANDLE ||
         m_h_atr_m1      == INVALID_HANDLE || m_h_rsi_m1      == INVALID_HANDLE ||
         m_h_bb_m1       == INVALID_HANDLE || m_h_ema_fast_m5 == INVALID_HANDLE ||
         m_h_atr_m5      == INVALID_HANDLE || m_h_adx_m5      == INVALID_HANDLE ||
         m_h_atr_m15     == INVALID_HANDLE || m_h_rsi_m15     == INVALID_HANDLE ||
         m_h_bb_m15      == INVALID_HANDLE || m_h_ema_fast_h1 == INVALID_HANDLE ||
         m_h_ema_slow_h1 == INVALID_HANDLE || m_h_adx_h1      == INVALID_HANDLE)
         return false;

      ArrayInitialize(m1_atr, 0.0);
      ArrayInitialize(m5_atr, 0.0);
      ArrayInitialize(m15_atr, 0.0);
      current_regime    = REGIME_TRENDING_NORMAL;
      seasonality_score = 1.0;
      m1_autocorr_lag1  = 0.0;
      h1_trend_dir      = 0;
      return true;
   }

   void Release()
   {
      if(m_h_ema_fast_m1 != INVALID_HANDLE) IndicatorRelease(m_h_ema_fast_m1);
      if(m_h_ema_slow_m1 != INVALID_HANDLE) IndicatorRelease(m_h_ema_slow_m1);
      if(m_h_atr_m1      != INVALID_HANDLE) IndicatorRelease(m_h_atr_m1);
      if(m_h_rsi_m1      != INVALID_HANDLE) IndicatorRelease(m_h_rsi_m1);
      if(m_h_bb_m1       != INVALID_HANDLE) IndicatorRelease(m_h_bb_m1);
      if(m_h_ema_fast_m5 != INVALID_HANDLE) IndicatorRelease(m_h_ema_fast_m5);
      if(m_h_atr_m5      != INVALID_HANDLE) IndicatorRelease(m_h_atr_m5);
      if(m_h_adx_m5      != INVALID_HANDLE) IndicatorRelease(m_h_adx_m5);
      if(m_h_atr_m15     != INVALID_HANDLE) IndicatorRelease(m_h_atr_m15);
      if(m_h_rsi_m15     != INVALID_HANDLE) IndicatorRelease(m_h_rsi_m15);
      if(m_h_bb_m15      != INVALID_HANDLE) IndicatorRelease(m_h_bb_m15);
      if(m_h_ema_fast_h1 != INVALID_HANDLE) IndicatorRelease(m_h_ema_fast_h1);
      if(m_h_ema_slow_h1 != INVALID_HANDLE) IndicatorRelease(m_h_ema_slow_h1);
      if(m_h_adx_h1      != INVALID_HANDLE) IndicatorRelease(m_h_adx_h1);
   }

   bool Update(bool is_post_ath_recovery = false)
   {
      if(BarsCalculated(m_h_bb_m1) < InpM1_BB_Period + 5 ||
         BarsCalculated(m_h_atr_m1) < InpM1_ATR_Period + 5)
         return false;

      datetime bar_h1  = iTime(m_symbol, PERIOD_H1, 0);
      datetime bar_m15 = iTime(m_symbol, PERIOD_M15, 0);
      datetime bar_m5  = iTime(m_symbol, PERIOD_M5, 0);
      datetime bar_m1  = iTime(m_symbol, PERIOD_M1, 0);

      if(bar_h1 != m_last_bar_h1 && bar_h1 > 0)
         if(UpdateH1()) m_last_bar_h1 = bar_h1;

      if(bar_m15 != m_last_bar_m15 && bar_m15 > 0)
         if(UpdateM15()) m_last_bar_m15 = bar_m15;

      if(bar_m5 != m_last_bar_m5 && bar_m5 > 0)
         if(UpdateM5()) m_last_bar_m5 = bar_m5;

      if(bar_m1 != m_last_bar_m1 && bar_m1 > 0)
      {
         if(UpdateM1())
         {
            m_last_bar_m1 = bar_m1;
            ClassifyRegime(is_post_ath_recovery);
         }
      }

      return (m_last_bar_m1 > 0 && m_last_bar_m5 > 0 && m_last_bar_m15 > 0);
   }

private:
   bool UpdateH1()
   {
      double buf[2];
      if(CopyBuffer(m_h_ema_fast_h1, 0, 1, 2, buf) < 2) return false;
      h1_ema_fast[0] = buf[1]; h1_ema_fast[1] = buf[0];

      if(CopyBuffer(m_h_ema_slow_h1, 0, 1, 2, buf) < 2)
      {
         h1_ema_slow[0] = h1_ema_fast[1];
         h1_ema_slow[1] = h1_ema_fast[1];
      }
      else
      {
         h1_ema_slow[0] = buf[1]; h1_ema_slow[1] = buf[0];
      }

      if(CopyBuffer(m_h_adx_h1, 0, 1, 2, buf) < 2) return false;
      h1_adx[0] = buf[1]; h1_adx[1] = buf[0];

      if(h1_ema_fast[0] > h1_ema_slow[0]) h1_trend_dir = 1;
      else if(h1_ema_fast[0] < h1_ema_slow[0]) h1_trend_dir = -1;
      else h1_trend_dir = 0;

      MqlDateTime dt;
      TimeCurrent(dt);
      if((dt.hour >= 8 && dt.hour <= 11) || (dt.hour >= 13 && dt.hour <= 18))
         seasonality_score = 1.18;
      else if(dt.hour >= 19 && dt.hour <= 21)
         seasonality_score = 1.02;
      else
         seasonality_score = 0.92;

      return true;
   }

   bool UpdateM15()
   {
      int lookback = MathMax(5, InpM15_SwingLookback);
      int hi_idx   = iHighest(m_symbol, PERIOD_M15, MODE_HIGH, lookback, 1);
      int lo_idx   = iLowest(m_symbol, PERIOD_M15, MODE_LOW, lookback, 1);
      if(hi_idx < 0 || lo_idx < 0) return false;

      m15_swing_high = iHigh(m_symbol, PERIOD_M15, hi_idx);
      m15_swing_low  = iLow(m_symbol, PERIOD_M15, lo_idx);

      double abuf[4];
      if(CopyBuffer(m_h_atr_m15, 0, 1, 4, abuf) < 4) return false;
      m15_atr[0] = abuf[3]; m15_atr[1] = abuf[2]; m15_atr[2] = abuf[1]; m15_atr[3] = abuf[0];

      double buf2[2];
      if(CopyBuffer(m_h_rsi_m15, 0, 1, 2, buf2) < 2) return false;
      m15_rsi[0] = buf2[1]; m15_rsi[1] = buf2[0];

      if(CopyBuffer(m_h_bb_m15, 0, 1, 2, buf2) < 2) return false;
      m15_bb_mid[0] = buf2[1]; m15_bb_mid[1] = buf2[0];

      if(CopyBuffer(m_h_bb_m15, 1, 1, 2, buf2) < 2) return false;
      m15_bb_upper[0] = buf2[1]; m15_bb_upper[1] = buf2[0];

      if(CopyBuffer(m_h_bb_m15, 2, 1, 2, buf2) < 2) return false;
      m15_bb_lower[0] = buf2[1]; m15_bb_lower[1] = buf2[0];

      MqlRates r15[2];
      if(CopyRates(m_symbol, PERIOD_M15, 1, 2, r15) < 2) return false;
      m15_open[0]  = r15[1].open;  m15_open[1]  = r15[0].open;
      m15_high[0]  = r15[1].high;  m15_high[1]  = r15[0].high;
      m15_low[0]   = r15[1].low;   m15_low[1]   = r15[0].low;
      m15_close[0] = r15[1].close; m15_close[1] = r15[0].close;

      return true;
   }

   bool UpdateM5()
   {
      double atr_arr[20];
      if(CopyBuffer(m_h_atr_m5, 0, 1, 20, atr_arr) < 20) return false;
      m5_atr[0] = atr_arr[19];
      m5_atr[1] = atr_arr[18];

      double sum = 0.0;
      for(int i = 0; i < 20; i++) sum += atr_arr[i];
      m5_atr_avg = sum / 20.0;

      double buf[2];
      if(CopyBuffer(m_h_adx_m5, 0, 1, 2, buf) < 2) return false;
      m5_adx[0] = buf[1]; m5_adx[1] = buf[0];

      if(CopyBuffer(m_h_ema_fast_m5, 0, 1, 2, buf) < 2) return false;
      m5_ema_fast[0] = buf[1]; m5_ema_fast[1] = buf[0];

      int hi5 = iHighest(m_symbol, PERIOD_M5, MODE_HIGH, 10, 1);
      int lo5 = iLowest(m_symbol, PERIOD_M5, MODE_LOW, 10, 1);
      if(hi5 >= 0 && lo5 >= 0)
      {
         m5_donchian_high = iHigh(m_symbol, PERIOD_M5, hi5);
         m5_donchian_low  = iLow(m_symbol, PERIOD_M5, lo5);
      }

      return true;
   }

   bool UpdateM1()
   {
      double buf3[3];
      if(CopyBuffer(m_h_ema_fast_m1, 0, 1, 3, buf3) < 3) return false;
      m1_ema_fast[0] = buf3[2]; m1_ema_fast[1] = buf3[1]; m1_ema_fast[2] = buf3[0];

      if(CopyBuffer(m_h_ema_slow_m1, 0, 1, 3, buf3) < 3) return false;
      m1_ema_slow[0] = buf3[2]; m1_ema_slow[1] = buf3[1]; m1_ema_slow[2] = buf3[0];

      if(CopyBuffer(m_h_atr_m1, 0, 1, 3, buf3) < 3) return false;
      m1_atr[0] = buf3[2]; m1_atr[1] = buf3[1]; m1_atr[2] = buf3[0];

      if(CopyBuffer(m_h_rsi_m1, 0, 1, 3, buf3) < 3) return false;
      m1_rsi[0] = buf3[2]; m1_rsi[1] = buf3[1]; m1_rsi[2] = buf3[0];

      if(CopyBuffer(m_h_bb_m1, 0, 1, 3, buf3) < 3) return false;
      m1_bb_mid[0] = buf3[2]; m1_bb_mid[1] = buf3[1]; m1_bb_mid[2] = buf3[0];

      if(CopyBuffer(m_h_bb_m1, 1, 1, 3, buf3) < 3) return false;
      m1_bb_upper[0] = buf3[2]; m1_bb_upper[1] = buf3[1]; m1_bb_upper[2] = buf3[0];

      if(CopyBuffer(m_h_bb_m1, 2, 1, 3, buf3) < 3) return false;
      m1_bb_lower[0] = buf3[2]; m1_bb_lower[1] = buf3[1]; m1_bb_lower[2] = buf3[0];

      MqlRates rates[32];
      if(CopyRates(m_symbol, PERIOD_M1, 1, 32, rates) < 32) return false;
      for(int k = 0; k < 4; k++)
      {
         int idx = 31 - k;
         m1_open[k]  = rates[idx].open;
         m1_high[k]  = rates[idx].high;
         m1_low[k]   = rates[idx].low;
         m1_close[k] = rates[idx].close;
      }

      double rets[31];
      double mean_r = 0.0;
      for(int i = 0; i < 31; i++)
      {
         rets[i] = (rates[i + 1].close - rates[i].close);
         mean_r += rets[i];
      }
      mean_r /= 31.0;

      double num = 0.0, den = 0.0;
      for(int i = 0; i < 31; i++)
      {
         double d = rets[i] - mean_r;
         den += d * d;
         if(i > 0)
            num += d * (rets[i - 1] - mean_r);
      }
      m1_autocorr_lag1 = (den > 1e-12) ? (num / den) : 0.0;

      return true;
   }

   void ClassifyRegime(bool is_post_ath_recovery)
   {
      if(is_post_ath_recovery)
      {
         current_regime = REGIME_POST_ATH_RECOVERY;
         return;
      }

      double vol_ratio = (m5_atr_avg > 0.0) ? (m5_atr[0] / m5_atr_avg) : 1.0;
      if(vol_ratio < 0.78 && m5_adx[0] < 20.0)
         current_regime = REGIME_COMPRESSION_BREAKOUT;
      else if(h1_adx[0] >= 22.0 && h1_trend_dir != 0)
         current_regime = (vol_ratio >= 1.15) ? REGIME_TRENDING_HIGH_VOL : REGIME_TRENDING_NORMAL;
      else
         current_regime = REGIME_RANGING_MEAN_REV;
   }
};

//+------------------------------------------------------------------+
//| 3. Per-Strategy Performance & Calibration Tracker                |
//+------------------------------------------------------------------+
class CAdaptiveStatsTracker
{
private:
   SStrategyStats m_stats[STRAT_COUNT];
   ulong          m_magic;
   string         m_symbol;

public:
   void Init(ulong magic, const string symbol)
   {
      m_magic  = magic;
      m_symbol = symbol;

      for(int i = 0; i < STRAT_COUNT; i++)
         m_stats[i].Reset();

      if(!MQLInfoInteger(MQL_TESTER))
         RecoverFromAccountHistory();
   }

   ENUM_STRATEGY_ID ResolveStrategyForPosition(ulong pos_id, const string fallback_comment) const
   {
      SPositionMeta meta;
      if(g_pos_reg.GetMeta(pos_id, meta))
         return meta.strategy;

      ENUM_STRATEGY_ID parsed = ParseStrategyFromComment(fallback_comment);
      if(parsed < STRAT_COUNT)
         return parsed;

      if(pos_id > 0 && HistorySelectByPosition(pos_id))
      {
         int deals = HistoryDealsTotal();
         for(int i = 0; i < deals; i++)
         {
            ulong dt = HistoryDealGetTicket(i);
            if(dt == 0) continue;
            if(HistoryDealGetInteger(dt, DEAL_ENTRY) == DEAL_ENTRY_IN)
            {
               string in_comment = HistoryDealGetString(dt, DEAL_COMMENT);
               ENUM_STRATEGY_ID sid = ParseStrategyFromComment(in_comment);
               if(sid < STRAT_COUNT) return sid;
            }
         }
      }
      return STRAT_COUNT;
   }

   void RecoverFromAccountHistory()
   {
      datetime from_time = TimeCurrent() - 14 * 86400;
      if(!HistorySelect(from_time, TimeCurrent()))
         return;

      int total_deals = HistoryDealsTotal();
      for(int i = 0; i < total_deals; i++)
      {
         ulong deal_ticket = HistoryDealGetTicket(i);
         if(deal_ticket == 0) continue;

         if(HistoryDealGetInteger(deal_ticket, DEAL_MAGIC) != (long)m_magic) continue;
         if(HistoryDealGetString(deal_ticket, DEAL_SYMBOL) != m_symbol) continue;

         long entry_type = HistoryDealGetInteger(deal_ticket, DEAL_ENTRY);
         if(entry_type != DEAL_ENTRY_OUT && entry_type != DEAL_ENTRY_OUT_BY) continue;

         ulong  pos_id  = (ulong)HistoryDealGetInteger(deal_ticket, DEAL_POSITION_ID);
         string comment = HistoryDealGetString(deal_ticket, DEAL_COMMENT);
         ENUM_STRATEGY_ID sid = ResolveStrategyForPosition(pos_id, comment);
         if(sid >= STRAT_COUNT) continue;

         double profit = HistoryDealGetDouble(deal_ticket, DEAL_PROFIT)
                       + HistoryDealGetDouble(deal_ticket, DEAL_SWAP)
                       + HistoryDealGetDouble(deal_ticket, DEAL_COMMISSION);

         datetime dtime = (datetime)HistoryDealGetInteger(deal_ticket, DEAL_TIME);
         double est_r   = (profit >= 0.0) ? 1.15 : -1.0;
         RecordTradeResult(sid, profit, est_r, dtime, false);
      }
   }

   void RecordTradeResult(ENUM_STRATEGY_ID sid, double net_profit, double realized_r,
                          datetime exit_time, bool allow_suspend)
   {
      if(sid < 0 || sid >= STRAT_COUNT) return;

      double clamped_r = MathMax(-2.5, MathMin(3.5, realized_r));

      m_stats[sid].total_trades++;
      m_stats[sid].net_profit += net_profit;
      m_stats[sid].last_exit_time = exit_time;

      int is_win = (net_profit > 0.0) ? 1 : 0;
      if(is_win == 1)
      {
         m_stats[sid].wins++;
         m_stats[sid].gross_profit += net_profit;
         m_stats[sid].consecutive_losses = 0;
      }
      else
      {
         m_stats[sid].losses++;
         m_stats[sid].gross_loss += MathAbs(net_profit);
         m_stats[sid].consecutive_losses++;
      }

      int win_len = MathMax(5, MathMin(g_cfg.rolling_window_trades, 100));
      int idx     = m_stats[sid].rolling_count % win_len;
      m_stats[sid].r_history[idx]   = clamped_r;
      m_stats[sid].win_history[idx] = is_win;
      m_stats[sid].rolling_count++;

      int    samples = MathMin(m_stats[sid].rolling_count, win_len);
      double sum_r   = 0.0;
      int    sum_w   = 0;
      for(int k = 0; k < samples; k++)
      {
         sum_r += m_stats[sid].r_history[k];
         sum_w += m_stats[sid].win_history[k];
      }
      m_stats[sid].rolling_expectancy_r = sum_r / (double)samples;
      m_stats[sid].rolling_win_rate     = (double)sum_w / (double)samples;

      if(InpUseAdaptiveSelfOpt && allow_suspend && samples >= g_cfg.min_trades_adapt)
      {
         if(m_stats[sid].rolling_expectancy_r < g_cfg.suspend_exp_floor ||
            m_stats[sid].consecutive_losses >= 5)
         {
            m_stats[sid].suspended     = true;
            m_stats[sid].suspend_until = exit_time + g_cfg.suspend_cooldown_min * 60;
         }
      }
   }

   bool IsStrategyAvailable(ENUM_STRATEGY_ID sid, datetime now)
   {
      if(sid < 0 || sid >= STRAT_COUNT) return false;
      if(!m_stats[sid].suspended) return true;

      if(now >= m_stats[sid].suspend_until)
      {
         m_stats[sid].suspended            = false;
         m_stats[sid].consecutive_losses   = 0;
         m_stats[sid].rolling_expectancy_r = 0.05;
         return true;
      }
      return false;
   }

   void ClearSuspension(ENUM_STRATEGY_ID sid)
   {
      if(sid < 0 || sid >= STRAT_COUNT) return;
      m_stats[sid].suspended          = false;
      m_stats[sid].consecutive_losses = 0;
      if(m_stats[sid].rolling_expectancy_r < 0.0)
         m_stats[sid].rolling_expectancy_r = 0.05;
   }

   void ResetAllSuspensions()
   {
      for(int i = 0; i < STRAT_COUNT; i++)
         ClearSuspension((ENUM_STRATEGY_ID)i);
   }

   double GetCalibratedWinProb(ENUM_STRATEGY_ID sid, double base_prior) const
   {
      if(!InpUseAdaptiveSelfOpt || m_stats[sid].rolling_count < g_cfg.min_trades_adapt)
         return base_prior;

      double weight_emp = MathMin(0.65, (double)m_stats[sid].rolling_count / (double)(g_cfg.rolling_window_trades * 1.25));
      double blended    = (1.0 - weight_emp) * base_prior + weight_emp * m_stats[sid].rolling_win_rate;
      return MathMax(0.38, MathMin(0.80, blended));
   }

   double GetAdaptiveMultiplier(ENUM_STRATEGY_ID sid) const
   {
      if(!InpUseAdaptiveSelfOpt || m_stats[sid].rolling_count < g_cfg.min_trades_adapt)
         return 1.00;

      double exp_r = m_stats[sid].rolling_expectancy_r;
      if(exp_r > 0.25)  return 1.25;
      if(exp_r > 0.08)  return 1.10;
      if(exp_r < -0.15) return 0.75;
      return 1.00;
   }

   bool   IsSuspended(ENUM_STRATEGY_ID sid) const   { return m_stats[sid].suspended; }
   int    GetTotalTrades(ENUM_STRATEGY_ID sid) const { return m_stats[sid].total_trades; }
   double GetNetProfit(ENUM_STRATEGY_ID sid) const   { return m_stats[sid].net_profit; }
   double GetRollingExpR(ENUM_STRATEGY_ID sid) const { return m_stats[sid].rolling_expectancy_r; }
};

