      double eq    = AccountInfoDouble(ACCOUNT_EQUITY);
      double bal   = AccountInfoDouble(ACCOUNT_BALANCE);
      double ath   = risk.GetATHEquity();
      double floor = risk.GetVaultFloor();
      SetText("VAL_EQ_BAL", StringFormat("Equity: $%.2f | Bal: $%.2f", eq, bal), C_TEXT_PRI);

      string eng_tag = risk.IsEngineCActive() ? StringFormat("ENG-C RECOV(%.2f%%)", risk.GetEffectiveRiskPct()) :
