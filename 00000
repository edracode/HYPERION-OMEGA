   bool OnClick(const string sparam,
                CMicrostructureEngine &micro,
                CAdaptiveStatsTracker &stats,
                CExecutionEngine &exec)
   {
      if(!m_enabled || StringFind(sparam, UI_PREFIX) != 0)
         return false;

      ObjectSetInteger(0, sparam, OBJPROP_STATE, false);

      if(sparam == UI_PREFIX + "BTN_MIN")
      {
         m_minimized = !m_minimized;
         BuildLayout();
         return true;
      }

      if(sparam == UI_PREFIX + "BTN_MODE_0")
      {
         g_cfg.ApplyPreset(RISK_MODE_AGGRESSIVE, false);
         g_cfg.SaveModeState(InpMagicNumber, _Symbol);
         micro.SetBaselineSlippage(g_cfg.base_slippage_pts);
         exec.RefreshConfig();
         g_cfg.SetStatus("MODE 1: AGGRESSIVE ACTIVATED", false);
         return true;
      }

      if(sparam == UI_PREFIX + "BTN_MODE_1")
      {
         g_cfg.ApplyPreset(RISK_MODE_SUPER_AGGRESSIVE, false);
         g_cfg.SaveModeState(InpMagicNumber, _Symbol);
         micro.SetBaselineSlippage(g_cfg.base_slippage_pts);
         exec.RefreshConfig();
         g_cfg.SetStatus("MODE 2: SUPER AGGRESSIVE ACTIVATED", false);
         return true;
      }

      if(sparam == UI_PREFIX + "BTN_MODE_2")
      {
         g_cfg.ApplyPreset(RISK_MODE_EXTREME_RESEARCH, false);
         g_cfg.SaveModeState(InpMagicNumber, _Symbol);
         micro.SetBaselineSlippage(g_cfg.base_slippage_pts);
         exec.RefreshConfig();
         g_cfg.SetStatus("MODE 3: EXTREME RESEARCH ACTIVATED", false);
         return true;
      }

      for(int i = 0; i < STRAT_COUNT; i++)
      {
         if(sparam == UI_PREFIX + "BTN_STRAT_" + IntegerToString(i))
         {
            ENUM_STRATEGY_ID sid = (ENUM_STRATEGY_ID)i;
            if(stats.IsSuspended(sid))
            {
               stats.ClearSuspension(sid);
               g_cfg.strat_enabled[i] = true;
               g_cfg.SetStatus(StrategyShortCode(sid) + " SUSPENSION CLEARED", false);
            }
            else
            {
               g_cfg.strat_enabled[i] = !g_cfg.strat_enabled[i];
               g_cfg.SetStatus(StrategyShortCode(sid) + (g_cfg.strat_enabled[i] ? " ENABLED" : " DISABLED"), false);
            }
            return true;
         }
      }

      if(sparam == UI_PREFIX + "BTN_PAUSE")
      {
         g_cfg.trading_paused = !g_cfg.trading_paused;
         g_cfg.SetStatus(g_cfg.trading_paused ? "ENGINE PAUSED BY USER" : "ENGINE RESUMED", g_cfg.trading_paused);
         return true;
      }

      if(sparam == UI_PREFIX + "BTN_CLOSE_ALL")
      {
         datetime now_loc = TimeLocal();
         if(m_close_confirm_until == 0 || now_loc > m_close_confirm_until)
            m_close_confirm_until = now_loc + 4;
         else
         {
            m_close_confirm_until = 0;
            exec.CloseAllSymbolPositions("Manual Close-All Triggered via HUD Panel");
            g_cfg.SetStatus("ALL SYMBOL POSITIONS CLOSED", true);
         }
         return true;
      }

      return false;
   }
