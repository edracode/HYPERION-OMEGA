//+------------------------------------------------------------------+
//| Expert Tick Function (Event-Driven Core Loop)                    |
//+------------------------------------------------------------------+
void OnTick()
{
   // Poll HUD buttons on every tick so visual backtest clicks work instantaneously
   g_panel.PollTesterButtonClicks(g_micro, g_stats, g_exec);

   MqlTick tick;
   if(!SymbolInfoTick(_Symbol, tick))
      return;

   double point = SymbolInfoDouble(_Symbol, SYMBOL_POINT);
   g_micro.OnNewTick(tick, point);

   g_risk.UpdateEquityState();
   string breach_reason = "";
   if(g_risk.IsEmergencyBreached(breach_reason))
   {
      g_cfg.SetStatus(breach_reason, true);
      if(g_exec.CountSymbolPositions() > 0)
         g_exec.CloseAllSymbolPositions(breach_reason);
      g_panel.Update(g_micro, g_mtf, g_risk, g_stats, g_exec);
      return;
   }

   bool mtf_ready = g_mtf.Update();
   if(!mtf_ready)
   {
      g_cfg.SetStatus("LOADING MTF BARS...", true);
      g_panel.Update(g_micro, g_mtf, g_risk, g_stats, g_exec);
      return;
   }

   g_exec.ManageOpenPositions(g_micro, g_mtf);

   if(!g_micro.IsReady())
   {
      g_cfg.SetStatus("WARMING UP TICK BUFFER...", false);
      g_panel.Update(g_micro, g_mtf, g_risk, g_stats, g_exec);
      return;
   }

   string filter_reason = "";
   if(!PassesEnvironmentFilters(filter_reason))
   {
      g_cfg.SetStatus(filter_reason, true);
      g_panel.Update(g_micro, g_mtf, g_risk, g_stats, g_exec);
      return;
   }

   datetime bar_m1   = iTime(_Symbol, PERIOD_M1, 0);
   datetime now      = TimeCurrent();
   string   wait_msg = "";
   if(!g_exec.CanOpenNewPosition(bar_m1, now, wait_msg))
   {
      g_cfg.SetStatus(wait_msg, false);
      g_panel.Update(g_micro, g_mtf, g_risk, g_stats, g_exec);
      return;
   }

   SSignalCandidate best = g_scorer.EvaluateBestOpportunity(g_micro, g_mtf, g_stats);
   if(!best.valid)
   {
      g_cfg.SetStatus("SCANNING MARKET (NO +EV SETUP)", false);
      g_panel.Update(g_micro, g_mtf, g_risk, g_stats, g_exec);
      return;
   }

   double sl_dist_price  = MathAbs(best.entry_price - best.sl_price);
   double strat_mult     = g_stats.GetAdaptiveMultiplier(best.strategy);
   ENUM_ORDER_TYPE otype = (best.direction > 0) ? ORDER_TYPE_BUY : ORDER_TYPE_SELL;
   string lot_reject     = "";

   double lots = g_risk.ComputeValidatedLotSize(sl_dist_price, strat_mult, otype, best.entry_price, lot_reject);
   if(lots <= 0.0)
   {
      g_cfg.SetStatus("LOT REJECTED: " + lot_reject, true);
      g_panel.Update(g_micro, g_mtf, g_risk, g_stats, g_exec);
      return;
   }

   g_exec.ExecuteCandidate(best, lots, bar_m1);
   g_panel.Update(g_micro, g_mtf, g_risk, g_stats, g_exec);
}

//+------------------------------------------------------------------+
//| Trade Transaction Listener (Realized Slippage & Rolling Stats)   |
//+------------------------------------------------------------------+
void OnTradeTransaction(const MqlTradeTransaction &trans,
                        const MqlTradeRequest &request,
                        const MqlTradeResult &result)
{
   if(trans.type != TRADE_TRANSACTION_DEAL_ADD)
      return;

   ulong deal_ticket = trans.deal;
   if(deal_ticket == 0 || !HistoryDealSelect(deal_ticket))
      return;

   if(HistoryDealGetInteger(deal_ticket, DEAL_MAGIC) != (long)InpMagicNumber)
      return;
   if(HistoryDealGetString(deal_ticket, DEAL_SYMBOL) != _Symbol)
      return;

   long   entry_type = HistoryDealGetInteger(deal_ticket, DEAL_ENTRY);
   double deal_price = HistoryDealGetDouble(deal_ticket, DEAL_PRICE);
   double point      = SymbolInfoDouble(_Symbol, SYMBOL_POINT);

   if(entry_type == DEAL_ENTRY_IN && g_exec.last_requested_price > 0.0 && point > 0.0)
   {
      double slip_pts = MathAbs(deal_price - g_exec.last_requested_price) / point;
      g_micro.RecordRealizedSlippage(slip_pts);
   }
   else if(entry_type == DEAL_ENTRY_OUT || entry_type == DEAL_ENTRY_OUT_BY)
   {
      string comment = HistoryDealGetString(deal_ticket, DEAL_COMMENT);
      ENUM_STRATEGY_ID sid = ParseStrategyFromComment(comment);
      if(sid < STRAT_COUNT)
      {
         double net_pnl = HistoryDealGetDouble(deal_ticket, DEAL_PROFIT)
                        + HistoryDealGetDouble(deal_ticket, DEAL_SWAP)
                        + HistoryDealGetDouble(deal_ticket, DEAL_COMMISSION);

         double eq              = MathMax(1.0, AccountInfoDouble(ACCOUNT_EQUITY));
         double base_risk_money = eq * (g_cfg.risk_pct / 100.0);
         double realized_r      = (base_risk_money > 0.0) ? (net_pnl / base_risk_money) : ((net_pnl >= 0.0) ? 1.0 : -1.0);

         long deal_type = HistoryDealGetInteger(deal_ticket, DEAL_TYPE);
         int orig_dir   = (deal_type == DEAL_TYPE_SELL) ? 1 : -1;

         g_stats.RecordTradeResult(sid, net_pnl, realized_r, orig_dir, TimeCurrent(), true);
         g_panel.Update(g_micro, g_mtf, g_risk, g_stats, g_exec);
      }
   }
}

//+------------------------------------------------------------------+
//| Custom Optimization Fitness Criterion (Calmar * PF * Stability)  |
//+------------------------------------------------------------------+
double OnTester()
{
   double net_profit = TesterStatistics(STAT_PROFIT);
   double max_dd_pct = TesterStatistics(STAT_EQUITY_DDREL_PERCENT);
   double pf         = TesterStatistics(STAT_PROFIT_FACTOR);
   double trades     = TesterStatistics(STAT_TRADES);

   if(net_profit <= 0.0 || trades < 100.0 || max_dd_pct >= 35.0)
      return 0.0;

   double initial_dep = TesterStatistics(STAT_INITIAL_DEPOSIT);
   if(initial_dep <= 0.0) return 0.0;

   double return_pct   = (net_profit / initial_dep) * 100.0;
   double calmar_proxy = return_pct / MathMax(1.0, max_dd_pct);
   double trade_factor = MathSqrt(MathMin(trades, 2500.0));

   return calmar_proxy * MathMin(pf, 4.0) * trade_factor;
}
