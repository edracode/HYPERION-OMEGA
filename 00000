      double pnl_m = risk.GetTodayPnLMoney();
      double pnl_p = risk.GetTodayPnLPct();
      SetText("VAL_TODAY_PNL", StringFormat("Today P&L: %+.2f (%+.2f%%)", pnl_m, pnl_p), (pnl_m >= 0.0 ? C_EMERALD : C_CRIMSON));

      double d_loss = risk.GetCurrentDailyLossPct();
      double d_lim  = MathMax(0.1, g_cfg.max_daily_loss_pct);
      double d_fill = MathMin(1.0, d_loss / d_lim);
      SetText("LBL_DAILY_BAR", StringFormat("Daily Loss: %.2f%% / %.1f%%", d_loss, d_lim), C_TEXT_SEC);
      ObjectSetInteger(0, UI_PREFIX + "BAR_DAILY_FG", OBJPROP_XSIZE, MathMax(2, (int)(158.0 * d_fill)));

      SetText("VAL_CUM_RISK", StringFormat("CumRisk: %.2f%% / %.1f%% | Pos: %d / %d", risk.GetCumulativeOpenRiskPct(), g_cfg.max_cum_risk_pct, exec.CountSymbolPositions(), g_cfg.max_signals_symbol * InpMaxTranchesPerSignal), C_TEXT_PRI);

      string h1_txt = (mtf.h1_trend_dir > 0) ? "BULL ▲" : ((mtf.h1_trend_dir < 0) ? "BEAR ▼" : "FLAT ◆");
      SetText("VAL_REGIME", StringFormat("%s | H1:%s", RegimeName(mtf.current_regime), h1_txt), C_CYAN);

      double pip_scale = GetGoldPipScale(_Symbol);
      SetText("VAL_VEL_SPR", StringFormat("TickVel:%.1f/s | Spr:%.1fp", micro.tick_velocity, (micro.current_spread_pts / pip_scale)), C_TEXT_PRI);
      SetText("VAL_AC_SLIP", StringFormat("ShdA:%+.2fR | ShdB:%+.2fR | ShdC:%+.2fR", shadow.GetExpRA(), shadow.GetExpRB(), shadow.GetExpRC()), C_TEXT_SEC);

      for(int i = 0; i < STRAT_COUNT; i++)
      {
         ENUM_STRATEGY_ID sid = (ENUM_STRATEGY_ID)i;
         string idx_s = IntegerToString(i);
         bool en   = g_cfg.strat_enabled[i];
         bool susp = stats.IsSuspended(sid);

         if(!en) StyleButton("BTN_STRAT_" + idx_s, "OFF", C_TEXT_SEC, C_BTN_IDLE, C_BORDER);
         else if(susp) StyleButton("BTN_STRAT_" + idx_s, "SUSP", C_BG_MAIN, C_AMBER, C_AMBER);
         else StyleButton("BTN_STRAT_" + idx_s, "ON", C_BG_MAIN, C_EMERALD, C_EMERALD);

         SetText("S_STATS_" + idx_s, StringFormat("%3d %+8.2f %+5.2fR", stats.GetTotalTrades(sid), stats.GetNetProfit(sid), stats.GetRollingExpR(sid)), (stats.GetNetProfit(sid) >= 0 ? C_EMERALD : C_CRIMSON));
      }

      SetText("VAL_STATUS", "STATUS: " + g_cfg.status_text, (g_cfg.status_is_alert ? C_AMBER : C_EMERALD));

      if(g_cfg.trading_paused) StyleButton("BTN_PAUSE", "ENGINE: PAUSED", C_BG_MAIN, C_AMBER, C_AMBER);
      else if(risk.IsEngineCActive()) StyleButton("BTN_PAUSE", "ENGINE C: CRASH RECOV", C_BG_MAIN, C_CRIMSON, C_CRIMSON);
      else if(risk.IsEngineBActive()) StyleButton("BTN_PAUSE", "ENGINE B: MACRO ACTIVE", C_BG_MAIN, C_CYAN, C_CYAN);
      else StyleButton("BTN_PAUSE", "ENGINE A: SCALP ACTIVE", C_BG_MAIN, C_EMERALD, C_EMERALD);

      if(m_close_confirm_until > 0 && TimeLocal() <= m_close_confirm_until)
         StyleButton("BTN_CLOSE_ALL", "CONFIRM CLOSE ALL?", C_TEXT_PRI, C_CRIMSON, C_AMBER);
      else
      {
         m_close_confirm_until = 0;
         StyleButton("BTN_CLOSE_ALL", "CLOSE ALL POSITIONS", C_TEXT_PRI, C'65,24,32', C_CRIMSON);
      }
   }

   bool OnClick(const string sparam, CMicrostructureEngine &micro, CAdaptiveStatsTracker &stats, CExecutionEngine &exec)
   {
      if(!m_enabled || StringFind(sparam, UI_PREFIX) != 0) return false;
      ObjectSetInteger(0, sparam, OBJPROP_STATE, false);

      if(sparam == UI_PREFIX + "BTN_MIN") { m_minimized = !m_minimized; BuildLayout(); return true; }
      double pip_scale = GetGoldPipScale(_Symbol);

      if(sparam == UI_PREFIX + "BTN_MODE_0") { g_cfg.ApplyRiskMode(RISK_MODE_AGGRESSIVE, true); g_cfg.SaveModeState(InpMagicNumber, _Symbol); micro.SetBaselineSlippage(g_cfg.base_slippage_pips * pip_scale); exec.RefreshConfig(); g_cfg.SetStatus("MODE 1: AGGRESSIVE", false); return true; }
      if(sparam == UI_PREFIX + "BTN_MODE_1") { g_cfg.ApplyRiskMode(RISK_MODE_SUPER_AGGRESSIVE, true); g_cfg.SaveModeState(InpMagicNumber, _Symbol); micro.SetBaselineSlippage(g_cfg.base_slippage_pips * pip_scale); exec.RefreshConfig(); g_cfg.SetStatus("MODE 2: SUPER AGGR", false); return true; }
      if(sparam == UI_PREFIX + "BTN_MODE_2") { g_cfg.ApplyRiskMode(RISK_MODE_EXTREME_RESEARCH, true); g_cfg.SaveModeState(InpMagicNumber, _Symbol); micro.SetBaselineSlippage(g_cfg.base_slippage_pips * pip_scale); exec.RefreshConfig(); g_cfg.SetStatus("MODE 3: EXTREME RES", false); return true; }

      for(int i = 0; i < STRAT_COUNT; i++)
      {
         if(sparam == UI_PREFIX + "BTN_STRAT_" + IntegerToString(i))
         {
            ENUM_STRATEGY_ID sid = (ENUM_STRATEGY_ID)i;
            if(stats.IsSuspended(sid)) { stats.ClearSuspension(sid); g_cfg.strat_enabled[i] = true; }
            else { g_cfg.strat_enabled[i] = !g_cfg.strat_enabled[i]; }
            return true;
         }
      }

      if(sparam == UI_PREFIX + "BTN_PAUSE") { g_cfg.trading_paused = !g_cfg.trading_paused; return true; }
      if(sparam == UI_PREFIX + "BTN_CLOSE_ALL")
      {
         datetime now_loc = TimeLocal();
         if(m_close_confirm_until == 0 || now_loc > m_close_confirm_until) m_close_confirm_until = now_loc + 4;
         else { m_close_confirm_until = 0; exec.CloseAllMagicPositions("Manual Close-All"); }
         return true;
      }
      return false;
   }
};

