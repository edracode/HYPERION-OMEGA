double GetGoldPipScale(const string symbol)
{
   int digits = (int)SymbolInfoInteger(symbol, SYMBOL_DIGITS);
   if(digits == 3 || digits == 5) return 10.0;
   return 1.0;
}

bool IsStrategyEngineB(ENUM_STRATEGY_ID sid)
{
   return (sid >= STRAT_B0_M15_BREAKOUT && sid <= STRAT_B2_H1_PULLBACK);
}

bool IsStrategyEngineC(ENUM_STRATEGY_ID sid)
{
   return (sid >= STRAT_C0_VOL_SPIKE_REV && sid < STRAT_COUNT);
}

