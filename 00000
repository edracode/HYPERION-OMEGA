//+------------------------------------------------------------------+
//| Session & Auto-Adaptive Spread Filter Validation                 |
//+------------------------------------------------------------------+
bool PassesEnvironmentFilters(string &block_reason)
{
   if(!TerminalInfoInteger(TERMINAL_TRADE_ALLOWED) || !MQLInfoInteger(MQL_TRADE_ALLOWED))
   {
      block_reason = "ALGO TRADING DISABLED IN MT5";
      return false;
   }

   MqlDateTime dt;
   TimeCurrent(dt);

   if(InpAvoidRolloverWindow)
   {
      if((dt.hour == 23 && dt.min >= 50) || (dt.hour == 0 && dt.min <= 10))
      {
         block_reason = "DAILY ROLLOVER PROTECTION";
         return false;
      }
   }

   if(InpUseSessionFilter)
   {
      if(InpSessionStartHour <= InpSessionEndHour)
      {
         if(dt.hour < InpSessionStartHour || dt.hour > InpSessionEndHour)
         {
            block_reason = "OUTSIDE TRADING SESSION";
            return false;
         }
      }
      else
      {
         if(dt.hour < InpSessionStartHour && dt.hour > InpSessionEndHour)
         {
            block_reason = "OUTSIDE TRADING SESSION";
            return false;
         }
      }
   }

   double point = SymbolInfoDouble(_Symbol, SYMBOL_POINT);
   if(point <= 0.0)
   {
      block_reason = "INVALID SYMBOL POINT";
      return false;
   }

   // Optional hard spread ceiling (only enforced when > 0)
   if(g_cfg.max_spread_pts > 0.0 && g_micro.current_spread_pts > g_cfg.max_spread_pts)
   {
      block_reason = StringFormat("SPREAD %.0f > MAX %.0f PTS", g_micro.current_spread_pts, g_cfg.max_spread_pts);
      return false;
   }

   // Dynamic ATR-relative spread filter (works across Forex, Gold, Crypto, Indices)
   double atr_pts = g_mtf.m1_atr[0] / point;
   if(atr_pts > 0.0 && (g_micro.current_spread_pts / atr_pts) > g_cfg.max_spread_atr_ratio)
   {
      block_reason = StringFormat("SPREAD/ATR %.2f > %.2f", (g_micro.current_spread_pts / atr_pts), g_cfg.max_spread_atr_ratio);
      return false;
   }

   // Sudden extreme spread spike protection
   if(g_micro.spread_zscore > 3.2)
   {
      block_reason = StringFormat("SPREAD SPIKE Z=%.1f", g_micro.spread_zscore);
      return false;
   }

   return true;
}

