ENUM_STRATEGY_ID ParseStrategyFromComment(const string comment)
{
   if(StringFind(comment, "MVX2|S0") >= 0) return STRAT_ULTRA_MOMENTUM;
   if(StringFind(comment, "MVX2|S1") >= 0) return STRAT_LIQUIDITY_SWEEP;
   if(StringFind(comment, "MVX2|S2") >= 0) return STRAT_MEAN_REVERSION;
   if(StringFind(comment, "MVX2|S3") >= 0) return STRAT_VOL_EXPLOSION;
   if(StringFind(comment, "MVX2|S4") >= 0) return STRAT_TREND_IMPULSE;
   return STRAT_COUNT;
}

double NormalizePriceToTick(const string symbol, double price)
{
   double tick_size = SymbolInfoDouble(symbol, SYMBOL_TRADE_TICK_SIZE);
   int    digits    = (int)SymbolInfoInteger(symbol, SYMBOL_DIGITS);
   if(tick_size <= 0.0)
      return NormalizeDouble(price, digits);
   double steps = MathRound(price / tick_size);
   return NormalizeDouble(steps * tick_size, digits);
}

//+------------------------------------------------------------------+
//| 1. Microstructure & Tick Dynamics Engine                         |
//+------------------------------------------------------------------+
class CMicrostructureEngine
{
private:
   STickSample m_ring[TICK_BUFFER_CAPACITY];
   int         m_count;
   int         m_head;
   double      m_spread_ema;
   double      m_spread_var_ema;
   double      m_realized_slippage_pts;

public:
   double tick_velocity;
   double price_velocity_pts;
   double price_accel_pts;
   double tick_imbalance;
   double current_spread_pts;
   double spread_zscore;
   double estimated_slippage_pts;

   void Init(double initial_slippage_pts)
   {
      m_count                 = 0;
      m_head                  = 0;
      m_spread_ema            = 0.0;
      m_spread_var_ema        = 1.0;
      m_realized_slippage_pts = MathMax(0.0, initial_slippage_pts);
      tick_velocity           = 0.0;
      price_velocity_pts      = 0.0;
      price_accel_pts         = 0.0;
      tick_imbalance          = 0.0;
      current_spread_pts      = 0.0;
      spread_zscore           = 0.0;
      estimated_slippage_pts  = m_realized_slippage_pts;
   }

   void SetBaselineSlippage(double base_slip)
   {
      m_realized_slippage_pts = MathMax(0.0, base_slip);
      estimated_slippage_pts  = m_realized_slippage_pts;
   }

   void RecordRealizedSlippage(double slip_pts)
   {
      if(slip_pts < 0.0) slip_pts = 0.0;
      if(slip_pts > 200.0) slip_pts = 200.0;
      m_realized_slippage_pts = 0.85 * m_realized_slippage_pts + 0.15 * slip_pts;
      estimated_slippage_pts  = m_realized_slippage_pts;
   }

   void OnNewTick(const MqlTick &tick, double point)
   {
      if(point <= 0.0 || tick.bid <= 0.0 || tick.ask <= 0.0)
         return;

      double mid        = 0.5 * (tick.bid + tick.ask);
      double spread_pts = (tick.ask - tick.bid) / point;
      ulong  now_msc    = (tick.time_msc > 0) ? (ulong)tick.time_msc : (ulong)(tick.time * 1000);

      int dir = 0;
      if(m_count > 0)
      {
         int prev_idx = (m_head - 1 + TICK_BUFFER_CAPACITY) % TICK_BUFFER_CAPACITY;
         if(mid > m_ring[prev_idx].mid)      dir = 1;
         else if(mid < m_ring[prev_idx].mid) dir = -1;
      }

      m_ring[m_head].bid        = tick.bid;
      m_ring[m_head].ask        = tick.ask;
      m_ring[m_head].mid        = mid;
      m_ring[m_head].spread_pts = spread_pts;
      m_ring[m_head].time_msc   = now_msc;
      m_ring[m_head].dir        = dir;

      m_head = (m_head + 1) % TICK_BUFFER_CAPACITY;
      if(m_count < TICK_BUFFER_CAPACITY)
         m_count++;

      current_spread_pts = spread_pts;
      if(m_spread_ema <= 0.0)
      {
         m_spread_ema     = spread_pts;
         m_spread_var_ema = MathMax(1.0, spread_pts * 0.1);
      }
      else
      {
         double diff      = spread_pts - m_spread_ema;
         m_spread_ema     = 0.96 * m_spread_ema + 0.04 * spread_pts;
         m_spread_var_ema = 0.96 * m_spread_var_ema + 0.04 * (diff * diff);
      }
      double std_spread = MathSqrt(MathMax(m_spread_var_ema, 1.0));
      spread_zscore     = (spread_pts - m_spread_ema) / std_spread;

      ComputeMetrics(point);
   }

   bool IsReady() const { return (m_count >= 6); }

private:
   void ComputeMetrics(double point)
   {
      int win = MathMin(m_count, MathMax(6, MathMin(g_cfg.tick_window, TICK_BUFFER_CAPACITY)));
      if(win < 4) return;

      int newest_idx = (m_head - 1 + TICK_BUFFER_CAPACITY) % TICK_BUFFER_CAPACITY;
      int oldest_idx = (m_head - win + TICK_BUFFER_CAPACITY) % TICK_BUFFER_CAPACITY;
      int mid_idx    = (m_head - (win / 2) + TICK_BUFFER_CAPACITY) % TICK_BUFFER_CAPACITY;

      double dt_total_sec = 0.0;
      if(m_ring[newest_idx].time_msc >= m_ring[oldest_idx].time_msc)
         dt_total_sec = (double)(m_ring[newest_idx].time_msc - m_ring[oldest_idx].time_msc) / 1000.0;
      if(dt_total_sec < 0.25) dt_total_sec = 0.25;

      double dt_first_sec = 0.0;
      if(m_ring[mid_idx].time_msc >= m_ring[oldest_idx].time_msc)
         dt_first_sec = (double)(m_ring[mid_idx].time_msc - m_ring[oldest_idx].time_msc) / 1000.0;
      if(dt_first_sec < 0.125) dt_first_sec = 0.125;

      double dt_second_sec = 0.0;
      if(m_ring[newest_idx].time_msc >= m_ring[mid_idx].time_msc)
         dt_second_sec = (double)(m_ring[newest_idx].time_msc - m_ring[mid_idx].time_msc) / 1000.0;
      if(dt_second_sec < 0.125) dt_second_sec = 0.125;

      tick_velocity      = (double)(win - 1) / dt_total_sec;
      double dp_total    = (m_ring[newest_idx].mid - m_ring[oldest_idx].mid) / point;
      price_velocity_pts = dp_total / dt_total_sec;

      double vel_1 = ((m_ring[mid_idx].mid - m_ring[oldest_idx].mid) / point) / dt_first_sec;
      double vel_2 = ((m_ring[newest_idx].mid - m_ring[mid_idx].mid) / point) / dt_second_sec;
      price_accel_pts = (vel_2 - vel_1) / (0.5 * dt_total_sec);

      int up_ticks = 0, down_ticks = 0;
      for(int i = 0; i < win; i++)
      {
         int idx = (m_head - 1 - i + TICK_BUFFER_CAPACITY) % TICK_BUFFER_CAPACITY;
         if(m_ring[idx].dir > 0)      up_ticks++;
         else if(m_ring[idx].dir < 0) down_ticks++;
      }
      int directional_ticks = up_ticks + down_ticks;
      tick_imbalance = (directional_ticks > 0) ? ((double)(up_ticks - down_ticks) / (double)directional_ticks) : 0.0;
   }
};

//+------------------------------------------------------------------+
//| 2. Multi-Timeframe Context & Regime Engine (Cached per Bar)      |
//+------------------------------------------------------------------+
class CMTFContextEngine
{
private:
   string   m_symbol;
   int      m_h_ema_fast_m1;
   int      m_h_ema_slow_m1;
   int      m_h_atr_m1;
   int      m_h_rsi_m1;
   int      m_h_bb_m1;

   int      m_h_atr_m5;
   int      m_h_adx_m5;

   int      m_h_atr_m15;

   int      m_h_ema_fast_h1;
   int      m_h_ema_slow_h1;
   int      m_h_adx_h1;

   datetime m_last_bar_m1;
   datetime m_last_bar_m5;
   datetime m_last_bar_m15;
   datetime m_last_bar_h1;

public:
   double m1_ema_fast[3];
   double m1_ema_slow[3];
   double m1_atr[3];
   double m1_rsi[3];
   double m1_bb_upper[3];
   double m1_bb_mid[3];
   double m1_bb_lower[3];
   double m1_open[4];
   double m1_high[4];
   double m1_low[4];
   double m1_close[4];
   double m1_autocorr_lag1;
   double m1_atr_baseline;

   double m5_atr[2];
   double m5_adx[2];
   double m5_plus_di[2];
   double m5_minus_di[2];
   double m5_atr_avg;

   double m15_swing_high;
   double m15_swing_low;
   double m15_atr;

   double h1_ema_fast[2];
   double h1_ema_slow[2];
   double h1_adx[2];
   double h1_plus_di[2];
   double h1_minus_di[2];
   int    h1_trend_dir;

   ENUM_MARKET_REGIME current_regime;
   double             seasonality_score;

   bool Init(const string symbol)
   {
      m_symbol       = symbol;
      m_last_bar_m1  = 0;
      m_last_bar_m5  = 0;
      m_last_bar_m15 = 0;
      m_last_bar_h1  = 0;

      m_h_ema_fast_m1 = iMA(m_symbol, PERIOD_M1, InpM1_FastEMA, 0, MODE_EMA, PRICE_CLOSE);
      m_h_ema_slow_m1 = iMA(m_symbol, PERIOD_M1, InpM1_SlowEMA, 0, MODE_EMA, PRICE_CLOSE);
      m_h_atr_m1      = iATR(m_symbol, PERIOD_M1, InpM1_ATR_Period);
      m_h_rsi_m1      = iRSI(m_symbol, PERIOD_M1, InpM1_RSI_Period, PRICE_CLOSE);
      m_h_bb_m1       = iBands(m_symbol, PERIOD_M1, InpM1_BB_Period, 0, InpM1_BB_Deviation, PRICE_CLOSE);

      m_h_atr_m5      = iATR(m_symbol, PERIOD_M5, InpM5_ATR_Period);
      m_h_adx_m5      = iADX(m_symbol, PERIOD_M5, InpM5_ADX_Period);

      m_h_atr_m15     = iATR(m_symbol, PERIOD_M15, 14);

      m_h_ema_fast_h1 = iMA(m_symbol, PERIOD_H1, InpH1_FastEMA, 0, MODE_EMA, PRICE_CLOSE);
      m_h_ema_slow_h1 = iMA(m_symbol, PERIOD_H1, InpH1_SlowEMA, 0, MODE_EMA, PRICE_CLOSE);
      m_h_adx_h1      = iADX(m_symbol, PERIOD_H1, InpH1_ADX_Period);

      if(m_h_ema_fast_m1 == INVALID_HANDLE || m_h_ema_slow_m1 == INVALID_HANDLE ||
         m_h_atr_m1      == INVALID_HANDLE || m_h_rsi_m1      == INVALID_HANDLE ||
         m_h_bb_m1       == INVALID_HANDLE || m_h_atr_m5      == INVALID_HANDLE ||
         m_h_adx_m5      == INVALID_HANDLE || m_h_atr_m15     == INVALID_HANDLE ||
         m_h_ema_fast_h1 == INVALID_HANDLE || m_h_ema_slow_h1 == INVALID_HANDLE ||
         m_h_adx_h1      == INVALID_HANDLE)
      {
         Print("[MIDAS VX ERROR] Failed to create one or more MTF indicator handles.");
         return false;
      }

      ArrayInitialize(m1_atr, 0.0);
      current_regime    = REGIME_TRANSITIONAL_SCALP;
      seasonality_score = 1.0;
      m1_autocorr_lag1  = 0.0;
      h1_trend_dir      = 0;
      return true;
   }

   void Release()
   {
      if(m_h_ema_fast_m1 != INVALID_HANDLE) IndicatorRelease(m_h_ema_fast_m1);
      if(m_h_ema_slow_m1 != INVALID_HANDLE) IndicatorRelease(m_h_ema_slow_m1);
      if(m_h_atr_m1      != INVALID_HANDLE) IndicatorRelease(m_h_atr_m1);
      if(m_h_rsi_m1      != INVALID_HANDLE) IndicatorRelease(m_h_rsi_m1);
      if(m_h_bb_m1       != INVALID_HANDLE) IndicatorRelease(m_h_bb_m1);
      if(m_h_atr_m5      != INVALID_HANDLE) IndicatorRelease(m_h_atr_m5);
      if(m_h_adx_m5      != INVALID_HANDLE) IndicatorRelease(m_h_adx_m5);
      if(m_h_atr_m15     != INVALID_HANDLE) IndicatorRelease(m_h_atr_m15);
      if(m_h_ema_fast_h1 != INVALID_HANDLE) IndicatorRelease(m_h_ema_fast_h1);
      if(m_h_ema_slow_h1 != INVALID_HANDLE) IndicatorRelease(m_h_ema_slow_h1);
      if(m_h_adx_h1      != INVALID_HANDLE) IndicatorRelease(m_h_adx_h1);
   }

   bool Update()
   {
      if(BarsCalculated(m_h_bb_m1) < InpM1_BB_Period + 5 ||
         BarsCalculated(m_h_atr_m1) < InpM1_ATR_Period + 5)
         return false;

      datetime bar_h1  = iTime(m_symbol, PERIOD_H1, 0);
      datetime bar_m15 = iTime(m_symbol, PERIOD_M15, 0);
      datetime bar_m5  = iTime(m_symbol, PERIOD_M5, 0);
      datetime bar_m1  = iTime(m_symbol, PERIOD_M1, 0);

      if(bar_h1 != m_last_bar_h1 && bar_h1 > 0)
         if(UpdateH1()) m_last_bar_h1 = bar_h1;

      if(bar_m15 != m_last_bar_m15 && bar_m15 > 0)
         if(UpdateM15()) m_last_bar_m15 = bar_m15;

      if(bar_m5 != m_last_bar_m5 && bar_m5 > 0)
         if(UpdateM5()) m_last_bar_m5 = bar_m5;

      if(bar_m1 != m_last_bar_m1 && bar_m1 > 0)
      {
         if(UpdateM1())
         {
            m_last_bar_m1 = bar_m1;
            ClassifyRegime();
         }
      }

      return (m_last_bar_m1 > 0 && m_last_bar_m5 > 0 && m_last_bar_m15 > 0);
   }

private:
   bool UpdateH1()
   {
      double buf[2];
      if(CopyBuffer(m_h_ema_fast_h1, 0, 1, 2, buf) < 2) return false;
      h1_ema_fast[0] = buf[1]; h1_ema_fast[1] = buf[0];

      if(CopyBuffer(m_h_ema_slow_h1, 0, 1, 2, buf) < 2)
      {
         // Fallback for short backtest history
         h1_ema_slow[0] = h1_ema_fast[1];
         h1_ema_slow[1] = h1_ema_fast[1];
      }
      else
      {
         h1_ema_slow[0] = buf[1]; h1_ema_slow[1] = buf[0];
      }

      if(CopyBuffer(m_h_adx_h1, 0, 1, 2, buf) < 2) return false;
      h1_adx[0] = buf[1]; h1_adx[1] = buf[0];

      if(CopyBuffer(m_h_adx_h1, 1, 1, 2, buf) < 2) return false;
      h1_plus_di[0] = buf[1]; h1_plus_di[1] = buf[0];

      if(CopyBuffer(m_h_adx_h1, 2, 1, 2, buf) < 2) return false;
      h1_minus_di[0] = buf[1]; h1_minus_di[1] = buf[0];

      if(h1_ema_fast[0] > h1_ema_slow[0] && h1_plus_di[0] >= h1_minus_di[0])
         h1_trend_dir = 1;
      else if(h1_ema_fast[0] < h1_ema_slow[0] && h1_minus_di[0] >= h1_plus_di[0])
         h1_trend_dir = -1;
      else
         h1_trend_dir = 0;

      MqlDateTime dt;
      TimeCurrent(dt);
      if((dt.hour >= 8 && dt.hour <= 11) || (dt.hour >= 13 && dt.hour <= 17))
         seasonality_score = 1.15;
      else if(dt.hour >= 18 && dt.hour <= 20)
         seasonality_score = 1.00;
      else
         seasonality_score = 0.88;

      return true;
   }

   bool UpdateM15()
   {
      int lookback = MathMax(5, InpM15_SwingLookback);
      int hi_idx   = iHighest(m_symbol, PERIOD_M15, MODE_HIGH, lookback, 1);
      int lo_idx   = iLowest(m_symbol, PERIOD_M15, MODE_LOW, lookback, 1);
      if(hi_idx < 0 || lo_idx < 0) return false;

      m15_swing_high = iHigh(m_symbol, PERIOD_M15, hi_idx);
      m15_swing_low  = iLow(m_symbol, PERIOD_M15, lo_idx);

      double buf[1];
      if(CopyBuffer(m_h_atr_m15, 0, 1, 1, buf) < 1) return false;
      m15_atr = buf[0];
      return true;
   }

   bool UpdateM5()
   {
      double atr_arr[20];
      if(CopyBuffer(m_h_atr_m5, 0, 1, 20, atr_arr) < 20) return false;
      m5_atr[0] = atr_arr[19];
      m5_atr[1] = atr_arr[18];

      double sum = 0.0;
      for(int i = 0; i < 20; i++) sum += atr_arr[i];
      m5_atr_avg = sum / 20.0;

      double buf[2];
      if(CopyBuffer(m_h_adx_m5, 0, 1, 2, buf) < 2) return false;
      m5_adx[0] = buf[1]; m5_adx[1] = buf[0];

      if(CopyBuffer(m_h_adx_m5, 1, 1, 2, buf) < 2) return false;
      m5_plus_di[0] = buf[1]; m5_plus_di[1] = buf[0];

      if(CopyBuffer(m_h_adx_m5, 2, 1, 2, buf) < 2) return false;
      m5_minus_di[0] = buf[1]; m5_minus_di[1] = buf[0];

      return true;
   }

   bool UpdateM1()
   {
      double buf3[3];
      if(CopyBuffer(m_h_ema_fast_m1, 0, 1, 3, buf3) < 3) return false;
      m1_ema_fast[0] = buf3[2]; m1_ema_fast[1] = buf3[1]; m1_ema_fast[2] = buf3[0];

      if(CopyBuffer(m_h_ema_slow_m1, 0, 1, 3, buf3) < 3) return false;
      m1_ema_slow[0] = buf3[2]; m1_ema_slow[1] = buf3[1]; m1_ema_slow[2] = buf3[0];

      if(CopyBuffer(m_h_rsi_m1, 0, 1, 3, buf3) < 3) return false;
      m1_rsi[0] = buf3[2]; m1_rsi[1] = buf3[1]; m1_rsi[2] = buf3[0];

      if(CopyBuffer(m_h_bb_m1, 0, 1, 3, buf3) < 3) return false;
      m1_bb_mid[0] = buf3[2]; m1_bb_mid[1] = buf3[1]; m1_bb_mid[2] = buf3[0];

      if(CopyBuffer(m_h_bb_m1, 1, 1, 3, buf3) < 3) return false;
      m1_bb_upper[0] = buf3[2]; m1_bb_upper[1] = buf3[1]; m1_bb_upper[2] = buf3[0];

      if(CopyBuffer(m_h_bb_m1, 2, 1, 3, buf3) < 3) return false;
      m1_bb_lower[0] = buf3[2]; m1_bb_lower[1] = buf3[1]; m1_bb_lower[2] = buf3[0];

      double atr25[25];
      if(CopyBuffer(m_h_atr_m1, 0, 1, 25, atr25) < 25) return false;
      m1_atr[0] = atr25[24];
      m1_atr[1] = atr25[23];
      m1_atr[2] = atr25[22];

      double atr_sum = 0.0;
      for(int i = 0; i < 25; i++) atr_sum += atr25[i];
      m1_atr_baseline = atr_sum / 25.0;

      MqlRates rates[32];
      if(CopyRates(m_symbol, PERIOD_M1, 1, 32, rates) < 32) return false;
      for(int k = 0; k < 4; k++)
      {
         int idx = 31 - k;
         m1_open[k]  = rates[idx].open;
         m1_high[k]  = rates[idx].high;
         m1_low[k]   = rates[idx].low;
         m1_close[k] = rates[idx].close;
      }

      double rets[31];
      double mean_r = 0.0;
      for(int i = 0; i < 31; i++)
      {
         rets[i] = (rates[i + 1].close - rates[i].close);
         mean_r += rets[i];
      }
      mean_r /= 31.0;

      double num = 0.0, den = 0.0;
      for(int i = 0; i < 31; i++)
      {
         double d = rets[i] - mean_r;
         den += d * d;
         if(i > 0)
            num += d * (rets[i - 1] - mean_r);
      }
      m1_autocorr_lag1 = (den > 1e-12) ? (num / den) : 0.0;

      return true;
   }

   void ClassifyRegime()
   {
      double vol_ratio = (m5_atr_avg > 0.0) ? (m5_atr[0] / m5_atr_avg) : 1.0;

      if(vol_ratio < 0.78 && m5_adx[0] < 22.0)
         current_regime = REGIME_COMPRESSION_BREAKOUT;
      else if(h1_adx[0] >= 22.0 && h1_trend_dir != 0)
         current_regime = (vol_ratio >= 1.20) ? REGIME_TRENDING_HIGH_VOL : REGIME_TRENDING_NORMAL;
      else if(h1_adx[0] < 22.0 && m1_autocorr_lag1 < -0.02)
         current_regime = REGIME_RANGING_MEAN_REV;
      else
         current_regime = REGIME_TRANSITIONAL_SCALP;
   }
};

//+------------------------------------------------------------------+
//| 3. Causal Rolling Performance & Self-Optimization Tracker        |
//+------------------------------------------------------------------+
class CAdaptiveStatsTracker
{
private:
   SStrategyStats m_stats[STRAT_COUNT];
   ulong          m_magic;
   string         m_symbol;

public:
   void Init(ulong magic, const string symbol)
   {
      m_magic  = magic;
      m_symbol = symbol;
      for(int i = 0; i < STRAT_COUNT; i++)
         m_stats[i].Reset();

      if(!MQLInfoInteger(MQL_TESTER))
         RecoverFromAccountHistory();
   }

   void RecoverFromAccountHistory()
   {
      datetime from_time = TimeCurrent() - 14 * 86400;
      if(!HistorySelect(from_time, TimeCurrent()))
         return;

      int total_deals = HistoryDealsTotal();
      for(int i = 0; i < total_deals; i++)
      {
         ulong deal_ticket = HistoryDealGetTicket(i);
         if(deal_ticket == 0) continue;

         if(HistoryDealGetInteger(deal_ticket, DEAL_MAGIC) != (long)m_magic) continue;
         if(HistoryDealGetString(deal_ticket, DEAL_SYMBOL) != m_symbol) continue;

         long entry_type = HistoryDealGetInteger(deal_ticket, DEAL_ENTRY);
         if(entry_type != DEAL_ENTRY_OUT && entry_type != DEAL_ENTRY_OUT_BY) continue;

         string comment = HistoryDealGetString(deal_ticket, DEAL_COMMENT);
         ENUM_STRATEGY_ID sid = ParseStrategyFromComment(comment);
         if(sid >= STRAT_COUNT) continue;

         double profit = HistoryDealGetDouble(deal_ticket, DEAL_PROFIT)
                       + HistoryDealGetDouble(deal_ticket, DEAL_SWAP)
                       + HistoryDealGetDouble(deal_ticket, DEAL_COMMISSION);

         long deal_type = HistoryDealGetInteger(deal_ticket, DEAL_TYPE);
         int orig_dir   = (deal_type == DEAL_TYPE_SELL) ? 1 : -1;
         datetime dtime = (datetime)HistoryDealGetInteger(deal_ticket, DEAL_TIME);

         double est_r = (profit >= 0.0) ? 1.0 : -1.0;
         RecordTradeResult(sid, profit, est_r, orig_dir, dtime, false);
      }
   }

   void RecordTradeResult(ENUM_STRATEGY_ID sid, double net_profit, double realized_r,
                          int orig_dir, datetime exit_time, bool allow_suspend)
   {
      if(sid < 0 || sid >= STRAT_COUNT) return;

      m_stats[sid].total_trades++;
      m_stats[sid].net_profit += net_profit;
      m_stats[sid].last_exit_time       = exit_time;
      m_stats[sid].last_exit_dir        = orig_dir;
      m_stats[sid].last_exit_profitable = (net_profit > 0.0);

      if(net_profit > 0.0)
      {
         m_stats[sid].wins++;
         m_stats[sid].gross_profit += net_profit;
         m_stats[sid].consecutive_losses = 0;
      }
      else
      {
         m_stats[sid].losses++;
         m_stats[sid].gross_loss += MathAbs(net_profit);
         m_stats[sid].consecutive_losses++;
      }

      int win_len = MathMax(5, MathMin(g_cfg.rolling_window_trades, 100));
      int idx     = m_stats[sid].rolling_count % win_len;
      m_stats[sid].r_history[idx] = realized_r;
      m_stats[sid].rolling_count++;

      int samples = MathMin(m_stats[sid].rolling_count, win_len);
      double sum_r = 0.0;
      for(int k = 0; k < samples; k++)
         sum_r += m_stats[sid].r_history[k];

      m_stats[sid].rolling_expectancy_r = sum_r / (double)samples;

      if(InpUseAdaptiveSelfOpt && allow_suspend && samples >= g_cfg.min_trades_adapt)
      {
         if(m_stats[sid].rolling_expectancy_r < g_cfg.suspend_exp_floor ||
            m_stats[sid].consecutive_losses >= 5)
         {
            m_stats[sid].suspended     = true;
            m_stats[sid].suspend_until = exit_time + g_cfg.suspend_cooldown_min * 60;
         }
      }
   }

   bool IsStrategyAvailable(ENUM_STRATEGY_ID sid, datetime now)
   {
      if(sid < 0 || sid >= STRAT_COUNT) return false;
      if(!m_stats[sid].suspended) return true;

      if(now >= m_stats[sid].suspend_until)
      {
         m_stats[sid].suspended            = false;
         m_stats[sid].consecutive_losses   = 0;
         m_stats[sid].rolling_expectancy_r = 0.05;
         return true;
      }
      return false;
   }

   void ClearSuspension(ENUM_STRATEGY_ID sid)
   {
      if(sid < 0 || sid >= STRAT_COUNT) return;
      m_stats[sid].suspended          = false;
      m_stats[sid].consecutive_losses = 0;
      if(m_stats[sid].rolling_expectancy_r < 0.0)
         m_stats[sid].rolling_expectancy_r = 0.05;
   }

   double GetCalibratedWinProb(ENUM_STRATEGY_ID sid, double base_prior) const
   {
      if(!InpUseAdaptiveSelfOpt || m_stats[sid].total_trades < g_cfg.min_trades_adapt)
         return base_prior;

      double empirical_wr = (double)m_stats[sid].wins / (double)m_stats[sid].total_trades;
      double blended      = 0.60 * base_prior + 0.40 * empirical_wr;
      return MathMax(0.32, MathMin(0.78, blended));
   }

   double GetAdaptiveMultiplier(ENUM_STRATEGY_ID sid) const
   {
      if(!InpUseAdaptiveSelfOpt || m_stats[sid].rolling_count < g_cfg.min_trades_adapt)
         return 1.0;

      double exp_r = m_stats[sid].rolling_expectancy_r;
      if(exp_r > 0.25)  return 1.15;
      if(exp_r > 0.05)  return 1.00;
      if(exp_r > -0.10) return 0.80;
      return 0.60;
   }

   bool   IsSuspended(ENUM_STRATEGY_ID sid) const   { return m_stats[sid].suspended; }
   int    GetTotalTrades(ENUM_STRATEGY_ID sid) const { return m_stats[sid].total_trades; }
   int    GetWins(ENUM_STRATEGY_ID sid) const        { return m_stats[sid].wins; }
   double GetNetProfit(ENUM_STRATEGY_ID sid) const   { return m_stats[sid].net_profit; }
   double GetRollingExpR(ENUM_STRATEGY_ID sid) const { return m_stats[sid].rolling_expectancy_r; }
};

//+------------------------------------------------------------------+
//| 4. Super Aggressive Capital & Cumulative Risk Manager            |
//+------------------------------------------------------------------+
class CRiskAndCapitalManager
{
private:
   string m_symbol;
   ulong  m_magic;
   double m_daily_start_equity;
   double m_peak_equity;
   int    m_current_day_of_year;
   string m_gv_peak_key;
   string m_gv_daily_key;
   string m_gv_day_key;

public:
   void Init(const string symbol, ulong magic)
   {
      m_symbol = symbol;
      m_magic  = magic;

      long login     = AccountInfoInteger(ACCOUNT_LOGIN);
      m_gv_peak_key  = StringFormat("MVX2_PEAK_%I64d", login);
      m_gv_daily_key = StringFormat("MVX2_DAILY_%I64d", login);
      m_gv_day_key   = StringFormat("MVX2_DAY_%I64d", login);

      double eq = AccountInfoDouble(ACCOUNT_EQUITY);
      MqlDateTime dt;
      TimeCurrent(dt);
      m_current_day_of_year = dt.day_of_year;

      if(!MQLInfoInteger(MQL_TESTER) && GlobalVariableCheck(m_gv_peak_key))
         m_peak_equity = MathMax(eq, GlobalVariableGet(m_gv_peak_key));
      else
      {
         m_peak_equity = eq;
         if(!MQLInfoInteger(MQL_TESTER)) GlobalVariableSet(m_gv_peak_key, m_peak_equity);
      }

      if(!MQLInfoInteger(MQL_TESTER) &&
         GlobalVariableCheck(m_gv_day_key) && (int)GlobalVariableGet(m_gv_day_key) == m_current_day_of_year &&
         GlobalVariableCheck(m_gv_daily_key))
      {
         m_daily_start_equity = GlobalVariableGet(m_gv_daily_key);
      }
      else
      {
         m_daily_start_equity = eq;
         if(!MQLInfoInteger(MQL_TESTER))
         {
            GlobalVariableSet(m_gv_daily_key, m_daily_start_equity);
            GlobalVariableSet(m_gv_day_key, (double)m_current_day_of_year);
         }
      }
   }

   void UpdateEquityState()
   {
      double eq = AccountInfoDouble(ACCOUNT_EQUITY);
      if(eq <= 0.0) return;

      MqlDateTime dt;
      TimeCurrent(dt);
      if(dt.day_of_year != m_current_day_of_year)
      {
         m_current_day_of_year = dt.day_of_year;
         m_daily_start_equity  = eq;
         if(!MQLInfoInteger(MQL_TESTER))
         {
            GlobalVariableSet(m_gv_daily_key, m_daily_start_equity);
            GlobalVariableSet(m_gv_day_key, (double)m_current_day_of_year);
         }
      }

      if(eq > m_peak_equity)
      {
         m_peak_equity = eq;
         if(!MQLInfoInteger(MQL_TESTER))
            GlobalVariableSet(m_gv_peak_key, m_peak_equity);
      }
   }

   double GetTodayPnLMoney() const
   {
      return AccountInfoDouble(ACCOUNT_EQUITY) - m_daily_start_equity;
   }

   double GetTodayPnLPct() const
   {
      if(m_daily_start_equity <= 0.0) return 0.0;
      return (GetTodayPnLMoney() / m_daily_start_equity) * 100.0;
   }

   double GetCurrentDailyLossPct() const
   {
      double eq = AccountInfoDouble(ACCOUNT_EQUITY);
      if(m_daily_start_equity <= 0.0) return 0.0;
      double loss = (m_daily_start_equity - eq) / m_daily_start_equity * 100.0;
      return MathMax(0.0, loss);
   }

   double GetCurrentEquityDDPct() const
   {
      double eq = AccountInfoDouble(ACCOUNT_EQUITY);
      if(m_peak_equity <= 0.0) return 0.0;
      double dd = (m_peak_equity - eq) / m_peak_equity * 100.0;
      return MathMax(0.0, dd);
   }

   bool IsEmergencyBreached(string &reason) const
   {
      double daily_loss = GetCurrentDailyLossPct();
      if(daily_loss >= g_cfg.max_daily_loss_pct)
      {
         reason = StringFormat("DAILY LOSS LIMIT (%.2f%% >= %.1f%%)", daily_loss, g_cfg.max_daily_loss_pct);
         return true;
      }

      double eq_dd = GetCurrentEquityDDPct();
      if(eq_dd >= g_cfg.max_equity_dd_pct)
      {
         reason = StringFormat("MAX DRAWDOWN LIMIT (%.2f%% >= %.1f%%)", eq_dd, g_cfg.max_equity_dd_pct);
         return true;
      }

      return false;
   }

   double GetDrawdownRiskMultiplier() const
   {
      if(!InpUseDrawdownDeleveraging) return 1.0;

      double dd_ratio    = GetCurrentEquityDDPct() / MathMax(1.0, g_cfg.max_equity_dd_pct);
      double daily_ratio = GetCurrentDailyLossPct() / MathMax(1.0, g_cfg.max_daily_loss_pct);
      double stress      = MathMax(dd_ratio, daily_ratio);

      if(stress >= 0.85) return 0.25;
      if(stress >= 0.65) return 0.45;
      if(stress >= 0.45) return 0.70;
      if(stress >= 0.25) return 0.85;
      return 1.00;
   }

   double CalculateCumulativeOpenRiskCurrency() const
   {
      string cur_base   = SymbolInfoString(m_symbol, SYMBOL_CURRENCY_BASE);
      string cur_profit = SymbolInfoString(m_symbol, SYMBOL_CURRENCY_PROFIT);
      double total_risk = 0.0;

      int total = PositionsTotal();
      for(int i = 0; i < total; i++)
      {
         ulong ticket = PositionGetTicket(i);
         if(ticket == 0) continue;

         string pos_sym   = PositionGetString(POSITION_SYMBOL);
         double vol       = PositionGetDouble(POSITION_VOLUME);
         double open_px   = PositionGetDouble(POSITION_PRICE_OPEN);
         double sl_px     = PositionGetDouble(POSITION_SL);
         double tick_size = SymbolInfoDouble(pos_sym, SYMBOL_TRADE_TICK_SIZE);
         double tick_val  = SymbolInfoDouble(pos_sym, SYMBOL_TRADE_TICK_VALUE);

         if(tick_size <= 0.0 || tick_val <= 0.0) continue;

         double sl_dist  = (sl_px > 0.0) ? MathAbs(open_px - sl_px) : (open_px * 0.005);
         double pos_risk = (sl_dist / tick_size) * tick_val * vol;

         string p_base   = SymbolInfoString(pos_sym, SYMBOL_CURRENCY_BASE);
         string p_profit = SymbolInfoString(pos_sym, SYMBOL_CURRENCY_PROFIT);
         double corr_mult = (pos_sym == m_symbol) ? 1.0 :
                            ((p_base == cur_base || p_profit == cur_profit ||
                              p_base == cur_profit || p_profit == cur_base) ? 0.75 : 0.40);

         total_risk += pos_risk * corr_mult;
      }
      return total_risk;
   }

   double GetCumulativeOpenRiskPct() const
   {
      double eq = AccountInfoDouble(ACCOUNT_EQUITY);
      if(eq <= 0.0) return 0.0;
      return (CalculateCumulativeOpenRiskCurrency() / eq) * 100.0;
   }

   double ComputeValidatedLotSize(double sl_distance_price, double strategy_mult, ENUM_ORDER_TYPE order_type, double entry_price, string &reject_reason) const
   {
      if(sl_distance_price <= 0.0)
      {
         reject_reason = "INVALID SL DIST";
         return 0.0;
      }

      double equity  = AccountInfoDouble(ACCOUNT_EQUITY);
      double balance = AccountInfoDouble(ACCOUNT_BALANCE);
      double capital_base = InpUseEquityCompounding ? equity : MathMin(equity, balance);
      if(capital_base <= 0.0)
      {
         reject_reason = "ZERO EQUITY";
         return 0.0;
      }

      double risk_pct = g_cfg.risk_pct * GetDrawdownRiskMultiplier() * strategy_mult;
      double ceiling  = (g_cfg.risk_mode == RISK_MODE_AGGRESSIVE) ? 1.0 :
                        ((g_cfg.risk_mode == RISK_MODE_SUPER_AGGRESSIVE) ? 2.0 : 3.0);
      if(InpCustomRiskPct > 0.0) ceiling = InpCustomRiskPct;
      risk_pct = MathMin(risk_pct, ceiling);

      double target_risk_money = capital_base * (risk_pct / 100.0);

      double max_cum_money    = equity * (g_cfg.max_cum_risk_pct / 100.0);
      double open_cum_money   = CalculateCumulativeOpenRiskCurrency();
      double remaining_budget = max_cum_money - open_cum_money;
      if(remaining_budget <= 0.0)
      {
         reject_reason = "CUMULATIVE RISK CAP";
         return 0.0;
      }

      if(target_risk_money > remaining_budget)
         target_risk_money = remaining_budget;

      double tick_size = SymbolInfoDouble(m_symbol, SYMBOL_TRADE_TICK_SIZE);
      double tick_val  = SymbolInfoDouble(m_symbol, SYMBOL_TRADE_TICK_VALUE);
      if(tick_size <= 0.0 || tick_val <= 0.0)
      {
         reject_reason = "INVALID TICK VALUE";
         return 0.0;
      }

      double loss_per_lot = (sl_distance_price / tick_size) * tick_val;
      if(loss_per_lot <= 0.0)
      {
         reject_reason = "ZERO LOSS/LOT";
         return 0.0;
      }

      double raw_lots = target_risk_money / loss_per_lot;

      double min_lot  = SymbolInfoDouble(m_symbol, SYMBOL_VOLUME_MIN);
      double max_lot  = SymbolInfoDouble(m_symbol, SYMBOL_VOLUME_MAX);
      double lot_step = SymbolInfoDouble(m_symbol, SYMBOL_VOLUME_STEP);
      if(lot_step <= 0.0) lot_step = 0.01;

      double norm_lots = MathFloor(raw_lots / lot_step) * lot_step;
      norm_lots = NormalizeDouble(norm_lots, 2);

      if(norm_lots < min_lot)
      {
         double min_lot_risk = min_lot * loss_per_lot;
         if(min_lot_risk <= target_risk_money * 1.50 && min_lot_risk <= remaining_budget)
            norm_lots = min_lot;
         else
         {
            reject_reason = StringFormat("MIN_LOT RISK ($%.2f > $%.2f)", min_lot_risk, target_risk_money);
            return 0.0;
         }
      }

      if(norm_lots > max_lot)
         norm_lots = max_lot;

      double margin_req = 0.0;
      if(OrderCalcMargin(order_type, m_symbol, norm_lots, entry_price, margin_req))
      {
         double free_margin = AccountInfoDouble(ACCOUNT_MARGIN_FREE);
         while(norm_lots >= min_lot && margin_req > free_margin * 0.85)
         {
            norm_lots = NormalizeDouble(norm_lots - lot_step, 2);
            if(norm_lots < min_lot)
            {
               reject_reason = "INSUFFICIENT FREE MARGIN";
               return 0.0;
            }
            if(!OrderCalcMargin(order_type, m_symbol, norm_lots, entry_price, margin_req))
               return 0.0;
         }
      }

      return norm_lots;
   }
};

//+------------------------------------------------------------------+
//| 5. Quantitative Signal & Net-Expectancy Scoring Engine           |
//+------------------------------------------------------------------+
class CSignalScoringEngine
{
private:
   string m_symbol;

   double CalculateCostInPoints(double point, double atr_pts) const
   {
      double spread_pts = (SymbolInfoDouble(m_symbol, SYMBOL_ASK) - SymbolInfoDouble(m_symbol, SYMBOL_BID)) / point;
      double tick_size  = SymbolInfoDouble(m_symbol, SYMBOL_TRADE_TICK_SIZE);
      double tick_val   = SymbolInfoDouble(m_symbol, SYMBOL_TRADE_TICK_VALUE);

      // Auto-detect commission: if user specifies > 0, use exact input;
      // if 0 (Auto), only add $7/lot round-turn estimate when spread is ultra-tight (< 8% of ATR, i.e., Raw Spread account)
      double eff_comm_money = InpCommissionPerLot;
      if(eff_comm_money <= 0.0 && atr_pts > 0.0 && (spread_pts / atr_pts) < 0.08)
         eff_comm_money = 7.0;

      double comm_pts = 0.0;
      if(eff_comm_money > 0.0 && tick_size > 0.0 && tick_val > 0.0 && point > 0.0)
      {
         double point_val_per_lot = tick_val * (point / tick_size);
         if(point_val_per_lot > 0.0)
            comm_pts = eff_comm_money / point_val_per_lot;
      }
      return spread_pts + comm_pts;
   }

   void FinalizeCandidate(SSignalCandidate &cand, ENUM_STRATEGY_ID sid, int dir,
                          double sl_dist_price, double tp_dist_price, double base_win_prob,
                          const CMicrostructureEngine &micro, const CMTFContextEngine &mtf,
                          const CAdaptiveStatsTracker &stats)
   {
      double point = SymbolInfoDouble(m_symbol, SYMBOL_POINT);
      double ask   = SymbolInfoDouble(m_symbol, SYMBOL_ASK);
      double bid   = SymbolInfoDouble(m_symbol, SYMBOL_BID);

      if(point <= 0.0 || sl_dist_price <= 0.0 || tp_dist_price <= 0.0)
         return;

      double spread_price = ask - bid;
      // Ensure SL & TP scale above broker stop level AND at least 2.2x current spread
      long stops_level     = SymbolInfoInteger(m_symbol, SYMBOL_TRADE_STOPS_LEVEL);
      double min_stop_dist = MathMax((double)(stops_level + 5) * point, spread_price * 2.2);

      if(sl_dist_price < min_stop_dist) sl_dist_price = min_stop_dist;
      if(tp_dist_price < sl_dist_price * 1.45) tp_dist_price = sl_dist_price * 1.45;

      double entry = (dir > 0) ? ask : bid;
      double sl    = (dir > 0) ? (entry - sl_dist_price) : (entry + sl_dist_price);
      double tp    = (dir > 0) ? (entry + tp_dist_price) : (entry - tp_dist_price);

      entry = NormalizePriceToTick(m_symbol, entry);
      sl    = NormalizePriceToTick(m_symbol, sl);
      tp    = NormalizePriceToTick(m_symbol, tp);

      double reward_pts  = tp_dist_price / point;
      double risk_pts    = sl_dist_price / point;
      double atr_pts     = mtf.m1_atr[0] / point;
      double cost_pts    = CalculateCostInPoints(point, atr_pts) + micro.estimated_slippage_pts;

      double cal_prob    = stats.GetCalibratedWinProb(sid, base_win_prob);
      double net_exp_pts = (cal_prob * reward_pts) - ((1.0 - cal_prob) * risk_pts) - cost_pts;
      double net_exp_r   = net_exp_pts / risk_pts;

      if(net_exp_pts <= 0.0 || net_exp_r < g_cfg.min_expectancy_r)
         return;

      double adapt_mult = stats.GetAdaptiveMultiplier(sid);
      double score      = net_exp_r * mtf.seasonality_score * adapt_mult * (1.0 + 0.25 * MathAbs(micro.tick_imbalance));

      cand.valid               = true;
      cand.strategy            = sid;
      cand.direction           = dir;
      cand.entry_price         = entry;
      cand.sl_price            = sl;
      cand.tp_price            = tp;
      cand.win_prob            = cal_prob;
      cand.expected_reward_pts = reward_pts;
      cand.expected_risk_pts   = risk_pts;
      cand.total_cost_pts      = cost_pts;
      cand.net_expectancy_pts  = net_exp_pts;
      cand.net_expectancy_r    = net_exp_r;
      cand.score               = score;
      cand.tag                 = StringFormat("%s|%s", COMMENT_PREFIX, StrategyShortCode(sid));
   }

public:
   void Init(const string symbol) { m_symbol = symbol; }

   SSignalCandidate EvaluateBestOpportunity(const CMicrostructureEngine &micro,
                                            const CMTFContextEngine &mtf,
                                            CAdaptiveStatsTracker &stats)
   {
      SSignalCandidate best;
      best.Reset();

      datetime now = TimeCurrent();
      double atr = mtf.m1_atr[0];
      if(atr <= 0.0) return best;

      double ask = SymbolInfoDouble(m_symbol, SYMBOL_ASK);
      double bid = SymbolInfoDouble(m_symbol, SYMBOL_BID);

      SSignalCandidate cand;

      //---------------------------------------------------------------
      // STRATEGY A: ULTRA-FAST MOMENTUM SCALPING
      //---------------------------------------------------------------
      if(g_cfg.strat_enabled[STRAT_ULTRA_MOMENTUM] && stats.IsStrategyAvailable(STRAT_ULTRA_MOMENTUM, now))
      {
         cand.Reset();
         if(micro.tick_velocity >= g_cfg.min_tick_velocity && mtf.m1_autocorr_lag1 > -0.15)
         {
            if(mtf.h1_trend_dir >= 0 &&
               mtf.m1_ema_fast[0] > mtf.m1_ema_slow[0] &&
               ask > mtf.m1_ema_fast[0] &&
               micro.tick_imbalance >= 0.28 &&
               micro.price_velocity_pts > 0.0 &&
               mtf.m1_rsi[0] > 52.0 && mtf.m1_rsi[0] < 80.0)
            {
               double prob = 0.52 + MathMin(0.08, micro.tick_imbalance * 0.10);
               FinalizeCandidate(cand, STRAT_ULTRA_MOMENTUM, 1,
                                 atr * g_cfg.sl_atr_mult * 0.95,
                                 atr * g_cfg.tp_atr_mult * 1.05,
                                 prob, micro, mtf, stats);
            }
            else if(mtf.h1_trend_dir <= 0 &&
                    mtf.m1_ema_fast[0] < mtf.m1_ema_slow[0] &&
                    bid < mtf.m1_ema_fast[0] &&
                    micro.tick_imbalance <= -0.28 &&
                    micro.price_velocity_pts < 0.0 &&
                    mtf.m1_rsi[0] < 48.0 && mtf.m1_rsi[0] > 20.0)
            {
               double prob = 0.52 + MathMin(0.08, MathAbs(micro.tick_imbalance) * 0.10);
               FinalizeCandidate(cand, STRAT_ULTRA_MOMENTUM, -1,
                                 atr * g_cfg.sl_atr_mult * 0.95,
                                 atr * g_cfg.tp_atr_mult * 1.05,
                                 prob, micro, mtf, stats);
            }
         }
         if(cand.valid && cand.score > best.score) best = cand;
      }

      //---------------------------------------------------------------
      // STRATEGY B: LIQUIDITY SWEEP REVERSAL
      //---------------------------------------------------------------
      if(g_cfg.strat_enabled[STRAT_LIQUIDITY_SWEEP] && stats.IsStrategyAvailable(STRAT_LIQUIDITY_SWEEP, now))
      {
         cand.Reset();
         // Sweep of M15 swing OR 3-bar M1 local liquidity pool with immediate rejection
         double local_low  = MathMin(mtf.m1_low[1], mtf.m1_low[2]);
         double local_high = MathMax(mtf.m1_high[1], mtf.m1_high[2]);

         bool bull_sweep = ((mtf.m1_low[0] < mtf.m15_swing_low || mtf.m1_low[0] < local_low) &&
                            mtf.m1_close[0] > mtf.m1_open[0] &&
                            (mtf.m1_close[0] - mtf.m1_low[0]) > atr * 0.65 &&
                            micro.tick_imbalance >= 0.22);

         bool bear_sweep = ((mtf.m1_high[0] > mtf.m15_swing_high || mtf.m1_high[0] > local_high) &&
                            mtf.m1_close[0] < mtf.m1_open[0] &&
                            (mtf.m1_high[0] - mtf.m1_close[0]) > atr * 0.65 &&
                            micro.tick_imbalance <= -0.22);

         if(bull_sweep)
         {
            double wick_sl = MathMax(atr * 1.30, (ask - mtf.m1_low[0]) + atr * 0.30);
            FinalizeCandidate(cand, STRAT_LIQUIDITY_SWEEP, 1, wick_sl, wick_sl * 1.75, 0.53, micro, mtf, stats);
         }
         else if(bear_sweep)
         {
            double wick_sl = MathMax(atr * 1.30, (mtf.m1_high[0] - bid) + atr * 0.30);
            FinalizeCandidate(cand, STRAT_LIQUIDITY_SWEEP, -1, wick_sl, wick_sl * 1.75, 0.53, micro, mtf, stats);
         }
         if(cand.valid && cand.score > best.score) best = cand;
      }

      //---------------------------------------------------------------
      // STRATEGY C: QUANTITATIVE MEAN REVERSION
      //---------------------------------------------------------------
      if(g_cfg.strat_enabled[STRAT_MEAN_REVERSION] && stats.IsStrategyAvailable(STRAT_MEAN_REVERSION, now))
      {
         cand.Reset();
         if(mtf.h1_adx[0] < 32.0)
         {
            if(mtf.m1_low[0] <= mtf.m1_bb_lower[0] &&
               mtf.m1_close[0] > mtf.m1_bb_lower[0] &&
               mtf.m1_rsi[0] < 32.0 &&
               micro.tick_imbalance > 0.10)
            {
               double target_tp = MathMax(atr * 1.65, mtf.m1_bb_mid[0] - ask);
               FinalizeCandidate(cand, STRAT_MEAN_REVERSION, 1, atr * 1.35, target_tp, 0.56, micro, mtf, stats);
            }
            else if(mtf.m1_high[0] >= mtf.m1_bb_upper[0] &&
                    mtf.m1_close[0] < mtf.m1_bb_upper[0] &&
                    mtf.m1_rsi[0] > 68.0 &&
                    micro.tick_imbalance < -0.10)
            {
               double target_tp = MathMax(atr * 1.65, bid - mtf.m1_bb_mid[0]);
               FinalizeCandidate(cand, STRAT_MEAN_REVERSION, -1, atr * 1.35, target_tp, 0.56, micro, mtf, stats);
            }
         }
         if(cand.valid && cand.score > best.score) best = cand;
      }

      //---------------------------------------------------------------
      // STRATEGY D: VOLATILITY EXPLOSION SCALPING
      //---------------------------------------------------------------
      if(g_cfg.strat_enabled[STRAT_VOL_EXPLOSION] && stats.IsStrategyAvailable(STRAT_VOL_EXPLOSION, now))
      {
         cand.Reset();
         double bar_range     = mtf.m1_high[0] - mtf.m1_low[0];
         bool   atr_expanding = (mtf.m1_atr[0] > mtf.m1_atr[1] * 1.05 || bar_range > atr * 1.35);

         if(atr_expanding && micro.tick_velocity >= g_cfg.min_tick_velocity)
         {
            if(mtf.m1_close[0] > mtf.m1_bb_upper[0] &&
               mtf.m1_close[1] <= mtf.m1_bb_upper[1] &&
               micro.tick_imbalance >= 0.22)
            {
               FinalizeCandidate(cand, STRAT_VOL_EXPLOSION, 1, atr * 1.50, atr * 2.65, 0.51, micro, mtf, stats);
            }
            else if(mtf.m1_close[0] < mtf.m1_bb_lower[0] &&
                    mtf.m1_close[1] >= mtf.m1_bb_lower[1] &&
                    micro.tick_imbalance <= -0.22)
            {
               FinalizeCandidate(cand, STRAT_VOL_EXPLOSION, -1, atr * 1.50, atr * 2.65, 0.51, micro, mtf, stats);
            }
         }
         if(cand.valid && cand.score > best.score) best = cand;
      }

      //---------------------------------------------------------------
      // STRATEGY E: TREND IMPULSE CONTINUATION
      //---------------------------------------------------------------
      if(g_cfg.strat_enabled[STRAT_TREND_IMPULSE] && stats.IsStrategyAvailable(STRAT_TREND_IMPULSE, now))
      {
         cand.Reset();
         if(mtf.m5_adx[0] >= 18.0)
         {
            if(mtf.h1_trend_dir >= 0 &&
               mtf.m1_ema_fast[0] > mtf.m1_ema_slow[0] &&
               mtf.m1_low[1] <= mtf.m1_ema_fast[1] &&
               mtf.m1_close[0] > mtf.m1_ema_fast[0] &&
               mtf.m1_close[0] > mtf.m1_open[0] &&
               micro.tick_imbalance >= 0.15)
            {
               FinalizeCandidate(cand, STRAT_TREND_IMPULSE, 1,
                                 atr * g_cfg.sl_atr_mult,
                                 atr * g_cfg.tp_atr_mult,
                                 0.54, micro, mtf, stats);
            }
            else if(mtf.h1_trend_dir <= 0 &&
                    mtf.m1_ema_fast[0] < mtf.m1_ema_slow[0] &&
                    mtf.m1_high[1] >= mtf.m1_ema_fast[1] &&
                    mtf.m1_close[0] < mtf.m1_ema_fast[0] &&
                    mtf.m1_close[0] < mtf.m1_open[0] &&
                    micro.tick_imbalance <= -0.15)
            {
               FinalizeCandidate(cand, STRAT_TREND_IMPULSE, -1,
                                 atr * g_cfg.sl_atr_mult,
                                 atr * g_cfg.tp_atr_mult,
                                 0.54, micro, mtf, stats);
            }
         }
         if(cand.valid && cand.score > best.score) best = cand;
      }

      return best;
   }
};

//+------------------------------------------------------------------+
//| 6. Execution, Position & Emergency Management Engine             |
//+------------------------------------------------------------------+
class CExecutionEngine
{
private:
   CTrade   m_trade;
   string   m_symbol;
   ulong    m_magic;
   datetime m_last_order_bar_m1;
   datetime m_last_order_time;
   ulong    m_partial_closed_tickets[64];
   int      m_partial_count;

   ENUM_ORDER_TYPE_FILLING ResolveFillingMode() const
   {
      uint filling = (uint)SymbolInfoInteger(m_symbol, SYMBOL_FILLING_MODE);
      if((filling & SYMBOL_FILLING_IOC) == SYMBOL_FILLING_IOC)
         return ORDER_FILLING_IOC;
      if((filling & SYMBOL_FILLING_FOK) == SYMBOL_FILLING_FOK)
         return ORDER_FILLING_FOK;
      return ORDER_FILLING_RETURN;
   }

   bool IsTicketPartialClosed(ulong ticket) const
   {
      for(int i = 0; i < m_partial_count; i++)
         if(m_partial_closed_tickets[i] == ticket)
            return true;
      return false;
   }

   void MarkTicketPartialClosed(ulong ticket)
   {
      if(IsTicketPartialClosed(ticket)) return;
      int idx = m_partial_count % 64;
      m_partial_closed_tickets[idx] = ticket;
      if(m_partial_count < 64) m_partial_count++;
   }

public:
   double last_requested_price;

   void Init(const string symbol, ulong magic)
   {
      m_symbol             = symbol;
      m_magic              = magic;
      m_last_order_bar_m1  = 0;
      m_last_order_time    = 0;
      m_partial_count      = 0;
      last_requested_price = 0.0;
      ArrayInitialize(m_partial_closed_tickets, 0);

      m_trade.SetExpertMagicNumber(m_magic);
      m_trade.SetDeviationInPoints(g_cfg.slippage_dev);
      m_trade.SetTypeFilling(ResolveFillingMode());
      m_trade.SetAsyncMode(false);
   }

   void RefreshConfig()
   {
      m_trade.SetDeviationInPoints(g_cfg.slippage_dev);
   }

   int CountSymbolPositions() const
   {
      int count = 0;
      for(int i = PositionsTotal() - 1; i >= 0; i--)
      {
         ulong ticket = PositionGetTicket(i);
         if(ticket == 0) continue;
         if(PositionGetInteger(POSITION_MAGIC) == (long)m_magic &&
            PositionGetString(POSITION_SYMBOL) == m_symbol)
            count++;
      }
      return count;
   }

   int CountAllAccountPositions() const
   {
      int count = 0;
      for(int i = PositionsTotal() - 1; i >= 0; i--)
      {
         ulong ticket = PositionGetTicket(i);
         if(ticket == 0) continue;
         if(PositionGetInteger(POSITION_MAGIC) == (long)m_magic)
            count++;
      }
      return count;
   }

   bool CanOpenNewPosition(datetime bar_m1, datetime now, string &wait_msg) const
   {
      if(g_cfg.trading_paused)
      {
         wait_msg = "ENGINE PAUSED BY USER";
         return false;
      }
      if(CountSymbolPositions() >= g_cfg.max_pos_symbol)
      {
         wait_msg = StringFormat("MAX SYMBOL POS (%d/%d)", CountSymbolPositions(), g_cfg.max_pos_symbol);
         return false;
      }
      if(CountAllAccountPositions() >= g_cfg.max_pos_account)
      {
         wait_msg = StringFormat("MAX ACCOUNT POS (%d/%d)", CountAllAccountPositions(), g_cfg.max_pos_account);
         return false;
      }
      if(bar_m1 == m_last_order_bar_m1)
      {
         wait_msg = "WAIT NEXT M1 BAR";
         return false;
      }
      if((now - m_last_order_time) < g_cfg.reentry_cooldown_sec)
      {
         wait_msg = "COOLDOWN TIMER ACTIVE";
         return false;
      }
      return true;
   }

   bool ExecuteCandidate(const SSignalCandidate &cand, double lots, datetime bar_m1)
   {
      if(!cand.valid || lots <= 0.0) return false;

      m_trade.SetTypeFilling(ResolveFillingMode());
      m_trade.SetDeviationInPoints(g_cfg.slippage_dev);

      bool sent = false;
      for(int attempt = 0; attempt < 2; attempt++)
      {
         double price = (cand.direction > 0) ? SymbolInfoDouble(m_symbol, SYMBOL_ASK)
                                             : SymbolInfoDouble(m_symbol, SYMBOL_BID);
         price = NormalizePriceToTick(m_symbol, price);
         last_requested_price = price;

         if(cand.direction > 0)
            sent = m_trade.Buy(lots, m_symbol, price, cand.sl_price, cand.tp_price, cand.tag);
         else
            sent = m_trade.Sell(lots, m_symbol, price, cand.sl_price, cand.tp_price, cand.tag);

         uint retcode = m_trade.ResultRetcode();
         if(sent && (retcode == TRADE_RETCODE_DONE || retcode == TRADE_RETCODE_PLACED))
         {
            m_last_order_bar_m1 = bar_m1;
            m_last_order_time   = TimeCurrent();
            g_cfg.SetStatus(StringFormat("EXEC: %s %s %.2fL (ExpR:%+.2f)",
                            StrategyShortCode(cand.strategy), (cand.direction > 0 ? "BUY" : "SELL"),
                            lots, cand.net_expectancy_r), false);
            if(InpVerboseDiagnostics)
            {
               PrintFormat("[MIDAS VX EXEC] %s %s Lots=%.2f Px=%.5f SL=%.5f TP=%.5f ExpR=%.3f WinP=%.2f",
                           StrategyName(cand.strategy), (cand.direction > 0 ? "BUY" : "SELL"),
                           lots, price, cand.sl_price, cand.tp_price, cand.net_expectancy_r, cand.win_prob);
            }
            return true;
         }

         if(retcode != TRADE_RETCODE_REQUOTE && retcode != TRADE_RETCODE_PRICE_OFF && retcode != TRADE_RETCODE_PRICE_CHANGED)
         {
            g_cfg.SetStatus(StringFormat("ORDER REJECTED: %u", retcode), true);
            PrintFormat("[MIDAS VX WARN] Order rejected. Retcode=%u (%s)", retcode, m_trade.ResultRetcodeDescription());
            break;
         }
      }
      return false;
   }

   void CloseAllSymbolPositions(const string reason)
   {
      PrintFormat("[MIDAS VX ACTION] Closing all positions on %s. Reason: %s", m_symbol, reason);
      for(int i = PositionsTotal() - 1; i >= 0; i--)
      {
         ulong ticket = PositionGetTicket(i);
         if(ticket == 0) continue;
         if(PositionGetInteger(POSITION_MAGIC) != (long)m_magic) continue;
         if(PositionGetString(POSITION_SYMBOL) != m_symbol) continue;

         m_trade.PositionClose(ticket, g_cfg.slippage_dev);
      }
   }

   void ManageOpenPositions(const CMicrostructureEngine &micro, const CMTFContextEngine &mtf)
   {
      double atr   = mtf.m1_atr[0];
      double point = SymbolInfoDouble(m_symbol, SYMBOL_POINT);
      if(atr <= 0.0 || point <= 0.0) return;

      long freeze_level = SymbolInfoInteger(m_symbol, SYMBOL_TRADE_FREEZE_LEVEL);
      long stops_level  = SymbolInfoInteger(m_symbol, SYMBOL_TRADE_STOPS_LEVEL);
      double min_dist   = (double)(MathMax(freeze_level, stops_level) + 5) * point;

      double min_lot  = SymbolInfoDouble(m_symbol, SYMBOL_VOLUME_MIN);
      double lot_step = SymbolInfoDouble(m_symbol, SYMBOL_VOLUME_STEP);
      if(lot_step <= 0.0) lot_step = 0.01;

      datetime now = TimeCurrent();

      for(int i = PositionsTotal() - 1; i >= 0; i--)
      {
         ulong ticket = PositionGetTicket(i);
         if(ticket == 0) continue;
         if(PositionGetInteger(POSITION_MAGIC) != (long)m_magic) continue;
         if(PositionGetString(POSITION_SYMBOL) != m_symbol) continue;

         long     pos_type  = PositionGetInteger(POSITION_TYPE);
         double   open_px   = PositionGetDouble(POSITION_PRICE_OPEN);
         double   cur_sl    = PositionGetDouble(POSITION_SL);
         double   cur_tp    = PositionGetDouble(POSITION_TP);
         double   vol       = PositionGetDouble(POSITION_VOLUME);
         datetime open_time = (datetime)PositionGetInteger(POSITION_TIME);

         double cur_px = (pos_type == POSITION_TYPE_BUY) ? SymbolInfoDouble(m_symbol, SYMBOL_BID)
                                                         : SymbolInfoDouble(m_symbol, SYMBOL_ASK);

         if(g_cfg.max_hold_sec > 0 && (now - open_time) >= g_cfg.max_hold_sec)
         {
            m_trade.PositionClose(ticket, g_cfg.slippage_dev);
            continue;
         }

         double initial_risk = (cur_sl > 0.0) ? MathAbs(open_px - cur_sl) : (atr * g_cfg.sl_atr_mult);
         if(initial_risk <= 0.0) initial_risk = atr;

         double unrealized_dist = (pos_type == POSITION_TYPE_BUY) ? (cur_px - open_px) : (open_px - cur_px);
         double current_rr      = unrealized_dist / initial_risk;

         if(InpUseMomentumExit && current_rr >= 0.45)
         {
            bool rev_flip = (pos_type == POSITION_TYPE_BUY  && micro.tick_imbalance <= -0.55 && micro.price_velocity_pts < 0.0) ||
                            (pos_type == POSITION_TYPE_SELL && micro.tick_imbalance >=  0.55 && micro.price_velocity_pts > 0.0);
            if(rev_flip)
            {
               m_trade.PositionClose(ticket, g_cfg.slippage_dev);
               continue;
            }
         }

         if(InpUsePartialClose && current_rr >= g_cfg.partial_close_rr && !IsTicketPartialClosed(ticket))
         {
            double close_vol = MathFloor((vol * (g_cfg.partial_close_pct / 100.0)) / lot_step) * lot_step;
            close_vol = NormalizeDouble(close_vol, 2);
            if(close_vol >= min_lot && (vol - close_vol) >= min_lot)
            {
               if(m_trade.PositionClosePartial(ticket, close_vol, g_cfg.slippage_dev))
               {
                  MarkTicketPartialClosed(ticket);
                  double be_sl = (pos_type == POSITION_TYPE_BUY) ? (open_px + 2.0 * point) : (open_px - 2.0 * point);
                  be_sl = NormalizePriceToTick(m_symbol, be_sl);
                  if(MathAbs(cur_px - be_sl) >= min_dist)
                     m_trade.PositionModify(ticket, be_sl, cur_tp);
                  continue;
               }
            }
         }

         if(InpUseTrailingStop && current_rr >= g_cfg.trail_act_rr)
         {
            double trail_dist = MathMax(min_dist, atr * g_cfg.trail_step_atr);
            if(pos_type == POSITION_TYPE_BUY)
            {
               double desired_sl = NormalizePriceToTick(m_symbol, cur_px - trail_dist);
               if(desired_sl > cur_sl + point && (cur_px - desired_sl) >= min_dist)
                  m_trade.PositionModify(ticket, desired_sl, cur_tp);
            }
            else if(pos_type == POSITION_TYPE_SELL)
            {
               double desired_sl = NormalizePriceToTick(m_symbol, cur_px + trail_dist);
               if((cur_sl == 0.0 || desired_sl < cur_sl - point) && (desired_sl - cur_px) >= min_dist)
                  m_trade.PositionModify(ticket, desired_sl, cur_tp);
            }
         }
      }
   }
};

