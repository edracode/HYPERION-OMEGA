int OnInit()
{
   g_pos_reg.Init();
   g_cfg.InitFromInputs(InpMagicNumber, _Symbol);

   double pip_scale = GetGoldPipScale(_Symbol);
   g_micro.Init(g_cfg.base_slippage_pips * pip_scale);
   if(!g_mtf.Init(_Symbol)) return INIT_FAILED;

   g_stats.Init(InpMagicNumber, _Symbol);
   g_shadow.Init(_Symbol);
   g_risk.Init(_Symbol, InpMagicNumber);
   g_scorer.Init(_Symbol);
   g_exec.Init(_Symbol, InpMagicNumber);

   g_panel.Init(InpPanelX, InpPanelY);
   g_panel.Update(g_micro, g_mtf, g_risk, g_stats, g_shadow, g_exec);

   PrintFormat("[MIDAS VX V7.0 ANTI-FREEZE] Initialized on %s | Mode=%s | EngineC2=Ready", _Symbol, RiskModeName(g_cfg.risk_mode));
   return INIT_SUCCEEDED;
}

