   g_micro.Init(g_cfg.base_slippage_pips * pip_scale);
   if(!g_mtf.Init(_Symbol))
      return INIT_FAILED;

   g_stats.Init(InpMagicNumber, _Symbol);
   g_risk.Init(_Symbol, InpMagicNumber);
   g_scorer.Init(_Symbol);
   g_exec.Init(_Symbol, InpMagicNumber);

   g_panel.Init(InpPanelX, InpPanelY);
