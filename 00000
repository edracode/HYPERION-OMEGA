struct SPositionMeta
{
   bool             active;
   ulong            pos_id;
   ENUM_STRATEGY_ID strategy;
   int              direction;
   double           initial_sl_dist;
   double           initial_risk_money;
   bool             be_moved;
   bool             partial_closed;

   void Reset()
   {
      active             = false;
      pos_id             = 0;
      strategy           = STRAT_A0_MOMENTUM;
      direction          = 0;
      initial_sl_dist    = 0.0;
      initial_risk_money = 0.0;
      be_moved           = false;
      partial_closed     = false;
   }
};

class CPositionRegistry
{
private:
   SPositionMeta m_items[POS_REGISTRY_SIZE];

public:
   void Init()
   {
      for(int i = 0; i < POS_REGISTRY_SIZE; i++)
         m_items[i].Reset();
   }

   void Register(ulong pos_id, ENUM_STRATEGY_ID sid, int dir, double sl_dist, double risk_money)
   {
      if(pos_id == 0) return;
      int slot = -1;
      for(int i = 0; i < POS_REGISTRY_SIZE; i++)
      {
         if(m_items[i].active && m_items[i].pos_id == pos_id)
         {
            slot = i;
            break;
         }
         if(!m_items[i].active && slot < 0)
            slot = i;
      }
      if(slot < 0) slot = 0;

      m_items[slot].active             = true;
      m_items[slot].pos_id             = pos_id;
      m_items[slot].strategy           = sid;
      m_items[slot].direction          = dir;
      m_items[slot].initial_sl_dist    = sl_dist;
      m_items[slot].initial_risk_money = risk_money;
      m_items[slot].be_moved           = false;
      m_items[slot].partial_closed     = false;
   }

   int FindIndex(ulong pos_id) const
   {
      if(pos_id == 0) return -1;
      for(int i = 0; i < POS_REGISTRY_SIZE; i++)
         if(m_items[i].active && m_items[i].pos_id == pos_id)
            return i;
      return -1;
   }

   bool GetMeta(ulong pos_id, SPositionMeta &out_meta) const
   {
      int idx = FindIndex(pos_id);
      if(idx < 0) return false;
      out_meta = m_items[idx];
      return true;
   }

   void MarkBreakevenMoved(ulong pos_id)
   {
      int idx = FindIndex(pos_id);
      if(idx >= 0) m_items[idx].be_moved = true;
   }

   void MarkPartialClosed(ulong pos_id)
   {
      int idx = FindIndex(pos_id);
      if(idx >= 0) m_items[idx].partial_closed = true;
   }

   void Remove(ulong pos_id)
   {
      int idx = FindIndex(pos_id);
      if(idx >= 0) m_items[idx].Reset();
   }
};

