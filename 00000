//| Session & Environment Filters                                    |
//+------------------------------------------------------------------+
bool PassesEnvironmentFilters(ENUM_ACTIVE_ENGINE eng, string &block_reason)
{
   if(!TerminalInfoInteger(TERMINAL_TRADE_ALLOWED) || !MQLInfoInteger(MQL_TRADE_ALLOWED))
   {
      block_reason = "ALGO TRADING DISABLED";
      return false;
   }
   MqlDateTime dt;
   TimeCurrent(dt);
   if(InpAvoidGoldRollover && ((dt.hour == 23 && dt.min >= 55) || dt.hour == 0 || (dt.hour == 1 && dt.min <= 5)))
   {
      block_reason = "GOLD COMEX ROLLOVER";
      return false;
   }
   if(InpUseSessionFilter)
   {
      if(InpSessionStartHour <= InpSessionEndHour)
      {
         if(dt.hour < InpSessionStartHour || dt.hour > InpSessionEndHour)
         {
            block_reason = "OUTSIDE TRADING SESSION";
            return false;
         }
      }
      else
      {
         if(dt.hour < InpSessionStartHour && dt.hour > InpSessionEndHour)
         {
            block_reason = "OUTSIDE TRADING SESSION";
            return false;
         }
      }
   }

   double point = SymbolInfoDouble(_Symbol, SYMBOL_POINT);
   if(point <= 0.0)
   {
      block_reason = "INVALID SYMBOL POINT";
      return false;
   }

   double pip_scale = GetGoldPipScale(_Symbol);
   if(g_cfg.max_spread_pips > 0.0 && (g_micro.current_spread_pts / pip_scale) > g_cfg.max_spread_pips)
   {
      block_reason = "SPREAD TOO HIGH";
      return false;
   }

   double ref_atr = (eng != ENGINE_A_HYPER_SCALP) ? g_mtf.m5_atr[0] : g_mtf.m1_atr[0];
   double atr_pts = ref_atr / point;
   if(atr_pts > 0.0 && (g_micro.current_spread_pts / atr_pts) > g_cfg.max_spread_atr_ratio)
   {
      block_reason = StringFormat("SPREAD/ATR %.2f > %.2f", (g_micro.current_spread_pts / atr_pts), g_cfg.max_spread_atr_ratio);
      return false;
   }

   return true;
}

